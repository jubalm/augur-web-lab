    {
      "id": "31:51",
      "name": "03 · Hero",
      "text": [
        [
          "31:55",
          "The frontier of\ndecentralized\ntruth."
        ],
        [
          "31:57",
          "Real-world answers for onchain apps, controlled by no one."
        ],
        [
          "31:58",
          "Augur Lituus is the next generation of Augur’s oracle. Anyone can answer, anyone can challenge, and lying is designed to cost more than it pays."
        ],
        [
          "I31:60;29:4",
          "See how it works"
        ],
        [
          "I31:62;29:10",
          "Read the whitepaper"
        ]
      ]
    },
    {
      "id": "239:474",
      "name": "04 · Who decides what happened",
      "text": [
        [
          "239:478",
          "Who decides\nwhat happened?"
        ],
        [
          "239:480",
          "Smart contracts can’t see the world. Whoever tells them what happened controls the money."
        ],
        [
          "240:432",
          "With Augur, no party controls the answer."
        ],
        [
          "239:485",
          "Permissionless"
        ],
        [
          "239:486",
          "Any app can ask a question. Anyone can report an answer or challenge one. No approval needed; fees and bonds apply."
        ],
        [
          "239:490",
          "Decentralized"
        ],
        [
          "239:491",
          "No committee, multisig or veto picks the answer. A fork is the last resort."
        ],
        [
          "239:495",
          "Trustless"
        ],
        [
          "239:496",
          "Every report is backed by a bond. Forcing a false answer is designed to cost more than it could gain."
        ]
      ]
    },
