---
import Website from '../layouts/Website.astro';
import HomepageHeader from '../components/site/HomepageHeader.astro';
import HeroLoom from '../components/site/HeroLoom.astro';
import WhyHow from '../components/site/WhyHow.astro';
import Applications from '../components/site/Applications.astro';
import CurrentStage from '../components/site/CurrentStage.astro';
import FromTheBlog from '../components/site/FromTheBlog.astro';
import HomeFaq from '../components/site/HomeFaq.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import Icon from '../components/site/Icon.astro';
import { buttonVariants } from '../components/ui/button-variants';
import { whitepaperUrl } from '../lib/links';
import heroArrival from '../motion/hero-arrival.js?raw';

// A fixed, incomplete grid recalls the old augur.net background.
// Generate it at build time so the decoration needs no client-side renderer.
// The 1600 × 800 field matches the full-screen hero's proportions. Every square uses the shared
// 3px texture size.
const squareField = { width: 1600, height: 800 };
let squareSeed = 2020;
const nextSquareValue = () => {
  squareSeed = (Math.imul(squareSeed, 1664525) + 1013904223) >>> 0;
  return squareSeed / 0x100000000;
};
const heritageSquares = Array.from({ length: (squareField.width / 40) * (squareField.height / 40) }, (_, index) => {
  const x = 20 + (index % 40) * 40;
  const y = 20 + Math.floor(index / 40) * 40;
  const edge = Math.max(
    Math.pow(Math.abs(y / squareField.height - .5) * 2, 4),
    Math.pow(Math.abs(x / squareField.width - .5) * 2, 12) * .5,
  );
  const present = nextSquareValue() < .46;
  const accent = nextSquareValue() < .24;
  const strength = .5 + nextSquareValue() * .5;
  return { x, y, accent, size: 3,
    opacity: Number((edge * strength * (accent ? .85 : .42)).toFixed(3)),
    highlight: Number((.35 + edge * (accent ? .6 : .4)).toFixed(3)),
    duration: 2.6 + (index * 13 % 9) * .35, phase: -(index * 17 % 101) / 10,
    present: present && edge > .12 };
}).filter(square => square.present);
---
<Website title="Augur | The frontier of decentralized truth">
  <HomepageHeader slot="header" />
  <section class="home-hero" aria-labelledby="hero-title" data-home-hero>
    <script is:inline set:html={heroArrival}></script>
    <svg class="hero-squares" viewBox={`0 0 ${squareField.width} ${squareField.height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="hero-square-light-falloff">
          <stop offset="0" stop-color="white" />
          <stop offset=".3" stop-color="white" stop-opacity=".85" />
          <stop offset="1" stop-color="white" stop-opacity="0" />
        </radialGradient>
        <mask id="hero-square-light-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={squareField.width} height={squareField.height}>
          <circle data-square-light-radius cx="-1000" cy="-1000" r="200" fill="url(#hero-square-light-falloff)" />
        </mask>
      </defs>
      <g class="hero-square-field">
        {heritageSquares.map(square => <rect x={square.x} y={square.y} width={square.size} height={square.size}
          fill={square.accent ? 'var(--primary)' : 'var(--square-neutral)'} opacity={square.opacity}
          style={`--square-opacity: ${square.opacity}; --square-duration: ${square.duration}s; --square-phase: ${square.phase}s;`} />)}
      </g>
      <g class="hero-square-light" mask="url(#hero-square-light-mask)">
        {heritageSquares.map(square => <rect x={square.x} y={square.y} width={square.size} height={square.size}
          fill={square.accent ? 'var(--primary)' : 'var(--square-neutral)'} opacity={square.highlight} />)}
      </g>
    </svg>
    <div class="hero-content">
      <h1 class="augur-type-display" id="hero-title" data-hero-heading>
        <span data-hero-line>The frontier of</span>{' '}
        <span data-hero-line><span class="hero-emphasis" data-hero-emphasis>decentralized</span></span>{' '}
        <span data-hero-line>truth<span class="hero-dot">.</span></span>
      </h1>
      <div class="hero-support augur-type-body web-lead" data-hero-support>
        <p class="hero-introduction">Permissionless resolution. No central authority.</p>
        <p class="hero-context">Augur is decentralized oracle infrastructure for establishing truth onchain. Anyone can submit a question, propose an answer, or challenge an outcome.</p>
      </div>
      <div class="hero-actions" data-hero-actions>
        <a role="link" aria-disabled="true" tabindex="0" data-review-placeholder class:list={[buttonVariants({ size: 'lg' }), 'configured-button']}>Explore Augur Lituus</a>
        <a href={whitepaperUrl} target="_blank" rel="noopener noreferrer" class:list={[buttonVariants({ variant: 'ghost', size: 'lg' }), 'configured-button']}>Read the whitepaper <Icon name="arrow-up-right" /></a>
      </div>
    </div>
    <div class="hero-artwork" data-hero-artwork><HeroLoom /></div>
  </section>
  <WhyHow />
  <Applications />
  <CurrentStage />
  <FromTheBlog />
  <HomeFaq />
  <SiteFooter slot="footer" />
</Website>
<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  const squares = hero?.querySelector<SVGSVGElement>('.hero-squares');
  const light = squares?.querySelector<SVGCircleElement>('[data-square-light-radius]');
  if (hero && squares && light) {
    // CSS owns the twinkle. Pointer frames move one mask, not every square.
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const lifecycle = new AbortController();
    const options = { signal: lifecycle.signal };
    let visible = false, pageHidden = false;
    let pointerFrame = 0;
    let pointer: { x: number; y: number } | null = null;
    const clearPointer = () => {
      cancelAnimationFrame(pointerFrame);
      pointerFrame = 0;
      pointer = null;
      delete squares.dataset.pointerActive;
    };
    const paintPointer = () => {
      pointerFrame = 0;
      if (!pointer || hero.dataset.squareMotion !== 'running') return;
      const matrix = squares.getScreenCTM();
      if (!matrix) return;
      // Invert the actual SVG mapping, including its centered crop on resize.
      const point = new DOMPoint(pointer.x, pointer.y).matrixTransform(matrix.inverse());
      light.setAttribute('cx', String(point.x));
      light.setAttribute('cy', String(point.y));
      light.setAttribute('r', String(200 / Math.hypot(matrix.a, matrix.b)));
      squares.dataset.pointerActive = 'true';
    };
    const syncSquares = () => {
      if (reduced.matches) {
        delete hero.dataset.squareMotion;
        clearPointer();
        return;
      }
      hero.dataset.squareMotion = visible && !document.hidden && !pageHidden ? 'running' : 'paused';
      if (hero.dataset.squareMotion === 'paused') clearPointer();
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      syncSquares();
    });
    observer.observe(hero);
    hero.addEventListener('pointermove', event => {
      if (event.pointerType === 'touch' || hero.dataset.squareMotion !== 'running') return;
      pointer = { x: event.clientX, y: event.clientY };
      if (!pointerFrame) pointerFrame = requestAnimationFrame(paintPointer);
    }, { ...options, passive: true });
    hero.addEventListener('pointerleave', clearPointer, options);
    hero.addEventListener('pointercancel', clearPointer, options);
    window.addEventListener('resize', clearPointer, options);
    window.addEventListener('scroll', clearPointer, { ...options, passive: true });
    reduced.addEventListener('change', syncSquares, options);
    document.addEventListener('visibilitychange', syncSquares, options);
    window.addEventListener('pagehide', event => {
      pageHidden = true;
      syncSquares();
      observer.disconnect();
      if (!event.persisted) {
        lifecycle.abort();
        delete hero.dataset.squareMotion;
      }
    }, options);
    window.addEventListener('pageshow', () => {
      pageHidden = false;
      observer.observe(hero);
      syncSquares();
    }, options);
  }
</script>
<style>
  /* Fills the first screen below the 96px header, so the next section always starts below the fold. */
  .home-hero {
    position: relative; isolation: isolate; display: flex; align-items: center; width: 100%;
    min-height: max(610px, calc(100svh - 96px)); overflow: clip;
    background: radial-gradient(ellipse 56% 72% at 80% 48%,
      color-mix(in srgb, var(--foreground) 9%, var(--background)),
      color-mix(in srgb, var(--foreground) 4%, var(--background)) 38%,
      var(--background) 78%);
  }
  .hero-content {
    position: relative; z-index: 2; width: min(1472px, calc(100% - 112px)); margin-inline: auto;
    padding-block: 64px 96px; pointer-events: none;
  }
  .hero-squares {
    --square-contrast: 1.6;
    --square-neutral: light-dark(var(--primary), var(--foreground));
    --square-animation: hero-square-pulse;
    --square-speed: .7;
    position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; pointer-events: none;
  }
  :global([data-theme="dark"]) .hero-squares {
    --square-contrast: 1; --square-animation: hero-square-twinkle; --square-speed: 1;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .hero-squares {
      --square-contrast: 1; --square-animation: hero-square-twinkle; --square-speed: 1;
    }
  }
  .hero-square-field rect { opacity: calc(var(--square-opacity) * var(--square-contrast)); }
  .hero-square-light { opacity: 0; }
  h1 { width: fit-content; font-size: clamp(60px, 5.6vw, 88px); line-height: 1.08; letter-spacing: -.045em; }
  h1 > span { display: block; }
  .hero-emphasis { position: relative; display: inline-block; }
  .hero-emphasis::after {
    content: ''; position: absolute; inset-inline: 0; bottom: .015em; height: .055em;
    background: var(--primary); opacity: 0; transform: scaleX(0); transform-origin: left;
    pointer-events: none;
  }
  .hero-dot { color: var(--primary); }
  /* Type size comes from the shared lead style (.web-lead); only wide screens enlarge it. */
  .hero-support { max-width: 480px; margin-top: 32px; }
  .hero-introduction { color: var(--foreground); }
  .hero-context { max-width: 440px; margin-top: 10px; color: var(--muted-foreground); }
  h1, .hero-support, .hero-actions { pointer-events: auto; }
  .hero-actions { display: flex; align-items: center; gap: 12px; width: fit-content; margin-top: 36px; }
  .hero-artwork { position: absolute; z-index: 1; inset: 0 -1% 0 27%; }
  .hero-artwork :global(.hero-loom-fallback), .hero-artwork :global(.hero-loom-canvas) {
    mask-image: linear-gradient(90deg, transparent 22%, #000 42%, #000 94%, transparent 100%);
  }
  @keyframes hero-line-arrival {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-support-arrival {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-actions-arrival {
    0% { opacity: 0; pointer-events: none; }
    1% { pointer-events: auto; }
    100% { opacity: 1; pointer-events: auto; }
  }
  @keyframes hero-artwork-arrival {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hero-emphasis-sweep {
    0% { opacity: 1; transform: scaleX(0); }
    38%, 70% { opacity: 1; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleX(1); }
  }
  @keyframes hero-square-twinkle {
    0%, 100% { opacity: calc(var(--square-opacity) * var(--square-contrast) * .08); }
    42%, 52% { opacity: calc(var(--square-opacity) * var(--square-contrast)); }
  }
  @keyframes hero-square-pulse {
    0%, 75%, 100% { opacity: 0; transform: scale(.75); }
    35% { opacity: calc(var(--square-opacity) * var(--square-contrast)); transform: scale(1.35); }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-square-motion] .hero-square-field rect {
      transform-box: fill-box; transform-origin: center;
      animation: var(--square-animation) calc(var(--square-duration) * var(--square-speed)) ease-in-out var(--square-phase) infinite;
      animation-play-state: paused;
    }
    [data-square-motion="running"] .hero-square-field rect { animation-play-state: running; }
    .hero-square-light { transition: opacity 450ms ease-out; }
    [data-square-motion="running"] [data-pointer-active] .hero-square-light {
      opacity: 1; transition-duration: 120ms;
    }
    /* Enabled before these nodes are parsed; no visible-then-hidden flash. */
    [data-hero-arrival="entering"] [data-hero-line] {
      animation: hero-line-arrival 700ms cubic-bezier(.22, .7, .22, 1) backwards;
    }
    [data-hero-arrival="entering"] [data-hero-line]:nth-child(2) { animation-delay: 100ms; }
    [data-hero-arrival="entering"] [data-hero-line]:nth-child(3) { animation-delay: 200ms; }
    [data-hero-arrival="entering"] [data-hero-support] {
      animation: hero-support-arrival 500ms cubic-bezier(.22, .7, .22, 1) 400ms backwards;
    }
    [data-hero-arrival="entering"] [data-hero-actions] {
      animation: hero-actions-arrival 300ms ease-out 650ms backwards;
    }
    [data-hero-arrival="entering"] [data-hero-artwork] {
      animation: hero-artwork-arrival 1200ms ease-out 300ms backwards;
    }
    [data-hero-arrival="entering"] .hero-squares {
      animation: hero-artwork-arrival 1600ms ease-out 500ms backwards;
    }
    [data-hero-arrival="entering"] .hero-emphasis::after {
      animation: hero-emphasis-sweep 1500ms cubic-bezier(.22, .7, .22, 1) 750ms backwards;
    }
  }
  /* The underline plays once on arrival; there is no hover state, because the word is not a link. */
  @media (min-width: 1600px) {
    .hero-content .hero-support { max-width: 530px; font-size: 20px; }
    .hero-context { max-width: 490px; }
  }
  @media (forced-colors: active) {
    .home-hero { background: var(--background); }
    .hero-squares { display: none; }
  }
  @media (max-width: 1100px) {
    .home-hero { min-height: max(580px, calc(100svh - 96px)); }
    .hero-content { width: calc(100% - 80px); padding-block: 56px 80px; }
    h1 { font-size: 60px; }
    .hero-support { max-width: 450px; }
  }
  /* The header wraps to two rows (125px) below 940px wide. */
  @media (max-width: 940px) {
    .home-hero { min-height: max(580px, calc(100svh - 125px)); }
  }
  @media (min-width: 1101px) and (max-height: 780px) {
    .home-hero { min-height: calc(100svh - 96px); }
    .hero-content { padding-block: 36px 64px; }
    h1 { font-size: clamp(60px, 5.2vw, 76px); }
    .hero-support { margin-top: 24px; }
    .hero-actions { margin-top: 28px; }
  }
  @media (max-width: 700px) {
    .home-hero { min-height: 700px; align-items: start; }
    .hero-content { width: calc(100% - 40px); padding-block: 48px 220px; }
    h1 { font-size: clamp(38px, 8.4vw, 58px); }
    .hero-content .hero-support { max-width: 440px; font-size: 16px; }
    .hero-content .hero-context { font-size: 16px; }
    .hero-actions { flex-wrap: wrap; }
    .hero-artwork { inset: 42% -20% -8% 0; }
  }
</style>
