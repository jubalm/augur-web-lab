---
import {createHash} from 'node:crypto';
import Home from './index.astro';
import VersionSwitch from '../components/home/VersionSwitch.astro';
import {switchInline,reviewInline} from '../components/home/review-inline';
import {reviewVersions,type ReviewVersion} from '../data/homepage-review';
// The homepage's review copies (owner, 21 Oct 2026); "/" stays the live page. /1/ is the homepage as it
// is, /2/ the v2 variant from Ryan's notes as Augus marked them, /3/ Ryan's notes alone, literal, and /4/
// Augus's marks, literal (the list and the copy each reads: data/homepage-review.ts). One dynamic route,
// not pages at pages/1/ to pages/4/: Astro writes one build-wide CSP hash list into every page, in route
// order, and static routes "1" to "4" sort before "404", so they would reorder that list on "/" as well.
// A dynamic route sorts after every static one, just before "/", which keeps "/" byte-identical.
// All four are noindex with their own canonical, and all four show the version switch.
// Astro.props is typed from getStaticPaths: { variant: HomeVariant }.
export function getStaticPaths(){return reviewVersions.map(({version,variant})=>({params:{version},props:{variant}}));}
const {variant}=Astro.props;
const version=Astro.params.version as ReviewVersion;
// v1 renders no review sheet or script; v2 to v4 render theirs (review-inline.ts).
const inline=variant==='v1'?undefined:reviewInline[variant];
// The streamed CSP meta is emitted before body components render, so every inline string is hashed here.
const sha=(text:string)=>`sha256-${createHash('sha256').update(text).digest('base64')}` as const;
Astro.csp?.insertStyleHash(sha(switchInline.style));Astro.csp?.insertScriptHash(sha(switchInline.script));
if(inline){inline.styles.forEach(css=>Astro.csp?.insertStyleHash(sha(css)));Object.values(inline.scripts).forEach(js=>Astro.csp?.insertScriptHash(sha(js)));}
---
<Home variant={variant} noindex><Fragment slot="version"><VersionSwitch current={version}/>{inline&&inline.styles.map(css=><style is:inline set:html={css}></style>)}</Fragment></Home>
