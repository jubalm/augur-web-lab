---
import Website from '../../layouts/Website.astro';
import NarrativeHeader from '../../components/redesign/NarrativeHeader.astro';
import MachineHero from '../../components/redesign/MachineHero.astro';
import ProductMechanism from '../../components/redesign/ProductMechanism.astro';
import ProductApplications from '../../components/redesign/ProductApplications.astro';
import ProductJournal from '../../components/redesign/ProductJournal.astro';
import ProductRoadmap from '../../components/redesign/ProductRoadmap.astro';
import ProductFaq from '../../components/redesign/ProductFaq.astro';
import PreviewSwitcher from '../../components/site/PreviewSwitcher.astro';
import Brand from '../../components/site/Brand.astro';
import Icon from '../../components/site/Icon.astro';
import { buttonVariants } from '../../components/ui/button-variants';
import { whitepaperUrl } from '../../lib/links';
const principles = [
  { title:'Permissionless.', description:'Anyone can ask, report or challenge. No invitation required.' },
  { title:'Decentralized.', description:'No committee, multisig or central veto gets the final say.' },
  { title:'Trustless by design.', description:'Protocol rules and economic stakes replace a privileged operator.' },
];
const footerGroups = [
  { title:'Explore', links:[{label:'Augur Lituus',href:'#mechanism'},{label:'Applications',href:'#applications'},{label:'Roadmap',href:'#roadmap'}] },
  { title:'Resources', links:[{label:'Blog',href:'#journal'},{label:'FAQ',href:'#faq'},{label:'Whitepaper',href:whitepaperUrl},{label:'Source code',href:'https://github.com/AugurProject/Lituus-CS'}] },
  { title:'Community', links:[{label:'Discord',href:'https://discord.gg/Y3tCZsSmz3'},{label:'Telegram',href:'https://t.me/augurlituus'},{label:'X',href:'https://x.com/AugurProject'},{label:'GitHub',href:'https://github.com/AugurProject/'}] },
];
---
<Website title="Augur | The frontier of decentralized truth — lab proposal" fixedTheme="light">
  <div slot="header" class="product-masthead" data-theme="dark"><NarrativeHeader /></div>
  <div class="rm-page">
    <MachineHero />
    <section class="product-principles rm-frame" id="principles" aria-label="An open resolution process">
      {principles.map((principle,index)=><article data-reveal style={`--reveal-order:${index}`}><h2 class="augur-type-editorial-section">{principle.title}</h2><p>{principle.description}</p></article>)}
    </section>
    <ProductMechanism />
    <ProductApplications />
    <ProductRoadmap />
    <ProductJournal />
    <ProductFaq />
  </div>
  <footer slot="footer" class="rm-footer rm-page" data-theme="dark">
    <div class="rm-frame">
      <div class="footer-invitation" data-reveal-group="heading"><h2 class="augur-type-display">What will you <br />build on the truth?</h2><div><p>Markets. Payments. Something entirely new.<br />Let’s talk about what you’re building.</p><a href="/contact/" class:list={[buttonVariants(), 'configured-button']}>Talk to us</a></div></div>
      <div class="footer-directory" data-reveal-group><div class="footer-brand"><a href="/" aria-label="Augur home"><Brand /></a><p>The frontier of decentralized truth.</p></div>{footerGroups.map(group=><nav aria-label={group.title}><h3 class="augur-type-ui">{group.title}</h3>{group.links.map(link=><a href={link.href} target={link.href.startsWith('http')?'_blank':undefined} rel={link.href.startsWith('http')?'noopener noreferrer':undefined}>{link.label}{link.href.startsWith('http')&&<Icon name="arrow-up-right" />}</a>)}</nav>)}</div>
      <div class="footer-bottom" data-reveal="fade"><p>Funded and coordinated by the Lituus Foundation.</p><a href="/contact/">Contact Augur</a></div>
    </div>
    <PreviewSwitcher />
  </footer>
</Website>
<script>
  import { initProductPage } from '../../motion/product-page';
  initProductPage();
</script>
<style is:global>
  html:has(.rm-page) { scroll-behavior:auto; scroll-padding-top:24px; }
  body:has(.rm-page) { --rm-accent:light-dark(var(--augur-color-accent-deep),var(--primary)); --rm-motion-fast:180ms; --rm-motion-base:320ms; --rm-motion-connect:650ms; --rm-ease:cubic-bezier(.16,1,.3,1); }
  .rm-frame { width:min(1440px,calc(100% - 112px)); margin-inline:auto; }
  .rm-page ::selection,.narrative-header ::selection { background:var(--primary); color:var(--primary-foreground); }
  .rm-page :is(h1,h2,h3,h4,p,figure) { margin-bottom:0; }
  .rm-page :is(h2,h3) { text-wrap:balance; }
  .rm-page :is(button,a,summary,input):focus-visible,.narrative-header :is(a,button,summary):focus-visible { outline:2px solid var(--foreground); outline-offset:5px; }
  .rm-section-title { font-size:clamp(34px,3.45vw,52px); font-weight:400; letter-spacing:-.03em; line-height:1.16; }
  .rm-body-small { font-size:15px; line-height:1.65; }
  .rm-link { display:inline-flex; align-items:center; gap:8px; min-height:44px; color:var(--foreground); font-size:14px; line-height:1.5; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; }
  .rm-link:hover { text-decoration-thickness:2px; }
  .rm-link .web-icon { width:16px; height:16px; flex:none; }
  .rm-page [hidden] { display:none!important; }
  .rm-page .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .product-masthead { color:var(--foreground); background:var(--background); }
  .product-principles { display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(32px,5vw,80px); padding-block:64px; }
  .product-principles article { border-top:1px solid var(--web-outline); padding-top:24px; }
  .product-principles h2 { font-size:clamp(23px,2.2vw,32px); font-weight:400; line-height:1.3; letter-spacing:-.025em; }
  .product-principles p { max-width:37ch; font-size:16px; line-height:1.6; color:var(--muted-foreground); margin-top:14px; }
  .rm-page [data-reveal],.rm-page [data-reveal-children] > * { animation:none; }
  .rm-footer { padding-top:80px; background:var(--background); color:var(--foreground); }
  .footer-invitation { display:grid; grid-template-columns:1.4fr 1fr; gap:64px; padding-bottom:80px; }
  .footer-invitation h2 { font-size:clamp(36px,4.3vw,64px); font-weight:400; letter-spacing:-.035em; line-height:1.18; }
  .footer-invitation > div { padding-top:6px; }
  .footer-invitation p { font-size:18px; line-height:1.65; color:var(--muted-foreground); }
  .footer-invitation a { margin-top:24px; }
  .footer-directory { display:grid; grid-template-columns:1.6fr repeat(3,1fr); gap:48px; padding-block:48px; border-top:1px solid var(--web-outline); }
  .rm-footer .brand .light-mark { display:none; }
  .rm-footer .brand .dark-mark { display:block; }
  .footer-brand > a { display:inline-flex; }
  .footer-brand > p { margin-top:22px; font-size:13px; line-height:1.6; color:var(--muted-foreground); max-width:24ch; }
  .footer-directory nav { display:flex; flex-direction:column; align-items:start; }
  .footer-directory h3 { font-size:13px; font-weight:600; margin-bottom:12px; }
  .footer-directory nav a { display:inline-flex; align-items:center; gap:7px; min-height:40px; font-size:13px; color:var(--muted-foreground); text-decoration:none; }
  .footer-directory nav a:hover { color:var(--foreground); text-decoration:underline; text-underline-offset:5px; }
  .footer-directory .web-icon { width:12px; height:12px; }
  .footer-bottom { display:flex; justify-content:space-between; gap:24px; align-items:center; padding-block:20px; border-top:1px solid var(--web-outline); font-size:12px; color:var(--muted-foreground); }
  .footer-bottom a { display:inline-flex; align-items:center; min-height:44px; text-underline-offset:5px; }
  @media(max-width:1100px) { .rm-frame { width:calc(100% - 80px); } .product-principles { gap:56px; } .footer-directory { gap:28px; } }
  @media(max-width:760px) { .rm-frame { width:calc(100% - 40px); } .rm-section-title { font-size:36px; } .footer-invitation { grid-template-columns:1fr; gap:40px; } .product-principles { grid-template-columns:1fr; gap:28px; padding-block:48px; } .product-principles h2 { font-size:27px; } .product-principles p { max-width:54ch; } .rm-footer { padding-top:56px; } .footer-invitation { padding-bottom:48px; gap:28px; } .footer-directory { grid-template-columns:repeat(3,1fr); gap:32px 16px; } .footer-brand { grid-column:1/-1; } .footer-brand > p { max-width:none; margin-top:16px; } }
  @media(max-width:540px) { .rm-section-title { font-size:32px; } .product-principles p { font-size:15px; } .footer-invitation h2 { font-size:38px; } .footer-invitation p { font-size:16px; } .footer-directory nav a { font-size:12px; } .footer-bottom { align-items:start; } .footer-bottom p { max-width:25ch; padding-top:10px; } }
  @media(prefers-reduced-motion:reduce) { .rm-page *, .rm-page *::before, .rm-page *::after { animation:none!important; transition:none!important; scroll-behavior:auto!important; } }
</style>
