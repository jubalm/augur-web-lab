---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import BlogArchive from '../../components/pages/BlogArchive.astro';
import { blogPageSize, newestFirst } from '../../components/content/blog';
export const getStaticPaths = (async ({ paginate })=>paginate(newestFirst(await getCollection('blog')),{pageSize:blogPageSize})) satisfies GetStaticPaths;
interface Props { page: Page<CollectionEntry<'blog'>>; }
const { page } = Astro.props;
---
<BlogArchive page={page}/>
