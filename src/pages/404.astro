---
import Base from '../layouts/Base.astro';
import { labOnly, labPath } from '../lib/deployment';
---
<Base title="Page not found"><section class="frame section stack"><p class="eyebrow muted">404 · Page not found</p><h1 class="augur-type-editorial-title">This experiment isn’t here.</h1><p class="muted">Return to the lab to find the current studies.</p><div class="actions"><a class="text-link" href={labPath()}>Explore the lab</a>{!labOnly && <a class="text-link" href="/">View homepage</a>}</div></section></Base>
