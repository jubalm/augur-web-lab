---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/primitives/Icon.astro';
import { Input } from '../components/ui/input';
import { Button } from '../components/ui/button';
import { links } from '../data/links';
const socials=[{key:'telegram',label:'Telegram',icon:'telegram-logo'},{key:'github',label:'GitHub',icon:'github-logo'},{key:'x',label:'X',icon:'x-logo'}] as const;
---
<PageLayout title="Contact Augur | Let’s talk" description="Ask the Augur team anything, or share a project and the answers it depends on." footer={false}>
 <div class="container contact-layout">
  <section class="contact-intro" aria-labelledby="contact-title">
   <h1 id="contact-title">Let’s talk!</h1>
   <p class="contact-lead">Ask us anything about Augur. If you’re building on it, tell us what your project needs to resolve.</p>
   <div class="community-invitation"><h2><Icon name="discord-logo"/>Talk with the community.</h2><p>Compare notes with builders, ask technical questions and follow the discussion on Discord.</p><a class="button outline" href={links.discord.url}>Join the conversation <Icon name="arrow-up-right"/></a></div>
   <div class="socials"><h2>Find us elsewhere</h2><ul>{socials.map(social=><li><a href={links[social.key].url}><Icon name={social.icon}/><span>{social.label}</span><Icon name="arrow-up-right"/></a></li>)}</ul></div>
   <p class="email-direct">Prefer email? <a href={links.contact.url}>contact@augur.net</a></p>
  </section>
  <section class="contact-message" aria-labelledby="message-title"><h2 id="message-title">Send us a message</h2><p>Ask a question, or share a project and the answers it depends on.</p>
   <form action={links.contact.url} method="post" enctype="text/plain" data-contact-form aria-labelledby="message-title">
    <div class="error-summary" data-error-summary role="status" aria-live="polite" tabindex="-1"></div>
    <div class="form-grid">
     <div class="field"><label for="contact-name">Name</label><Input id="contact-name" name="name" autoComplete="name" required maxLength={100} placeholder="Your name" aria-describedby="contact-name-error"/><p class="field-error" id="contact-name-error" hidden></p></div>
     <div class="field"><label for="contact-email">Email</label><Input id="contact-email" name="email" type="email" autoComplete="email" required maxLength={254} placeholder="you@example.com" aria-describedby="contact-email-error"/><p class="field-error" id="contact-email-error" hidden></p></div>
     <div class="field"><label for="contact-company">Company / project <span>(optional)</span></label><Input id="contact-company" name="company" autoComplete="organization" maxLength={200} placeholder="Your company or project" aria-describedby="contact-company-error"/><p class="field-error" id="contact-company-error" hidden></p></div>
     <div class="field"><label for="contact-website">Website <span>(optional)</span></label><Input id="contact-website" name="website" type="url" autoComplete="url" maxLength={2048} placeholder="https://your-project.com" aria-describedby="contact-website-error"/><p class="field-error" id="contact-website-error" hidden></p></div>
     <div class="field message-field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required maxlength="5000" rows="4" placeholder="Your question, or what a project needs to resolve" aria-describedby="contact-message-error"></textarea><p class="field-error" id="contact-message-error" hidden></p></div>
    </div>
    <Button type="submit">Send message</Button>
   </form>
  </section>
 </div>
</PageLayout>
<script>
 const form=document.querySelector<HTMLFormElement>('[data-contact-form]');
 if(form){
  form.noValidate=true;
  const fields=Array.from(form.querySelectorAll<HTMLInputElement|HTMLTextAreaElement>('input,textarea'));
  const summary=form.querySelector<HTMLElement>('[data-error-summary]')!;
  const validate=(field:HTMLInputElement|HTMLTextAreaElement)=>{
   let error='';
   if(field.required&&!field.value.trim())error=field.name==='name'?'Enter your name.':field.name==='email'?'Enter your email address.':'Write your message.';
   else if(field.validity.typeMismatch)error=field.name==='email'?'Enter a valid email address.':'Enter a website address starting with https:// or http://.';
   else if(field.name==='website'&&field.value.trim()){
    try{if(!['https:','http:'].includes(new URL(field.value.trim()).protocol))throw new Error();}catch{error='Enter a website address starting with https:// or http://.';}
   }
   if(!error&&field.maxLength>0&&field.value.length>field.maxLength)error=`Keep this to ${field.maxLength} characters or fewer.`;
   const message=document.getElementById(`${field.id}-error`)!;message.textContent=error;message.hidden=!error;
   field.setAttribute('aria-invalid',String(Boolean(error)));return !error;
  };
  for(const field of fields){field.addEventListener('blur',()=>validate(field));field.addEventListener('input',()=>{if(field.getAttribute('aria-invalid')==='true')validate(field);});}
  form.addEventListener('submit',event=>{
   event.preventDefault();const invalid=fields.filter(field=>!validate(field));
   if(invalid.length){summary.textContent=`Please correct ${invalid.length===1?'the highlighted field':`the ${invalid.length} highlighted fields`}.`;invalid[0].focus();return;}
   const value=(key:string)=>fields.find(field=>field.name===key)!.value.trim();
   const body=[`Name: ${value('name')}`,`Email: ${value('email')}`,value('company')?`Company / project: ${value('company')}`:'',value('website')?`Website: ${value('website')}`:'','',value('message')].filter((line,index)=>line||index===4).join('\n');
   summary.textContent='Opening your email app. Review the message there before sending.';
   window.location.href=`${form.getAttribute('action')}?subject=${encodeURIComponent(`Augur inquiry from ${value('name')}`)}&body=${encodeURIComponent(body)}`;
  });
 }
</script>
<style>
 .contact-layout{display:grid;grid-template-columns:minmax(0,536fr) minmax(0,644fr);gap:68px;min-height:calc(100svh - 96px - var(--announcement-height));align-items:center;padding-block:64px}.contact-intro h1{font-size:clamp(40px,4.445vw,64px);line-height:72px;letter-spacing:-.02em}.contact-lead{max-width:490px;font-size:18px;line-height:28px;color:var(--muted-foreground);margin-top:16px}.community-invitation{padding:24px;border:1px solid var(--web-outline);background:var(--web-quiet);margin-top:32px}.community-invitation h2{display:flex;align-items:center;gap:12px;font-size:20px;line-height:26px}.community-invitation p{color:var(--muted-foreground);margin:14px 0}.socials{margin-top:32px}.socials h2,.contact-message h2{font-size:20px;line-height:26px}.socials ul{display:flex;flex-wrap:wrap;gap:24px;list-style:none;margin:12px 0 0;padding:0}.socials a{display:inline-flex;align-items:center;gap:8px;min-height:44px;font:600 14px/20px var(--font-heading);text-decoration:none}.socials a :global(.web-icon:last-child){width:14px;height:14px}.email-direct{color:var(--muted-foreground);margin-top:16px}.email-direct a{text-decoration:none}.email-direct a:hover{text-decoration:underline}.contact-message{padding-left:52px;border-left:1px solid var(--border-quiet)}.contact-message>p{color:var(--muted-foreground);margin-top:12px}.contact-message form{margin-top:24px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 16px}.message-field{grid-column:1/-1}.field label{font-weight:400}.field textarea{min-height:132px}.contact-message :global(button[type=submit]){margin-top:24px}.error-summary:empty{display:none}.error-summary{margin-bottom:16px;font-size:14px;line-height:20px}.field :global(input){background:var(--card)}.field textarea{background:var(--card)}@media(max-width:1100px){.contact-layout{gap:40px}.contact-message{padding-left:32px}}@media(max-width:900px){.contact-layout{grid-template-columns:1fr;gap:48px;padding-block:48px 64px}.contact-message{border-left:0;padding:40px 0 0}.contact-intro h1{line-height:1.15}.contact-lead{max-width:600px}}@media(max-width:480px){.form-grid{grid-template-columns:1fr}.socials ul{gap:16px}.community-invitation{padding:20px}.community-invitation h2{align-items:start}}
</style>
