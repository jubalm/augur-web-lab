---
import Website from '../layouts/Website.astro';
import HomepageHeader from '../components/site/HomepageHeader.astro';
import Icon from '../components/site/Icon.astro';
import { Input } from '../components/ui/input';
import { Button } from '../components/ui/button';
import { buttonVariants } from '../components/ui/button-variants';
import { communityLinks } from '../lib/community';

const { telegram, github, x } = communityLinks;
const socials = [telegram, github, x];
// User-selected address; the domain owner must provision the inbox before release.
const contactEmail = 'contact@augur.net';
---
<Website title="Contact Augur | Talk to us" description="Ask about Augur products, discuss an idea, or find the Augur community on Discord, Telegram, GitHub and X.">
  <HomepageHeader slot="header" />
  <div class="contact-page">
    <section class="contact-introduction" aria-labelledby="contact-title">
      <h1 class="augur-type-display" id="contact-title">Talk to us<span class="contact-dot">.</span></h1>
      <p class="contact-lead augur-type-body">Have a question about our products, an idea to explore, or a project in mind? We’d like to hear from you.</p>

      <section class="discord-invitation" aria-labelledby="discord-title">
        <div class="discord-heading">
          <Icon name="discord-logo" class="social-icon" />
          <h2 class="augur-type-heading-2" id="discord-title">A quick question? Start on Discord.</h2>
        </div>
        <p class="augur-type-body">Skip the email back-and-forth. Ask the community and keep the conversation moving in one place.</p>
        <a role="link" aria-disabled="true" tabindex="0" data-review-placeholder class:list={[buttonVariants(), 'configured-button']}>Ask on Discord <Icon name="arrow-up-right" /></a>
      </section>

      <section class="community" aria-labelledby="community-title">
        <h2 class="augur-type-heading-2" id="community-title">Find us elsewhere</h2>
        <ul class="social-links">
          {socials.map(social => (
            <li>
              <a role="link" aria-disabled="true" tabindex="0">
                <Icon name={social.icon} class="social-icon" />
                <span class="augur-type-control">{social.name}</span>
                <Icon name="arrow-up-right" />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <p class="direct-contact augur-type-body">Prefer email? <a role="link" aria-disabled="true" tabindex="0">{contactEmail}</a></p>
    </section>

    <section class="contact-message" aria-labelledby="message-title">
      <h2 class="augur-type-heading-2" id="message-title">Send us a message</h2>
      <p class="form-introduction augur-type-body">Tell us what you’re working on or what you’d like to know.</p>

      <form method="post" data-contact-form aria-labelledby="message-title">
        <!-- Enable only after installing local validation and blocking submission.
             Structure review never submits data or launches an email app. -->
        <fieldset disabled data-contact-fields>
          <legend class="visually-hidden">Your message</legend>
          <div class="form-field">
            <label class="augur-type-ui" for="contact-name">Name</label>
            <Input id="contact-name" name="name" autoComplete="name" required maxLength={100} className="configured-field" placeholder="Your name" aria-describedby="name-error" />
            <p class="field-error augur-type-body" id="name-error" hidden></p>
          </div>
          <div class="form-field">
            <label class="augur-type-ui" for="contact-email">Email</label>
            <Input id="contact-email" name="email" type="email" autoComplete="email" required maxLength={254} className="configured-field" placeholder="you@example.com" aria-describedby="email-error" />
            <p class="field-error augur-type-body" id="email-error" hidden></p>
          </div>
          <div class="form-field">
            <label class="augur-type-ui" for="contact-company">Company / project <span class="optional">(optional)</span></label>
            <Input id="contact-company" name="company" autoComplete="organization" maxLength={200} className="configured-field" placeholder="Who are you building with?" aria-describedby="company-error" />
            <p class="field-error augur-type-body" id="company-error" hidden></p>
          </div>
          <div class="form-field">
            <label class="augur-type-ui" for="contact-website">Website <span class="optional">(optional)</span></label>
            <Input id="contact-website" name="website" type="url" autoComplete="url" maxLength={2048} className="configured-field" placeholder="https://your-project.com" aria-describedby="website-error" />
            <p class="field-error augur-type-body" id="website-error" hidden></p>
          </div>
          <div class="form-field message-field">
            <label class="augur-type-ui" for="contact-message">Message</label>
            <textarea id="contact-message" name="message" class="aug-input augur-type-ui configured-field" rows="4" required maxlength="5000" placeholder="What would you like to talk about?" aria-describedby="message-error"></textarea>
            <p class="field-error augur-type-body" id="message-error" hidden></p>
          </div>
          <div class="form-actions">
            <Button type="submit" className="configured-button">Send message</Button>
          </div>
        </fieldset>
      </form>
    </section>
  </div>
</Website>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const fields = form.querySelector<HTMLFieldSetElement>('[data-contact-fields]')!;
    const name = form.querySelector<HTMLInputElement>('#contact-name')!;
    const email = form.querySelector<HTMLInputElement>('#contact-email')!;
    const company = form.querySelector<HTMLInputElement>('#contact-company')!;
    const website = form.querySelector<HTMLInputElement>('#contact-website')!;
    const message = form.querySelector<HTMLTextAreaElement>('#contact-message')!;
    const validatedFields = [name, email, company, website, message];

    const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
      let error = '';
      if (field.required && !field.value.trim()) {
        error = field === name ? 'Enter your name.' : field === email ? 'Enter your email address.' : 'Write a message to continue.';
      } else if (field === website && field.value.trim()) {
        try {
          const url = new URL(field.value.trim());
          if (!['https:', 'http:'].includes(url.protocol)) throw new Error('Unsupported protocol');
        } catch { error = 'Enter a website address starting with https:// or http://.'; }
      } else if (field.validity.typeMismatch) error = 'Enter a valid email address, such as you@example.com.';
      if (!error && field.value.length > field.maxLength) error = `Keep this to ${field.maxLength.toLocaleString()} characters or fewer.`;
      const feedback = form.querySelector<HTMLElement>(`#${field.name}-error`)!;
      feedback.textContent = error;
      feedback.hidden = !error;
      if (error) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
      return !error;
    };

    form.addEventListener('submit', event => {
      event.preventDefault();
      const invalidFields = validatedFields.filter(field => !validate(field));
      if (invalidFields.length) {
        // Each error is attached to its field; focus announces the first one.
        invalidFields[0].focus();
        return;
      }
      // Valid input remains on this page; sending is a placeholder during review.
    });

    form.addEventListener('input', event => {
      const field = event.target;
      if ((field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) && field.hasAttribute('aria-invalid')) validate(field);
    });
    // Local field review only; no submission, email handoff or draft storage.
    form.noValidate = true;
    fields.disabled = false;
  }
</script>

<style>
  .contact-page {
    display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-content: center;
    gap: clamp(40px, 5vw, 72px); width: min(1248px, calc(100% - 112px));
    min-height: calc(100svh - 96px); box-sizing: border-box;
    margin-inline: auto; padding-block: clamp(24px, 4vh, 48px);
  }
  h1 { font-size: clamp(48px, 4.8vw, 68px); line-height: 1.1; letter-spacing: -.035em; }
  .contact-dot { color: var(--primary); }
  .contact-lead { max-width: 460px; margin-top: 16px; font-size: 18px; line-height: 1.5; color: var(--muted-foreground); }
  .discord-invitation { margin-top: 28px; padding: 20px; border: 1px solid var(--border-quiet); background: var(--muted); }
  .discord-heading { display: flex; align-items: center; gap: 12px; }
  .discord-invitation p { margin-block: 12px 16px; color: var(--muted-foreground); }
  .community { margin-top: 24px; }
  .social-links { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; margin: 8px 0 0; padding: 0; }
  .social-links a { display: flex; align-items: center; gap: 8px; min-height: 44px; text-decoration: none; }
  .contact-page :global(.social-icon) { width: 24px; height: 24px; }
  .social-links :global(.web-icon:last-child) { width: 16px; height: 16px; }
  .social-links a:hover .augur-type-control { text-decoration: underline; text-underline-offset: 4px; }
  .social-links a:focus-visible, .direct-contact a:focus-visible { outline: 2px solid var(--muted-foreground); outline-offset: 4px; }
  .direct-contact { margin-top: 16px; color: var(--muted-foreground); }
  .direct-contact a { color: var(--foreground); text-decoration-line: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .direct-contact a:hover { text-decoration-thickness: 2px; }
  .contact-message { border-left: 1px solid var(--border-quiet); padding-left: clamp(32px, 3.75vw, 56px); padding-top: 8px; }
  .form-introduction { margin-top: 8px; color: var(--muted-foreground); }
  form { margin-top: 24px; }
  fieldset { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 18px 16px; min-width: 0; border: 0; padding: 0; margin: 0; }
  .form-field { display: grid; gap: 8px; min-width: 0; }
  .message-field, .form-actions { grid-column: 1 / -1; }
  .optional { color: var(--muted-foreground); }
  textarea.configured-field { min-height: 128px; height: 128px; padding-block: 12px; resize: vertical; line-height: 1.6; }
  .form-field :global([aria-invalid="true"]) { box-shadow: inset 0 -2px var(--destructive); }
  .field-error { font-size: 14px; }
  .form-actions { display: flex; align-items: center; gap: 16px; }
  .form-actions :global(button) { flex-shrink: 0; }
  @media (max-width: 1100px) { .contact-page { width: calc(100% - 80px); gap: 32px; } .contact-message { padding-left: 32px; } .optional { font-size: 12px; } }
  @media (max-width: 800px) {
    .contact-page { grid-template-columns: 1fr; width: calc(100% - 40px); }
    .contact-message { padding: 40px 0 0; border-left: 0; border-top: 1px solid var(--border-quiet); }
  }
  @media (max-width: 500px) { fieldset { grid-template-columns: 1fr; } .form-actions { align-items: flex-start; flex-direction: column; } }
</style>
