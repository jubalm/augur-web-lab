---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { getCollection } from 'astro:content';
import PageLayout from './PageLayout.astro';
import HeritageField from '../components/art/HeritageField.astro';
import BlogCover from '../components/content/BlogCover.astro';
import BlogCard from '../components/content/BlogCard.astro';
import { blogCategory, newestFirst } from '../components/content/blog';
import { links } from '../data/links';
interface Props { post: CollectionEntry<'blog'>; headings: MarkdownHeading[]; }
const { post, headings }=Astro.props;
const date=new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(post.data.publishedAt);
const category=blogCategory(post);
const related=newestFirst(await getCollection('blog')).filter(item=>item.id!==post.id).slice(0,3);
const canonical=new URL(`/blog/${post.id}/`,Astro.site!);
const share=`${links.xShare.url}?url=${encodeURIComponent(canonical.href)}&text=${encodeURIComponent(post.data.title)}`;
---
<PageLayout title={`${post.data.title} | Augur`} description={post.data.description} article>
 <header class="article-header"><HeritageField seed={2020} width={1440} height={804}/><div class="container article-header-content"><a class="back-link" href="/blog/">← All posts</a><p class="article-meta">{post.data.category} · <time datetime={post.data.publishedAt.toISOString().slice(0,10)}>{date}</time> · {post.data.readingMinutes} min read</p><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><p class="byline">By the Augur team</p></div></header>
 <div class="container article-cover"><BlogCover variant={post.data.cover} large/></div>
 <div class="container article-body"><aside class="article-rail"><nav aria-label="On this page"><h2>On this page</h2>{headings.filter(h=>h.depth===2).map((heading,index)=><a href={`#${heading.slug}`} class="toc-link" aria-current={index===0?'location':undefined} data-article-heading={heading.slug}>{heading.text}</a>)}</nav><div class="rail-share"><h2>Share</h2><div><a href={share}>X <span aria-hidden="true">↗</span></a><button type="button" data-copy-link={canonical.href}>Copy link</button></div></div></aside>
  <article class="article-content"><div class="prose article-prose"><slot/></div><div class="article-end"><div><span>Filed under</span><a class="category-label" href={`/blog/category/${category.slug}/`}>{category.label}</a></div><div><span>Share</span><a href={share}>X <span aria-hidden="true">↗</span></a><button type="button" data-copy-link={canonical.href}>Copy link</button></div></div><p class="copy-status" role="status" aria-live="polite" data-copy-status></p></article>
 </div>
 <section class="section container keep-reading"><div class="keep-heading"><h2>Keep reading</h2><a class="button outline" href="/blog/">All posts</a></div><div class="related-grid">{related.map(item=><BlogCard post={item}/>)}</div></section>
</PageLayout>
<script>
 const status=document.querySelector<HTMLElement>('[data-copy-status]');
 for(const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]'))button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(button.dataset.copyLink!);if(status)status.textContent='Link copied';}catch{if(status)status.textContent='Could not copy the link. Copy the address from your browser.';}});
 const railLinks=Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-article-heading]'));
 const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(!entry.isIntersecting)continue;for(const link of railLinks){if(link.dataset.articleHeading===entry.target.id)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');}}},{rootMargin:'-8% 0px -70% 0px'});
 for(const link of railLinks){const heading=document.getElementById(link.dataset.articleHeading!);if(heading)observer.observe(heading);}
 window.addEventListener('pagehide',event=>{if(!event.persisted)observer.disconnect();});
</script>
<style>
 .article-header{position:relative;overflow:hidden;padding:72px 0 64px}.article-header-content{position:relative}.back-link{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;color:var(--muted-foreground)}.article-meta{margin-top:36px;color:var(--muted-foreground);font-size:16px;line-height:24px}.article-header h1{font-size:clamp(36px,4.167vw,60px);line-height:1.1333;letter-spacing:-.02em;max-width:940px;margin-top:24px}.article-header .lead{max-width:780px;color:var(--muted-foreground);margin-top:24px}.byline{display:flex;align-items:center;gap:16px;margin-top:36px;font-size:16px;line-height:24px}.byline::before{content:'';display:block;width:16px;height:16px;background:var(--primary);border:14px solid var(--web-quiet);box-sizing:content-box}.article-cover{padding-bottom:0}.article-body{display:grid;grid-template-columns:264px minmax(0,720px);gap:120px;padding-block:88px 96px}.article-rail{position:sticky;top:32px;align-self:start}.article-rail h2{font:600 14px/20px var(--font-heading);color:var(--muted-foreground);margin:0 0 24px}.toc-link{display:block;min-height:38px;padding:8px 0 8px 16px;border-left:1px solid var(--web-outline);font-size:15px;line-height:22px;text-decoration:none;color:var(--muted-foreground)}.toc-link[aria-current=location]{border-left:2px solid var(--primary);color:var(--foreground);padding-left:15px}.rail-share{margin-top:40px}.rail-share>div{display:flex;gap:12px}.rail-share a,.rail-share button{display:flex;align-items:center;min-height:44px;border:1px solid var(--web-outline);padding:8px 14px;color:var(--foreground);background:transparent;font-size:14px;text-decoration:none}.article-content{min-width:0}.article-prose{line-height:30px}.article-prose :global(h2+p){margin-top:20px}.article-prose :global(>p:first-child){font-size:22px;line-height:33px;color:var(--foreground)}.article-prose :global(>p:first-child+h2){margin-top:52px}.article-prose :global(h2){font-size:30px;line-height:38px;font-weight:600;margin-top:48px}.article-prose :global(blockquote){border-block:0;border-left:3px solid var(--primary);padding:4px 0 4px 32px;margin:48px 0;font-size:32px;line-height:42px;font-weight:600}.article-end{border-top:1px solid var(--border-quiet);padding-top:32px;margin-top:48px;display:flex;justify-content:space-between;gap:24px;font-size:14px;color:var(--muted-foreground)}.article-end>div{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.article-end a,.article-end button{min-height:44px;display:inline-flex;align-items:center;background:transparent;border:0;padding:0;color:var(--foreground);text-decoration:none;font-size:14px}.category-label{border:1px solid var(--web-outline)!important;padding:8px 12px!important}.copy-status{margin-top:16px;min-height:24px;font-size:14px;color:var(--muted-foreground)}.keep-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:48px}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}
 .article-prose :global(.bond-figure){margin:48px 0}.article-prose :global(.bond-chart){padding:48px 40px 40px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;background:var(--card)}.article-prose :global(.bar-group){text-align:center;min-width:0}.article-prose :global(.bar-space){height:224px;display:flex;align-items:end;justify-content:center;border-bottom:1px solid var(--border-quiet)}.article-prose :global(.bar){display:block;width:64px;height:var(--height);border:1.5px solid var(--muted-foreground)}.article-prose :global(.bar.first){background:var(--primary);border-color:var(--primary)}.article-prose :global(.bar-group strong){display:block;font:600 18px/24px var(--font-heading);margin:16px 0 4px;color:var(--foreground)}.article-prose :global(.bar-group>span){display:block;font-size:14px;line-height:20px;color:var(--muted-foreground)}.article-prose :global(.bar-group:first-child strong){color:var(--primary)}
 @media(max-width:1200px){.article-body{grid-template-columns:220px minmax(0,720px);gap:64px}}@media(max-width:1023px){.article-body{grid-template-columns:1fr;gap:48px}.article-rail{position:static}.article-rail nav{display:grid;grid-template-columns:1fr 1fr}.article-rail h2{grid-column:1/-1}.rail-share{display:none}.article-content{max-width:720px}.related-grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.article-header{padding:40px 0 48px}.article-rail nav,.related-grid{grid-template-columns:1fr}.article-body{padding-block:48px 64px}.article-end{flex-direction:column}.keep-heading{align-items:start;flex-direction:column}.article-prose :global(.bond-chart){padding:16px;gap:8px}.article-prose :global(.bar-space){height:180px}.article-prose :global(.bar){width:32px;max-height:calc(var(--height)*.5)}.article-prose :global(.bar-group strong){font-size:14px}.article-prose :global(.bar-group>span){font-size:11px}}
</style>
