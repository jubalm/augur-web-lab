---
import '../styles/augur.css';
import '../styles/site.css';
import '../styles/website-options.css';
import PreviewSwitcher from '../components/site/PreviewSwitcher.astro';
interface Props { title: string; description?: string; scaffold?: boolean; previewChooser?: boolean; }
const {title,description='Augur Lituus. Permissionless, decentralized resolution infrastructure in development.',scaffold=false,previewChooser=true}=Astro.props;
---
<!doctype html>
<html lang="en" data-theme={scaffold ? 'light' : undefined} data-icon-weight="bold" data-icon-style="outline" data-field="filled">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" /><title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/brand/glyph-color.svg" />
    <link rel="icon" type="image/svg+xml" href="/brand/glyph-reversed.svg" media="(prefers-color-scheme: dark)" />
    {!scaffold && <script is:inline>
      try { const theme=localStorage.getItem('augur-web-lab:theme'); if(theme==='light'||theme==='dark') document.documentElement.dataset.theme=theme; } catch {}
    </script>}
  </head>
  <body class:list={[scaffold ? 'homepage-scaffold' : 'website-direction']}>
    {!scaffold && <a class="skip-link" href="#main">Skip to content</a>}
    <slot />
    {!scaffold && previewChooser && <PreviewSwitcher />}
  </body>
</html>

<style is:global>
  body.homepage-scaffold {
    --background: #fff;
    --foreground: #000;
    --border: #000;
    --primary: #000;
    --primary-foreground: #fff;
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
    color-scheme: light;
  }
</style>
