---
import Document from './Document.astro';
import '../styles/motion.css';
interface Props { title: string; description?: string; scaffold?: boolean; fixedTheme?: 'light' | 'dark'; }
const {title,description,scaffold=false,fixedTheme}=Astro.props;
---
<Document title={title} description={description} scaffold={scaffold} fixedTheme={fixedTheme} previewChooser={false}>
  <slot name="header" />
  <main id="main"><slot /></main>
  <slot name="footer" />
</Document>
