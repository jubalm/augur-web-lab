---
import { readFileSync } from 'node:fs';
import { buttonVariants } from '../ui/button-variants';
// Build-time only: inline original supplied SVGs, preserving every path and fill.
const color = readFileSync('public/brand/glyph-color.svg', 'utf8');
const reversed = readFileSync('public/brand/glyph-reversed.svg', 'utf8');
---
<div class="logo-experiment" data-logo-experiment>
  <div class="stage">
    <div class="stage-meta eyebrow muted"><span>Identity assembly study</span><span>01</span></div>
    <div class="mark" role="img" aria-label="The assembled Augur glyph">
      <div class="light-art" aria-hidden="true" set:html={color} />
      <div class="dark-art" aria-hidden="true" set:html={reversed} />
    </div>
    <span class="stage-caption eyebrow muted">Original geometry · Two paths</span>
  </div>
  <div class="motion-controls" hidden>
    <button type="button" data-replay class={buttonVariants({variant: 'outline', size: 'lg'})}>Replay assembly <span aria-hidden="true">↻</span></button>
    <label><input type="checkbox" data-static /> Preview reduced motion</label>
    <p class="muted" role="status" aria-live="polite" data-motion-status>Assembled</p>
  </div>
  <noscript><p class="notes">The complete mark is shown. Enable JavaScript to replay the assembly study.</p></noscript>
</div>
<script>
  import { mountLogoAssembly } from '../../motion/logo-assembly';
  document.querySelectorAll<HTMLElement>('[data-logo-experiment]').forEach(mountLogoAssembly);
</script>
<style>
  .stage { min-height: 440px; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 32px; background: var(--muted); border: 1px solid var(--border-quiet); }
  .stage-meta { display: flex; justify-content: space-between; width: 100%; }
  .mark { padding: 64px; }
  .mark :global(svg) { width: 180px; height: auto; overflow: visible; }
  .dark-art { display: none; }
  :global(html[data-theme="dark"]) .light-art { display: none; }
  :global(html[data-theme="dark"]) .dark-art { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .light-art { display: none; }
    :global(html:not([data-theme="light"])) .dark-art { display: block; }
  }
  .motion-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; padding-block: 24px; }
  .motion-controls label { display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: 14px; cursor: pointer; }
  input { width: 18px; height: 18px; accent-color: var(--primary); }
  .motion-controls p { margin-left: auto; font-size: 12px; }
  @media (max-width: 600px) { .stage { min-height: 380px; padding: 24px; } .mark { padding: 48px; } .mark :global(svg) { width: 144px; } .motion-controls p { margin-left: 0; width: 100%; } }
</style>
