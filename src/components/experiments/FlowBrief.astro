---
import type { FlowBrief } from '../../lib/user-flow-pages';
import FlowDisclosureIcon from './FlowDisclosureIcon.astro';
interface Props { brief: FlowBrief; index: number; open?: boolean; }
const { brief, index, open = false } = Astro.props;
---
<details class="flow-brief" id={brief.id} open={open} tabindex="-1">
  <summary>
    <span class="brief-number augur-type-metadata">{String(index + 1).padStart(2, '0')}</span>
    <span class="brief-heading"><span class="augur-type-heading-2">{brief.title.replace(/^\d{2} · /, '')}</span><span class="muted augur-type-ui">{brief.question}</span></span>
    <FlowDisclosureIcon />
  </summary>
  <dl class="brief-body">
    <div class="brief-purpose">
      <dt class="augur-type-control">Purpose</dt>
      <dd class="augur-type-body">{brief.purpose}</dd>
    </div>
    <div class="brief-content">
      <dt class="augur-type-control">Content</dt>
      <dd class="augur-type-body"><ul>{brief.contains.map(item => <li>{item}</li>)}</ul></dd>
    </div>
  </dl>
</details>
<style>
  .flow-brief { border-top: 1px solid var(--border-quiet); scroll-margin-top: 24px; }
  .flow-brief:focus { outline: none; }
  .flow-brief:focus > summary { background: var(--muted); }
  .flow-brief:last-child { border-bottom: 1px solid var(--border-quiet); }
  summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 28px minmax(0, 1fr) 28px; align-items: center; gap: 16px; padding: 24px 16px; }
  summary::-webkit-details-marker { display: none; }
  .flow-brief > summary:hover { background: var(--muted); }
  summary > :global(.flow-disclosure-icon) { justify-self: center; }
  .brief-number { color: var(--muted-foreground); align-self: start; padding-top: 5px; }
  .brief-heading { display: grid; min-width: 0; gap: 8px; overflow-wrap: anywhere; }
  .brief-body { margin: 8px 16px 32px 60px; padding-top: 24px; border-top: 1px solid var(--border-quiet); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 32px; }
  .brief-body > div { display: grid; align-content: start; gap: 16px; min-width: 0; }
  .brief-body dt { color: var(--muted-foreground); }
  .brief-body dd { margin: 0; overflow-wrap: anywhere; text-wrap: pretty; }
  .brief-content { padding-left: 32px; border-left: 1px solid var(--border-quiet); }
  ul { margin: 0; padding-left: 18px; display: grid; gap: 16px; list-style: disc; }
  li { padding-left: 6px; }
  li::marker { color: var(--muted-foreground); font-size: .75em; }
  @media (max-width: 800px) { summary { grid-template-columns: 24px minmax(0,1fr) 28px; } .brief-body { margin-left: 56px; grid-template-columns: 1fr; gap: 24px; } .brief-content { padding: 24px 0 0; border-left: 0; border-top: 1px solid var(--border-quiet); } }
  @keyframes brief-reveal {
    from { opacity: .35; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.flow-workshop[data-motion]) .flow-brief[open] > .brief-body { animation: brief-reveal 240ms ease-out; }
    :global(.flow-workshop[data-motion]) summary { transition: background-color 160ms; }
  }
  @media print {
    :global(.flow-workshop[data-motion]) .flow-brief[open] > .brief-body { animation: none; }
  }
  @media print { summary { break-after: avoid; } :global(.flow-disclosure-icon) { display: none; } .brief-body { margin-left: 0; } .flow-brief { border-color: #aaa; } }
</style>
