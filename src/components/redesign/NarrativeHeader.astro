---
import Brand from '../site/Brand.astro';
import Icon from '../site/Icon.astro';
import { buttonVariants } from '../ui/button-variants';
import { whitepaperUrl } from '../../lib/links';
const socials = [
  {name:'Discord',icon:'discord-logo' as const,url:'https://discord.gg/Y3tCZsSmz3'},
  {name:'Telegram',icon:'telegram-logo' as const,url:'https://t.me/augurlituus'},
  {name:'X',icon:'x-logo' as const,url:'https://x.com/AugurProject'},
  {name:'GitHub',icon:'github-logo' as const,url:'https://github.com/AugurProject/'},
];
---
<header class="narrative-header rm-frame" data-product-header>
  <a class="home-link" href="/" aria-label="Augur home"><Brand /></a>
  <nav aria-label="Main navigation">
    <details name="product-navigation" class="nav-menu">
      <summary class="augur-type-ui">Products <Icon name="chevron-down" /></summary>
      <div class="nav-panel products-panel">
        <a href="#mechanism"><span>Augur Lituus</span><small>Permissionless question resolution</small></a>
        <a href="https://www.augur.net/blog/augur-testing-past-building-future/" target="_blank" rel="noopener noreferrer"><span>Zoltar <Icon name="arrow-up-right" /></span><small>Explore the oracle ecosystem</small></a>
        <a href="https://www.augur.net/blog/augur-testing-past-building-future/" target="_blank" rel="noopener noreferrer"><span>Augur Stratoblast <Icon name="arrow-up-right" /></span><small>Read the prediction markets update</small></a>
        <a class="panel-footer" href="#applications">Explore possible applications</a>
      </div>
    </details>
    <a class="nav-item augur-type-ui" href="#journal">Blog</a>
    <details name="product-navigation" class="nav-menu">
      <summary class="augur-type-ui">Resources <Icon name="chevron-down" /></summary>
      <div class="nav-panel">
        <a href="#mechanism"><span>How it works</span></a>
        <a href="#faq"><span>FAQ</span></a>
        <a href="#roadmap"><span>Roadmap</span></a>
        <a href={whitepaperUrl} target="_blank" rel="noopener noreferrer"><span>Whitepaper <Icon name="arrow-up-right" /></span></a>
        <a href="https://github.com/AugurProject/Lituus-CS" target="_blank" rel="noopener noreferrer"><span>Source code <Icon name="arrow-up-right" /></span></a>
      </div>
    </details>
    <details name="product-navigation" class="nav-menu">
      <summary class="augur-type-ui">Community <Icon name="chevron-down" /></summary>
      <div class="nav-panel community-panel">{socials.map(social=><a href={social.url} target="_blank" rel="noopener noreferrer"><Icon name={social.icon}/><span>{social.name}</span><Icon name="arrow-up-right"/></a>)}</div>
    </details>
  </nav>
  <a class:list={[buttonVariants({variant:'outline'}),'configured-button','header-contact']} href="/contact/">Talk to us</a>
  <div class="navigation-surface" data-navigation-surface aria-hidden="true"></div>
</header>
<script>
  import { initProductNavigation } from '../../motion/product-navigation';
  initProductNavigation(document.querySelector<HTMLElement>('[data-product-header]'));
</script>
<style>
  .narrative-header { display:flex; align-items:center; gap:40px; min-height:104px; position:relative; z-index:20; border-bottom:1px solid var(--border-quiet); }
  .narrative-header :global(.brand .light-mark) { display:none; }
  .narrative-header :global(.brand .dark-mark) { display:block; }
  .home-link { display:block; flex:none; padding-block:24px; }
  nav { display:flex; align-items:center; gap:32px; margin-inline:auto; }
  .nav-menu { position:relative; }
  summary,.nav-item { position:relative; display:flex; align-items:center; gap:7px; min-height:44px; list-style:none; cursor:pointer; font-size:15px; text-decoration:none; }
  summary::-webkit-details-marker { display:none; }
  summary :global(.web-icon) { width:13px; height:13px; transition:transform 180ms; }
  details[open] summary :global(.web-icon) { transform:rotate(180deg); }
  summary::after,.nav-item::after { content:''; position:absolute; height:2px; inset:auto 0 3px; background:var(--primary); transform:scaleX(0); transform-origin:left; transition:transform 250ms var(--rm-ease); }
  summary:hover::after,.nav-item:hover::after,details[open] summary::after,summary:focus-visible::after,.nav-item:focus-visible::after { transform:scaleX(1); }
  .nav-panel a { transition:background-color 180ms ease-out; }
  .nav-panel a > span { transition:translate 250ms var(--rm-ease); }
  .nav-panel a:hover > span,.nav-panel a:focus-visible > span { translate:3px 0; }
  .header-contact { flex:none; }
  .nav-panel { position:absolute; z-index:2; top:calc(100% + 18px); left:-20px; width:246px; padding:8px; border:1px solid var(--web-outline); background:var(--popover); color:var(--popover-foreground); }
  .nav-menu:not([open]) > .nav-panel { display:none; }
  .products-panel { width:336px; }
  .nav-panel a { display:flex; flex-direction:column; gap:7px; padding:14px; min-height:48px; text-decoration:none; }
  .nav-panel a:hover,.nav-panel a:focus-visible { background:var(--muted); }
  .nav-panel a > span { display:flex; justify-content:space-between; align-items:center; gap:12px; font:400 15px var(--augur-font-primary); }
  .nav-panel a small { font-size:12px; color:var(--muted-foreground); }
  .nav-panel :global(.web-icon) { width:16px; height:16px; flex:none; }
  .nav-panel .panel-footer { flex-direction:row; align-items:center; justify-content:space-between; border-top:1px solid var(--border-quiet); margin-top:6px; font-size:12px; }
  .community-panel a { flex-direction:row; align-items:center; gap:12px; }
  .community-panel a > span { margin-right:auto; }
  .navigation-surface { display:none; }
  [data-enhanced] .navigation-surface { position:absolute; z-index:1; left:0; top:0; border:1px solid var(--web-outline); background:var(--popover); pointer-events:none; transform-origin:top left; }
  [data-enhanced] .navigation-surface[data-open] { display:block; }
  [data-enhanced] .nav-panel { background:transparent; border-color:transparent; }
  @media(max-width:1000px) { .narrative-header { gap:24px; } nav { gap:20px; } summary,.nav-item { font-size:14px; } }
  @media(max-width:800px) { .narrative-header { flex-wrap:wrap; gap:0; padding-bottom:8px; justify-content:space-between; } nav { order:3; width:100%; justify-content:space-between; margin:0; gap:10px; } .header-contact { margin-left:auto; } .nav-menu { position:static; } .nav-panel { left:0; top:100%; width:min(360px,100%); } .community-panel { left:auto; right:0; } }
  @media(max-width:400px) { summary,.nav-item { font-size:12px; gap:4px; } summary :global(.web-icon) { width:11px; } .header-contact { padding-inline:16px; } }
  @media(prefers-reduced-motion:reduce) { summary :global(.web-icon),summary::after,.nav-item::after,.nav-panel a,.nav-panel a > span,[data-enhanced] .navigation-surface { transition:none; } }
</style>
