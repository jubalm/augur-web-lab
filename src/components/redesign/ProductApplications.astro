---
import ApplicationExamples from '../site/ApplicationExamples.astro';
---
<section id="applications" class="product-applications" aria-labelledby="product-applications-title">
  <div class="rm-frame">
    <div class="applications-heading" data-reveal-group>
      <h2 id="product-applications-title" data-reveal="heading" class="rm-section-title augur-type-display">What could you build?</h2>
      <p class="web-lead">Augur Lituus answers real-world questions.<br />Your app decides what happens next.</p>
    </div>
    <ApplicationExamples idPrefix="product-use" />
  </div>
</section>
<style>
  .product-applications { padding-block: 88px 64px; background: var(--background); color: var(--foreground); scroll-margin-top: 32px; }
  .applications-heading { display: flex; justify-content: space-between; align-items: end; gap: 64px; margin-bottom: 36px; }
  .applications-heading > p { color: var(--muted-foreground); max-width: 39ch; }
  @media (max-width: 1100px) { .applications-heading { gap: 40px; } }
  @media (max-width: 800px) {
    .product-applications { padding-block: 64px 40px; }
    .applications-heading { display: block; margin-bottom: 24px; }
    .applications-heading > p { margin-top: 24px; }
  }
</style>
