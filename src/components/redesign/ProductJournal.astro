---
import Icon from '../site/Icon.astro';

// Actual published Augur thumbnails; source URLs and hashes are recorded in
// docs/redesign-blog-provenance.json. Preserve the artwork's complete geometry.
const articles = [
  {
    title: 'The Augur Moon Fork Is Complete',
    date: 'August 5, 2026',
    datetime: '2026-08-05',
    summary: 'Augur v2’s first complete fork on Ethereum, and what the live process taught us.',
    href: 'https://www.augur.net/blog/post-fork-announcements/',
    image: 'moon-fork-complete',
  },
  {
    title: 'Augur Is Testing Its Past and Building Its Future',
    date: 'July 21, 2026',
    datetime: '2026-07-21',
    summary: 'From the Moon Fork to Augur Lituus: the resolution problem and the work underway.',
    href: 'https://www.augur.net/blog/augur-testing-past-building-future/',
    image: 'testing-past-building-future',
  },
  {
    title: 'Q1 2026: The Migration Window is Open',
    date: 'July 2, 2026',
    datetime: '2026-07-02',
    summary: 'A look back at the migration phase and the start of ChainSafe’s work on Augur Lituus.',
    href: 'https://www.augur.net/blog/q1-2026-progress-report/',
    image: 'q1-2026-migration-window',
  },
];
---

<section id="journal" class="product-journal rm-frame" aria-labelledby="journal-title">
  <div class="journal-heading" data-reveal-group="heading">
    <div>
      <h2 id="journal-title" class="augur-type-display rm-section-title">From the blog.</h2>
      <p class="rm-body-small">The ideas, decisions and milestones shaping Augur.</p>
    </div>
    <a class="rm-link" href="https://www.augur.net/blog/" target="_blank" rel="noopener noreferrer">All posts<Icon name="arrow-up-right" /></a>
  </div>
  <div class="journal-grid">
    {articles.map((article, index) => (
      <article class="journal-article">
        <a href={article.href} target="_blank" rel="noopener noreferrer" class="article-link" aria-labelledby={`journal-article-${index}`}>
          <img
            class="article-image"
            data-reveal="image"
            style={`--reveal-order:${index}`}
            src={`/images/redesign-blog/${article.image}.webp`}
            srcset={`/images/redesign-blog/${article.image}-600.webp 600w, /images/redesign-blog/${article.image}.webp 1200w`}
            sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 760px) calc((100vw - 68px) * .44), (max-width: 900px) calc((100vw - 108px) * .44), (max-width: 1100px) calc((100vw - 128px) / 3), (max-width: 1552px) calc((100vw - 176px) / 3), 459px"
            width="1200"
            height="630"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="article-copy" data-reveal style={`--reveal-order:${index}`}>
            <h3 id={`journal-article-${index}`} class="augur-type-editorial-section">{article.title}</h3>
            <p class="article-date"><time datetime={article.datetime}>{article.date}</time></p>
            <p class="article-summary rm-body-small">{article.summary}</p>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .product-journal { padding-block:80px; }
  .journal-heading { display:flex; justify-content:space-between; align-items:end; gap:32px; margin-bottom:36px; }
  .journal-heading p { margin-top:18px; max-width:48ch; color:var(--muted-foreground); }
  .journal-heading > a { flex:none; }
  .journal-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px; }
  .journal-article { min-width:0; }
  .article-link { display:block; height:100%; color:var(--foreground); text-decoration:none; }
  .article-image { display:block; width:100%; height:auto; aspect-ratio:1200/630; }
  .article-copy { padding-top:24px; }
  .article-copy h3 { margin:0; font-size:clamp(23px,1.9vw,28px); line-height:1.3; letter-spacing:-.025em; text-wrap:balance; }
  .article-date { margin-top:16px; color:var(--muted-foreground); font-size:12px; line-height:1.5; }
  .article-summary { margin-top:12px; max-width:47ch; color:var(--muted-foreground); }
  .article-link:hover h3 { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; }
  .article-link:focus-visible { outline:2px solid var(--foreground); outline-offset:8px; }
  @media(max-width:1100px) { .journal-grid { gap:24px; } .article-copy h3 { font-size:23px; } }
  @media(max-width:900px) {
    .journal-grid { grid-template-columns:1fr; gap:28px; }
    .article-link { display:grid; grid-template-columns:1fr 1.25fr; align-items:start; gap:28px; }
    .article-copy { padding-top:0; }
    .article-copy h3 { font-size:24px; }
    .journal-article + .journal-article { padding-top:28px; border-top:1px solid var(--web-outline); }
    .article-date { margin-top:12px; }
    .article-summary { margin-top:10px; font-size:14px; }
  }
  @media(max-width:540px) {
    .product-journal { padding-block:64px; }
    .journal-heading { align-items:start; gap:20px; margin-bottom:28px; }
    .journal-heading p { margin-top:16px; max-width:24ch; font-size:14px; }
    .journal-heading > a { margin-top:0; font-size:13px; }
    .journal-grid { gap:36px; }
    .article-link { display:block; }
    .article-copy { padding-top:20px; }
    .article-copy h3 { font-size:25px; }
    .journal-article + .journal-article { padding-top:0; border-top:0; }
    .article-summary { max-width:43ch; font-size:15px; }
  }
</style>
