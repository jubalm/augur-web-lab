---
import Icon from '../site/Icon.astro';
import { whitepaperUrl } from '../../lib/links';
const outcomes = ['Yes', 'No', 'Invalid'];
const stages = [
  { role:'Builders', title:'Define a query', heading:'Ask a precise question.', description:'Specify the question, possible answers and resolution criteria. Submit the query with a fee in REP.', note:'The builder defines what needs to be resolved.', status:'Query specification' },
  { role:'REP holders', title:'Report an answer', heading:'Put REP behind an answer.', description:'Report against the query’s criteria and lock REP as a bond. A losing answer can cost that bond.', note:'Try the reporter’s role. Choose an answer.', status:'Reporting' },
  { role:'REP holders', title:'Challenge if needed', heading:'Keep the answer accountable.', description:'Anyone can challenge a report with a larger REP bond. A completed challenge starts a new appeal period.', note:'Further disputes can escalate to a fork.', status:'Open to challenges' },
  { role:'Builders', title:'Use the result', heading:'Let the application take it from here.', description:'An appeal period ends without a completed challenge. The answer becomes final, and the application applies its own rules.', note:'Augur resolves the question. The application decides the action.', status:'Final answer' },
];
---
<section class="product-mechanism" id="mechanism" data-theme="dark" data-resolution-journey aria-labelledby="product-mechanism-title">
  <div class="mechanism-sticky rm-frame" data-journey-sticky>
    <div class="mechanism-heading" data-reveal-group>
      <h2 id="product-mechanism-title" data-reveal="heading" class="rm-section-title augur-type-display">Builders ask.<br />REP holders resolve.</h2>
      <p>Builders submit queries for applications.<br /> REP holders can report and challenge answers.<br /> The application uses the final result.</p>
    </div>
    <fieldset class="mechanism-explorer">
      <legend class="visually-hidden">Follow a query from the builder to reporters and back to the application</legend>
      <div class="mechanism-stages" data-reveal-group>
        {stages.map((stage,index)=><label class="mechanism-stage"><input class="visually-hidden" type="radio" name="product-resolution-stage" value={index+1} checked={index===0} aria-controls={`mechanism-stage-${index+1}`} /><span class="stage-number" aria-hidden="true">0{index+1}</span><span class="stage-label"><span class="stage-role">{stage.role}</span><span class="stage-title">{stage.title}</span></span><Icon name="arrow-right" /></label>)}
      </div>
      <div class="mechanism-progress" aria-hidden="true"><span></span></div>
      <div class="mechanism-scenes">
        {stages.map((stage,index)=><div id={`mechanism-stage-${index+1}`} class="mechanism-scene" aria-label={`${stage.role}: ${stage.title}`}>
          <div class="scene-copy">
            <h3 class="augur-type-editorial-section">{stage.heading}</h3>
            <p>{stage.description}</p>
            <p class="scene-note">{stage.note}</p>
            {index===0 && <a class="rm-link" href={whitepaperUrl} target="_blank" rel="noopener noreferrer">Explore the query format<Icon name="arrow-up-right" /></a>}
            {index===2 && <p class="challenge-caution">A larger bond opens a challenge.<br />It does not prove an answer correct.</p>}
            {index===3 && <a class="rm-link" href="#applications">Explore applications<Icon name="arrow-right" /></a>}
          </div>
          <div class="mechanism-diagram" data-theme="light">
            <div class="query-window">
              <div class="query-meta"><span>Flight-delay application</span><span class="query-status">{stage.status}</span></div>
              <h4 class="augur-type-ui">Was flight AB123 more than two hours late?</h4>
              {index===0 && <div class="query-specification">
                <dl><div><dt>Flight date</dt><dd>20 September 2026</dd></div><div><dt>Measure</dt><dd>Arrival against the published schedule</dd></div><div><dt>Possible answers</dt><dd class="defined-outcomes">{outcomes.map(answer=><span>{answer}</span>)}</dd></div></dl>
                <p class="query-criteria"><strong>Resolution criteria</strong> Yes if arrival is over two hours late; No otherwise. Invalid if the criteria cannot produce an answer.</p>
              </div>}
              {index===1 && <div class="report-demo">
                <fieldset class="answer-selection"><legend>Try a report</legend><div class="answer-options">{outcomes.map((answer,i)=><label class="possible-answer"><input class="visually-hidden" type="radio" name="mechanism-answer" value={answer} checked={i===0}/><span>{answer}</span><Icon name="check" /></label>)}</div></fieldset>
                <div class="report-bond"><span>Tentative answer<strong>{outcomes.map(answer=><span class="report-value" data-answer={answer}>{answer}</span>)}</strong></span><Icon name="plus" /><span>Illustrative bond<strong>15 <small>REP</small></strong></span></div>
                <p class="query-caption">The bond stays at risk while the answer can be challenged.</p>
              </div>}
              {index===2 && <div class="challenge-demo">
                <label class="challenge-toggle"><input type="checkbox" name="mechanism-challenge" /><span>Show a challenge</span></label>
                <div class="appeal-flow"><div class="appeal-report"><span>Reported answer</span><strong>{outcomes.map(answer=><span class="report-value" data-answer={answer}>{answer}</span>)}</strong><span>15 REP bond</span></div><Icon name="arrow-right" /><div class="appeal-state"><div class="ordinary-path"><span>Appeal period</span><strong>Open</strong><span>Anyone can challenge</span></div><div class="challenged-path"><span>New tentative answer</span><strong><span class="challenge-if-yes">No</span><span class="challenge-if-other">Yes</span></strong><span>30 REP challenge bond</span></div></div></div>
                <p class="query-caption"><span class="ordinary-path">No challenge is required. If the period closes unchallenged, the reported answer becomes final.</span><span class="challenged-path">A new appeal period opens. This answer can still be challenged.</span></p>
              </div>}
              {index===3 && <div class="application-result">
                <div class="result-handoff"><div class="resolved-value"><span>Augur’s final answer</span><strong><span class="ordinary-path">{outcomes.map(answer=><span class="report-value" data-answer={answer}>{answer}</span>)}</span><span class="challenged-path"><span class="challenge-if-yes">No</span><span class="challenge-if-other">Yes</span></span></strong><span class="final-check"><Icon name="check" />Appeal period closed</span></div><Icon name="arrow-right" /><div class="application-action"><span>The application</span><strong>Applies its<br />payout rules.</strong></div></div>
                <p class="query-caption">The policy determines what to pay, including how to handle an Invalid outcome.</p>
              </div>}
            </div>
          </div>
        </div>)}
      </div>
    </fieldset>
    <div class="mechanism-footer"><p class="journey-instruction"><span class="scroll-instruction">Scroll to follow the query, or select a step.</span><span class="manual-instruction">Select a step to follow the query.</span></p><p>Open roles. Anyone can create a query or become a reporter.</p></div>
    <div class="mechanism-footnote"><p>Illustrative process and bond amounts. REP is Augur’s token.</p><a class="rm-link" href={whitepaperUrl} target="_blank" rel="noopener noreferrer">Read the mechanism<Icon name="arrow-up-right" /></a></div>
  </div>
</section>
<script>
  import { initResolutionJourney } from '../../motion/resolution-journey';
  document.querySelectorAll<HTMLElement>('[data-resolution-journey]').forEach(initResolutionJourney);
</script>
<style>
  .product-mechanism { padding-block:64px 32px; color:var(--foreground); background:var(--background); scroll-margin-top:0; overflow-anchor:none; }
  .mechanism-sticky { padding-block:20px 24px; }
  .product-mechanism[data-scroll-driven] { height:var(--journey-height); padding-block:0; position:relative; }
  [data-scroll-driven] .mechanism-sticky { position:sticky; top:24px; }
  .mechanism-heading { display:flex; align-items:end; justify-content:space-between; gap:48px; }
  .mechanism-heading > p { max-width:43ch; margin:0 0 4px; color:var(--muted-foreground); font-size:16px; line-height:1.65; }
  .mechanism-explorer { min-width:0; padding:0; border:0; margin:32px 0 0; }
  .mechanism-stages { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-top:1px solid var(--web-outline); }
  .mechanism-stage { position:relative; display:flex; align-items:center; gap:16px; min-height:88px; padding:16px; color:var(--muted-foreground); cursor:pointer; }
  .mechanism-stage + .mechanism-stage { border-left:1px solid var(--web-outline); }
  .stage-number { align-self:start; padding-top:4px; font-size:12px; font-variant-numeric:tabular-nums; }
  .stage-label { display:flex; flex-direction:column; gap:8px; }
  .stage-role { font-size:12px; line-height:1.3; }
  .stage-title { font:400 16px/1.4 var(--augur-font-primary); }
  .mechanism-stage > :global(.web-icon) { margin-left:auto; width:16px; height:16px; }
  .mechanism-stage:last-child > :global(.web-icon) { visibility:hidden; }
  .mechanism-stage:has(:checked) { color:var(--foreground); background:var(--card); }
  .mechanism-stage:has(:checked) .stage-role,.mechanism-stage:has(:checked) .stage-number { color:var(--primary); }
  .mechanism-stage:has(:focus-visible) { outline:2px solid var(--foreground); outline-offset:4px; z-index:2; }
  .mechanism-progress { height:3px; background:var(--web-outline); }
  .mechanism-progress > span { display:block; width:25%; height:100%; background:var(--primary); }
  .mechanism-explorer:has([name="product-resolution-stage"][value="2"]:checked) .mechanism-progress > span { transform:translateX(100%); }
  .mechanism-explorer:has([name="product-resolution-stage"][value="3"]:checked) .mechanism-progress > span { transform:translateX(200%); }
  .mechanism-explorer:has([name="product-resolution-stage"][value="4"]:checked) .mechanism-progress > span { transform:translateX(300%); }
  .mechanism-scenes { display:grid; margin-top:32px; }
  .mechanism-scene { grid-area:1/1; display:grid; grid-template-columns:.85fr 1.4fr; align-items:center; gap:clamp(40px,6vw,88px); min-width:0; visibility:hidden; opacity:0; }
  .mechanism-explorer:has([name="product-resolution-stage"][value="1"]:checked) .mechanism-scene:nth-child(1),.mechanism-explorer:has([name="product-resolution-stage"][value="2"]:checked) .mechanism-scene:nth-child(2),.mechanism-explorer:has([name="product-resolution-stage"][value="3"]:checked) .mechanism-scene:nth-child(3),.mechanism-explorer:has([name="product-resolution-stage"][value="4"]:checked) .mechanism-scene:nth-child(4) { display:grid; visibility:visible; opacity:1; }
  .scene-copy h3 { font-size:clamp(26px,2.5vw,36px); font-weight:400; line-height:1.2; letter-spacing:-.025em; margin:0; max-width:20ch; text-wrap:pretty; }
  .scene-copy > p { font-size:16px; line-height:1.65; color:var(--muted-foreground); margin-top:20px; max-width:40ch; }
  .scene-copy .scene-note { font-size:13px; margin-top:24px; color:var(--foreground); }
  .scene-copy .challenge-caution { font-size:13px; margin-top:16px; }
  .scene-copy > a { margin-top:20px; font-size:13px; }
  .mechanism-diagram { min-width:0; background:var(--background); color:var(--foreground); }
  .query-window { padding:26px 30px 22px; min-height:370px; }
  .query-meta { display:flex; justify-content:space-between; gap:20px; font-size:12px; line-height:1.4; color:var(--muted-foreground); }
  .query-status { color:var(--rm-accent); text-align:right; }
  .query-window h4 { font-size:24px; line-height:1.35; letter-spacing:-.025em; font-weight:400; margin:22px 0 0; max-width:29ch; }
  .query-specification dl { margin:20px 0 0; font-size:13px; line-height:1.5; }
  .query-specification dl > div { display:grid; grid-template-columns:132px 1fr; gap:16px; padding-block:10px; border-top:1px solid var(--web-outline); }
  .query-specification dt { color:var(--muted-foreground); }
  .query-specification dd { margin:0; }
  .defined-outcomes { display:flex; gap:20px; }
  .query-criteria { margin-top:14px; font-size:12px; line-height:1.6; color:var(--muted-foreground); }
  .query-criteria strong { font-weight:500; color:var(--foreground); margin-right:6px; }
  .answer-selection { margin:22px 0 0; border:0; padding:0; min-width:0; }
  .answer-selection legend { margin-bottom:10px; color:var(--muted-foreground); font-size:12px; }
  .answer-options { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
  .possible-answer { display:flex; align-items:center; justify-content:space-between; min-height:48px; padding:10px 14px; border:1px solid var(--web-outline); cursor:pointer; font:400 16px/1.3 var(--augur-font-primary); }
  .possible-answer > :global(.web-icon) { width:14px; height:14px; opacity:0; }
  .possible-answer:has(:checked) { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); }
  .possible-answer:has(:checked) > :global(.web-icon) { opacity:1; }
  .possible-answer:has(:focus-visible) { outline:2px solid var(--foreground); outline-offset:4px; }
  .report-bond { display:grid; grid-template-columns:1fr 24px 1fr; align-items:center; gap:24px; padding-block:24px 18px; }
  .report-bond > span { display:flex; flex-direction:column; gap:8px; font-size:12px; color:var(--muted-foreground); }
  .report-bond strong { font:400 32px/1.1 var(--augur-font-primary); letter-spacing:-.03em; color:var(--foreground); }
  .report-bond small { font-size:16px; }
  .report-bond > :global(.web-icon) { width:16px; height:16px; color:var(--muted-foreground); }
  .query-caption { padding-top:16px; border-top:1px solid var(--web-outline); margin:0; font-size:12px; line-height:1.6; color:var(--muted-foreground); }
  .report-value,.challenge-if-other,.challenged-path { display:none; }
  .report-value[data-answer="Yes"] { display:inline; }
  .mechanism-explorer:has([name="mechanism-answer"][value="No"]:checked) .report-value,.mechanism-explorer:has([name="mechanism-answer"][value="Invalid"]:checked) .report-value { display:none; }
  .mechanism-explorer:has([name="mechanism-answer"][value="No"]:checked) .report-value[data-answer="No"],.mechanism-explorer:has([name="mechanism-answer"][value="Invalid"]:checked) .report-value[data-answer="Invalid"] { display:inline; }
  .mechanism-explorer:has([name="mechanism-answer"]:checked:not([value="Yes"])) .challenge-if-yes { display:none; }
  .mechanism-explorer:has([name="mechanism-answer"]:checked:not([value="Yes"])) .challenge-if-other { display:inline; }
  .mechanism-explorer:has([name="mechanism-challenge"]:checked) .ordinary-path { display:none; }
  .mechanism-explorer:has([name="mechanism-challenge"]:checked) .challenged-path { display:block; }
  .challenge-toggle { display:flex; align-items:center; gap:10px; width:fit-content; min-height:44px; margin-top:12px; font-size:13px; cursor:pointer; }
  .challenge-toggle input { width:17px; height:17px; margin:0; accent-color:var(--foreground); cursor:pointer; }
  .appeal-flow { display:grid; grid-template-columns:1fr 24px 1fr; align-items:center; gap:20px; padding-block:12px 22px; }
  .appeal-flow > :global(.web-icon) { width:20px; height:20px; }
  .appeal-report,.appeal-state > div { display:flex; flex-direction:column; gap:8px; }
  .appeal-flow .challenged-path { display:none; }
  .mechanism-explorer:has([name="mechanism-challenge"]:checked) .appeal-flow .challenged-path { display:flex; }
  .appeal-flow span { font-size:12px; line-height:1.4; color:var(--muted-foreground); }
  .appeal-flow strong,.appeal-flow strong > span { font:400 32px/1.15 var(--augur-font-primary); letter-spacing:-.03em; color:var(--foreground); }
  .result-handoff { display:grid; grid-template-columns:1fr 24px 1fr; align-items:center; gap:24px; padding-block:28px; }
  .resolved-value,.application-action { display:flex; flex-direction:column; gap:12px; }
  .result-handoff span { font-size:12px; color:var(--muted-foreground); }
  .resolved-value strong,.resolved-value strong span { font:400 44px/1.1 var(--augur-font-primary); letter-spacing:-.03em; color:var(--rm-accent); }
  .application-action strong { font:400 24px/1.25 var(--augur-font-primary); letter-spacing:-.025em; }
  .result-handoff > :global(.web-icon) { width:22px; height:22px; }
  .final-check { display:flex; align-items:center; gap:6px; }
  .final-check :global(.web-icon) { width:13px; height:13px; color:var(--rm-accent); }
  .mechanism-footer,.mechanism-footnote { display:flex; justify-content:space-between; align-items:center; gap:24px; }
  .mechanism-footer { padding-top:24px; }
  .mechanism-footer p,.mechanism-footnote p { margin:0; color:var(--muted-foreground); font-size:12px; line-height:1.6; }
  .mechanism-footer p:first-child { color:var(--foreground); }
  .mechanism-footnote { margin-top:12px; padding-top:8px; border-top:1px solid var(--web-outline); }
  .mechanism-footnote .rm-link { font-size:12px; }
  .scroll-instruction { display:none; }
  [data-scroll-driven] .scroll-instruction { display:inline; }
  [data-scroll-driven] .manual-instruction { display:none; }
  @media(hover:hover) { .mechanism-stage:hover { color:var(--foreground); } .possible-answer:hover { border-color:var(--foreground); } }
  @media(prefers-reduced-motion:no-preference) { .mechanism-progress > span { transition:transform 450ms var(--rm-ease); } .possible-answer { transition:background-color 180ms,border-color 180ms; } }
  @media(min-width:900px) and (max-height:850px) { .mechanism-heading h2 { font-size:36px; } .mechanism-heading > p { font-size:14px; } .mechanism-explorer { margin-top:24px; } .mechanism-stage { min-height:76px; } .mechanism-scenes { margin-top:24px; } .query-window { min-height:352px; padding-block:20px; } .query-window h4 { margin-top:16px; } .scene-copy h3 { font-size:28px; } .mechanism-footer { padding-top:18px; } }
  @media(max-width:1100px) { .mechanism-stage { padding:14px 10px; gap:10px; } .stage-title { font-size:14px; } .mechanism-stage > :global(.web-icon) { display:none; } .mechanism-heading { gap:36px; } .mechanism-scene { gap:32px; grid-template-columns:.85fr 1.35fr; } .query-window { padding-inline:24px; } .query-window h4 { font-size:22px; } }
  @media(max-width:899px) { .mechanism-heading > p br { display:none; } .mechanism-heading > p { max-width:35ch; } .mechanism-scene { display:none; grid-template-columns:1fr; align-items:start; gap:24px; } .scene-copy { display:grid; grid-template-columns:1fr 1fr; gap:12px 32px; } .scene-copy h3 { grid-row:span 3; font-size:30px; } .scene-copy > p { margin:0; max-width:none; } .scene-copy .scene-note,.scene-copy .challenge-caution,.scene-copy > a { margin:0; grid-column:2; } .query-window { min-height:365px; } }
  @media(max-width:600px) { .product-mechanism { padding-block:36px 24px; } .mechanism-sticky { padding-block:16px; } .mechanism-heading { display:block; } .mechanism-heading > p { margin-top:20px; font-size:15px; max-width:38ch; } .mechanism-explorer { margin-top:28px; } .mechanism-stages { grid-template-columns:repeat(2,minmax(0,1fr)); } .mechanism-stage { min-height:80px; padding:14px 10px; } .mechanism-stage:nth-child(3) { border-left:0; } .mechanism-stage:nth-child(n+3) { border-top:1px solid var(--web-outline); } .stage-role { font-size:11px; } .stage-title { font-size:13px; } .stage-label { gap:6px; } .mechanism-progress { display:none; } .mechanism-stage::after { content:''; position:absolute; bottom:0; left:0; right:0; height:2px; background:transparent; } .mechanism-stage:has(:checked)::after { background:var(--primary); } .mechanism-scenes { margin-top:28px; } .scene-copy { display:block; } .scene-copy h3 { font-size:27px; max-width:21ch; } .scene-copy > p { font-size:15px; margin-top:14px; } .scene-copy .scene-note,.scene-copy .challenge-caution { font-size:12px; margin-top:12px; } .scene-copy > a { margin-top:8px; } .query-window { padding:20px; min-height:390px; } .query-meta { gap:14px; font-size:11px; } .query-window h4 { font-size:21px; margin-top:20px; } .query-specification dl > div { grid-template-columns:96px 1fr; gap:12px; font-size:12px; } .query-criteria { font-size:11px; } .possible-answer { font-size:14px; padding:10px; } .answer-options { gap:8px; } .possible-answer > :global(.web-icon) { width:12px; height:12px; } .report-bond { gap:14px; } .report-bond strong { font-size:28px; } .appeal-flow { gap:12px; } .appeal-flow strong,.appeal-flow strong > span { font-size:28px; } .appeal-flow span { font-size:11px; } .result-handoff { gap:12px; grid-template-columns:1fr 20px 1fr; } .resolved-value strong,.resolved-value strong span { font-size:32px; } .application-action strong { font-size:20px; } .result-handoff span { font-size:11px; } .mechanism-footer { display:block; padding-top:20px; } .mechanism-footer p + p { margin-top:8px; } .mechanism-footnote { align-items:start; } .mechanism-footnote p { max-width:24ch; } .mechanism-footnote a { flex:none; } }
  @media print { .product-mechanism[data-scroll-driven] { height:auto; } .mechanism-sticky { position:static!important; } .mechanism-stages,.mechanism-progress,.journey-instruction { display:none; } .mechanism-scenes { display:block; } .mechanism-scene { visibility:visible; opacity:1; break-inside:avoid; margin-top:32px; } }
</style>
