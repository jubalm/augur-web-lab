---
import Icon from '../site/Icon.astro';
import HeroHeritage from './HeroHeritage.astro';
import { buttonVariants } from '../ui/button-variants';
import { whitepaperUrl } from '../../lib/links';
import productArrival from '../../motion/product-arrival.js?raw';
---
<section class="product-hero" data-theme="dark" data-product-hero aria-labelledby="hero-title">
  <script is:inline set:html={productArrival}></script>
  <HeroHeritage />
  <div class="hero-inner rm-frame">
    <div class="hero-copy">
      <h1 class="augur-type-display" id="hero-title"><span class="hero-word">The</span> <span class="hero-word">frontier</span> <span class="hero-word">of</span> <span class="hero-word hero-emphasis">decentralized</span> <span class="hero-word hero-last-word">truth.</span></h1>
      <p class="hero-definition web-lead">Augur is decentralized oracle infrastructure for establishing truth onchain.<br />Open to anyone. Controlled by no one.</p>
      <div class="hero-actions"><a href="#mechanism" class:list={[buttonVariants(),'configured-button']}>Explore Augur Lituus</a><a href={whitepaperUrl} target="_blank" rel="noopener noreferrer" class="hero-paper">Read the whitepaper <Icon name="arrow-up-right" /></a></div>
    </div>
    <figure class="question-scene" data-question-scene aria-labelledby="scene-caption">
      <div class="question-sheet">
        <div class="question-label"><span class="question-symbol" aria-hidden="true">?</span><span>A question for Augur</span><span class="report-state" data-report-state>Open</span></div>
        <h2 class="augur-type-editorial-section">Was flight AB123 delayed by more than two hours?</h2>
        <p class="reporter-line">Your answer. Your REP behind it.</p>
        <fieldset class="hero-outcomes"><legend class="visually-hidden">Choose your answer</legend>{['Yes','No','Invalid'].map(answer=><label><input type="radio" name="hero-outcome" value={answer}/><span>{answer}</span></label>)}</fieldset>
        <div class="bond-row"><div class="bond-amount"><span class="rep-stack" aria-hidden="true"><i></i><i></i><i></i></span><strong>15 <span>REP</span></strong></div><p>Back your answer.<br />Your bond is at risk.</p></div>
        <button class:list={[buttonVariants(),'configured-button','back-answer']} data-back-answer type="button" hidden disabled>Choose an answer<Icon name="arrow-right" /></button>
        <div class="report-receipt" data-report-receipt hidden><span class="receipt-check"><Icon name="check" /></span><div><strong data-receipt-title></strong><span>Open to challenge by anyone.</span></div><button data-reset-report type="button" aria-label="Try the example again"><Icon name="arrow-right" /></button></div>
        <p class="visually-hidden" data-hero-response aria-live="polite">Choose an answer to back with an illustrative 15 REP bond.</p>
      </div>
      <figcaption id="scene-caption">Try it. No wallet or tokens needed.</figcaption>
    </figure>
    <a class="hero-scroll" href="#principles"><span>Why an open oracle?</span><Icon name="arrow-down" /></a>
  </div>
</section>
<script>
  import { initQuestionHero } from '../../motion/question-hero';
  document.querySelectorAll<HTMLElement>('[data-question-scene]').forEach(initQuestionHero);
</script>
<style>
  .product-hero { position:relative; isolation:isolate; color:var(--foreground); background:var(--background); }
  .hero-inner { position:relative; z-index:1; min-height:calc(100svh - 104px); display:grid; grid-template-columns:1.05fr 1fr; align-items:center; gap:24px clamp(40px,5vw,80px); padding-block:40px 28px; }
  .hero-copy { padding-bottom:12px; }
  h1 { max-width:11.5ch; font-size:clamp(50px,5.1vw,78px); font-weight:600; line-height:1.09; letter-spacing:-.04em; }
  .hero-word { display:inline-block; }
  .hero-emphasis { position:relative; display:inline-block; color:var(--primary); isolation:isolate; }
  .hero-emphasis::before { content:''; position:absolute; z-index:-1; inset:auto -.035em -.035em; height:.055em; background:var(--primary); transform:scaleX(0); transform-origin:left; }
  .hero-definition { max-width:36ch; margin-top:28px; color:var(--muted-foreground); }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:20px; margin-top:32px; }
  .hero-paper { display:inline-flex; align-items:center; gap:8px; min-height:48px; font:600 14px/1.5 var(--augur-font-primary); text-decoration:none; }
  .hero-paper:hover { text-decoration:underline; text-underline-offset:6px; }
  .hero-paper :global(.web-icon) { width:16px; height:16px; }
  .question-scene { --pointer-x:0; --pointer-y:0; position:relative; isolation:isolate; margin:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:40px 24px 12px; }
  .question-sheet { width:100%; max-width:500px; padding:26px; background:var(--card); border:1px solid var(--web-outline); transform:perspective(1100px) rotateX(calc(var(--pointer-y) * -1.5deg)) rotateY(calc(var(--pointer-x) * 1.5deg)) translate(calc(var(--pointer-x) * 5px),calc(var(--pointer-y) * 5px)); }
  .question-label { display:flex; align-items:center; gap:10px; font-size:12px; color:var(--muted-foreground); }
  .question-symbol { display:grid; place-items:center; width:26px; height:26px; background:var(--primary); color:var(--primary-foreground); font:600 18px var(--augur-font-primary); }
  .report-state { margin-left:auto; color:var(--primary); font-size:11px; }
  .question-sheet h2 { margin-top:22px; font-size:clamp(25px,2.15vw,31px); line-height:1.3; letter-spacing:-.025em; text-wrap:balance; }
  .reporter-line { margin-block:28px 14px; font-size:14px; line-height:1.5; color:var(--muted-foreground); }
  .hero-outcomes { display:grid; grid-template-columns:repeat(3,1fr); border:0; margin:0; padding:0; gap:10px; }
  .hero-outcomes label { position:relative; cursor:pointer; }
  .hero-outcomes input { position:absolute; width:1px; height:1px; opacity:0; }
  .hero-outcomes label > span { display:grid; place-items:center; min-height:48px; border:1px solid var(--muted-foreground); font:400 16px var(--augur-font-primary); }
  .hero-outcomes :checked + span { background:var(--primary); border-color:var(--primary); color:var(--primary-foreground); }
  .hero-outcomes label:hover > span { border-color:var(--primary); }
  .hero-outcomes :focus-visible + span { outline:2px solid var(--foreground); outline-offset:4px; }
  .hero-outcomes input:disabled + span { cursor:default; }
  .bond-row { display:flex; align-items:center; justify-content:space-between; gap:20px; padding-block:22px; margin-top:22px; border-top:1px solid var(--web-outline); }
  .bond-amount { display:flex; align-items:center; gap:14px; }
  .bond-amount strong { font:400 30px/1.2 var(--augur-font-primary); letter-spacing:-.025em; }
  .bond-amount strong span { font-size:16px; }
  .bond-row > p { font-size:11px; line-height:1.6; color:var(--muted-foreground); }
  .rep-stack { position:relative; width:32px; height:38px; flex:none; }
  .rep-stack i { position:absolute; width:23px; height:25px; border:1px solid var(--primary); background:var(--card); }
  .rep-stack i:nth-child(2) { top:5px; left:4px; }
  .rep-stack i:nth-child(3) { top:10px; left:8px; background:var(--primary); }
  .back-answer { display:flex; justify-content:space-between; width:100%; }
  .back-answer :global(.web-icon) { width:18px; height:18px; }
  .back-answer:disabled { color:var(--muted-foreground); background:var(--muted); border:1px solid var(--web-outline); cursor:default; }
  .report-receipt { display:flex; align-items:center; gap:12px; min-height:58px; padding:10px 12px; border:1px solid var(--primary); }
  .receipt-check { color:var(--primary); }
  .receipt-check :global(.web-icon) { width:20px; height:20px; }
  .report-receipt > div { display:flex; flex-direction:column; gap:5px; }
  .report-receipt strong { font:400 15px var(--augur-font-primary); }
  .report-receipt > div > span { color:var(--muted-foreground); font-size:11px; }
  .report-receipt button { display:grid; place-items:center; margin-left:auto; width:36px; height:36px; flex:none; color:var(--foreground); background:none; border:0; cursor:pointer; }
  .report-receipt button :global(.web-icon) { width:18px; height:18px; transform:rotate(180deg); }
  figcaption { margin-top:16px; color:var(--muted-foreground); font-size:11px; line-height:1.5; text-align:center; }
  .hero-scroll { display:flex; gap:14px; align-items:center; grid-column:1/-1; justify-self:start; min-height:40px; text-decoration:none; font-size:12px; color:var(--muted-foreground); }
  .hero-scroll :global(.web-icon) { width:15px; height:15px; color:var(--primary); }
  .hero-scroll:hover { color:var(--foreground); }
  /* Opted in before first paint; backwards fill always returns to the visible base. */
  @media(prefers-reduced-motion:no-preference) {
    [data-product-arrival="entering"] .hero-word { animation:hero-word-arrival 720ms var(--rm-ease) backwards; }
    [data-product-arrival="entering"] .hero-emphasis { animation-delay:110ms; }
    [data-product-arrival="entering"] .hero-last-word { animation-delay:220ms; }
    [data-product-arrival="entering"] .hero-emphasis::before { animation:highlight-wipe 1400ms var(--rm-ease) 240ms backwards; }
    [data-product-arrival="entering"] .hero-definition { animation:hero-support-arrival 620ms var(--rm-ease) 280ms backwards; }
    [data-product-arrival="entering"] .hero-actions { animation:hero-support-arrival 560ms var(--rm-ease) 410ms backwards; }
    [data-product-arrival="entering"] .question-scene { animation:hero-sheet-arrival 840ms var(--rm-ease) 180ms backwards; }
    [data-product-arrival="entering"] .question-label { animation:hero-detail-arrival 460ms var(--rm-ease) 420ms backwards; }
    [data-product-arrival="entering"] .question-sheet h2 { animation:hero-detail-arrival 560ms var(--rm-ease) 500ms backwards; }
    [data-product-arrival="entering"] .reporter-line { animation:hero-detail-arrival 460ms var(--rm-ease) 580ms backwards; }
    [data-product-arrival="entering"] .hero-outcomes label { animation:hero-detail-arrival 440ms var(--rm-ease) 620ms backwards; }
    [data-product-arrival="entering"] .hero-outcomes label:nth-of-type(2) { animation-delay:685ms; }
    [data-product-arrival="entering"] .hero-outcomes label:nth-of-type(3) { animation-delay:750ms; }
    [data-product-arrival="entering"] .bond-row { animation:hero-detail-arrival 480ms var(--rm-ease) 780ms backwards; }
    [data-product-arrival="entering"] .rep-stack i { animation:hero-bond-arrival 500ms var(--rm-ease) 850ms backwards; }
    [data-product-arrival="entering"] .rep-stack i:nth-child(2) { animation-delay:915ms; }
    [data-product-arrival="entering"] .rep-stack i:nth-child(3) { animation-delay:980ms; }
    [data-product-arrival="entering"] .back-answer { animation:hero-detail-arrival 440ms var(--rm-ease) 900ms backwards; }
    [data-product-arrival="entering"] figcaption { animation:hero-support-arrival 440ms var(--rm-ease) 980ms backwards; }
    [data-product-arrival="entering"] .hero-scroll { animation:hero-support-arrival 500ms var(--rm-ease) 1040ms backwards; }
    [data-product-arrival="entering"] .hero-scroll :global(.web-icon) { animation:hero-scroll-cue 760ms var(--rm-ease) 1200ms backwards; }
  }
  @keyframes hero-word-arrival { from { opacity:0; transform:translateY(.5em); } to { opacity:1; transform:translateY(0); } }
  @keyframes hero-support-arrival { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
  @keyframes hero-sheet-arrival { from { opacity:0; transform:translate(26px,32px) rotate(1.25deg); } to { opacity:1; transform:translate(0,0) rotate(0); } }
  @keyframes hero-detail-arrival { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
  @keyframes hero-bond-arrival { from { transform:translate(-7px,-18px); } to { transform:translate(0,0); } }
  @keyframes hero-scroll-cue { 0%,100% { transform:translateY(0); } 45% { transform:translateY(7px); } }
  @keyframes highlight-wipe { 0% { transform:scaleX(0); } 25%,70% { transform:scaleX(1); } 100% { transform:scaleX(0); transform-origin:right; } }
  @media(prefers-reduced-motion:no-preference) { .hero-outcomes label > span { transition:background-color 180ms,border-color 180ms; } .question-scene:not([data-tracking]) .question-sheet { transition:transform 400ms var(--rm-ease); } }
  @media(max-width:1100px) { .hero-inner { gap:24px 32px; } h1 { font-size:56px; } .hero-definition { font-size:16px; } .question-scene { padding-inline:8px; } .question-sheet { padding:22px; } .question-sheet h2 { font-size:26px; } .back-answer { font-size:14px; } }
  @media(max-width:900px) { .hero-inner { grid-template-columns:1fr; padding-top:40px; gap:24px; } .hero-copy { display:grid; grid-template-columns:1.2fr 1fr; column-gap:40px; } h1 { font-size:clamp(48px,6.7vw,64px); grid-row:span 3; } .hero-definition { margin-top:14px; } .hero-actions { grid-column:2; margin-top:24px; gap:6px; } .question-scene { width:min(570px,100%); margin-inline:auto; padding:24px 30px 8px; } .question-sheet h2 { font-size:30px; } }
  @media(max-width:600px) { .hero-inner { padding-top:28px; } .hero-copy { display:block; } h1 { font-size:clamp(40px,10vw,60px); max-width:12ch; } .hero-definition { font-size:16px; line-height:1.6; } .hero-actions { margin-top:24px; gap:4px 16px; } .hero-paper { font-size:13px; } .question-scene { padding:24px 0 8px; } .question-sheet { padding:20px; } .question-sheet h2 { font-size:25px; } .bond-row { gap:12px; } .bond-amount { gap:10px; } .bond-amount strong { font-size:27px; } .back-answer { font-size:14px; } }
  @media(prefers-reduced-motion:reduce) { .question-sheet { transform:none; } }
</style>
