---
import Icon from '../site/Icon.astro';
import { whitepaperUrl } from '../../lib/links';
// Calendar quarters from dated primary sources. Completed artifacts are distinct
// from ongoing research; the completed Moon Fork belongs to Augur v2.
const missionUrl = 'https://www.augur.net/mission/';
const developmentUrl = 'https://www.augur.net/blog/augur-testing-past-building-future/';
const completed = [
  { quarter:'Q1 2025', title:'Foundation reset', detail:'The Lituus Foundation begins the Augur reboot on March 31, 2025.', href:missionUrl, link:'Read the mission' },
  { quarter:'Q2 2025', title:'Oracle proposal published', detail:'The May proposal sets out a generalized oracle beyond prediction markets. Further security research follows.', href:missionUrl, link:'Explore the research' },
  { quarter:'Q1 2026', title:'Whitepaper published', detail:'The Augur Lituus mechanism and security analysis are published on January 29, 2026.', href:whitepaperUrl, link:'Read the whitepaper' },
  { quarter:'Q2–Q3 2026', title:'Augur v2 Moon Fork complete', detail:'From April’s escalation to REP migration, the live Augur v2 fork completes on August 3. This is separate from the Augur Lituus launch.', href:'https://www.augur.net/blog/post-fork-announcements/', link:'Read the fork report' },
];
---
<section id="roadmap" class="product-roadmap" aria-labelledby="roadmap-title">
  <div class="rm-frame">
    <div class="roadmap-heading" data-reveal-group>
      <h2 id="roadmap-title" data-reveal="heading" class="augur-type-display rm-section-title">The road to launch.</h2>
      <a class="rm-link" href={missionUrl} target="_blank" rel="noopener noreferrer">The full story<Icon name="arrow-up-right" /></a>
    </div>
    <div class="roadmap-board">
      <div class="roadmap-completed" data-reveal="fade" data-roadmap-reveal="completed">
        <h3 class="roadmap-group-title"><span class="group-mark complete-mark" aria-hidden="true"><Icon name="check" /></span>Completed</h3>
        <ol class="completed-list">
          {completed.map(item=><li><details class="completed-item"><summary><span class="completion-check" aria-hidden="true"><Icon name="check" /></span><span class="completed-label"><span class="completed-quarter">{item.quarter}</span><span class="completed-name">{item.title}</span></span><Icon name="plus" /></summary><div class="completed-detail"><p>{item.detail}</p><a href={item.href} target="_blank" rel="noopener noreferrer">{item.link}<Icon name="arrow-up-right" /></a></div></details></li>)}
        </ol>
        <p class="history-hint">Open a milestone for the details.</p>
      </div>
      <div class="roadmap-forward">
        <article class="roadmap-current" data-reveal="panel" data-theme="dark" data-roadmap-reveal="current" aria-labelledby="current-phase-title">
          <span class="current-trace" data-roadmap-trace aria-hidden="true"></span>
          <div class="current-meta"><p class="current-status"><span aria-hidden="true"></span>Building now</p><p class="current-quarter">Q3 <span>2026</span></p></div>
          <div class="current-content"><h3 id="current-phase-title" class="augur-type-display">From the paper.<br />Into the protocol.</h3><p>ChainSafe is building Augur Lituus.<br />The Foundation reviews the implementation against the whitepaper.</p></div>
          <div class="current-links"><a href="https://github.com/AugurProject/Lituus-CS" target="_blank" rel="noopener noreferrer">Follow the build<Icon name="arrow-up-right" /></a><a href={developmentUrl} target="_blank" rel="noopener noreferrer">Development update<Icon name="arrow-up-right" /></a></div>
        </article>
        <div class="roadmap-next" data-roadmap-reveal="next">
          <div class="next-heading"><h3 class="roadmap-group-title"><span class="group-mark upcoming-mark" aria-hidden="true"></span>Up next</h3><p>Dates to be announced</p></div>
          <ol class="next-stages" data-reveal-group>
            <li><span class="next-track" aria-hidden="true"><i data-roadmap-trace></i><span></span></span><h4 class="augur-type-editorial-section">Testing &amp; audits</h4><p>Validate the implementation<br /> before application use.</p></li>
            <li><span class="next-track" aria-hidden="true"><i data-roadmap-trace></i><span></span></span><h4 class="augur-type-editorial-section">Launch Augur Lituus</h4><p>Builder documentation.<br /> A resolution layer for applications.</p></li>
          </ol>
        </div>
      </div>
    </div>
    <p class="roadmap-note">Calendar quarters. Augur Lituus is in development; no launch date has been announced.</p>
  </div>
</section>
<script>
  import { initRoadmap } from '../../motion/product-roadmap';
  initRoadmap();
</script>
<style>
  .product-roadmap { padding-block:88px 64px; background:var(--background); color:var(--foreground); }
  .roadmap-heading { display:flex; justify-content:space-between; align-items:end; gap:32px; margin-bottom:44px; }
  .roadmap-heading > a { flex:none; }
  .roadmap-board { display:grid; grid-template-columns:minmax(250px,.85fr) minmax(0,1.65fr); gap:clamp(40px,5vw,80px); }
  .roadmap-group-title { display:flex; align-items:center; gap:10px; font:400 17px/1.5 var(--augur-font-primary); margin:0; }
  .group-mark { display:grid; place-items:center; flex:none; width:18px; height:18px; }
  .complete-mark { color:var(--muted-foreground); border:1px solid var(--web-outline); }
  .complete-mark :global(.web-icon) { width:12px; height:12px; }
  .roadmap-completed { padding-top:6px; }
  .roadmap-completed > h3 { color:var(--muted-foreground); margin-bottom:26px; }
  .completed-list { padding:0; margin:0; list-style:none; border-top:1px solid var(--web-outline); }
  .completed-list > li { border-bottom:1px solid var(--web-outline); }
  .completed-item summary { display:grid; grid-template-columns:18px minmax(0,1fr) 14px; align-items:center; gap:12px; min-height:98px; padding-block:20px; cursor:pointer; list-style:none; }
  .completed-item summary::-webkit-details-marker { display:none; }
  .completion-check { color:var(--muted-foreground); }
  .completion-check :global(.web-icon) { width:16px; height:16px; }
  .completed-label { display:flex; flex-direction:column; align-items:start; gap:8px; }
  .completed-quarter { font-size:12px; line-height:1.4; color:var(--muted-foreground); font-variant-numeric:tabular-nums; }
  .completed-name { color:var(--muted-foreground); font:400 18px/1.5 var(--augur-font-primary); text-decoration:line-through; text-decoration-thickness:1px; text-decoration-color:currentColor; }
  .completed-item summary > :global(.web-icon) { width:14px; height:14px; color:var(--muted-foreground); }
  .completed-item[open] summary > :global(.web-icon) { transform:rotate(45deg); }
  .completed-item summary:hover .completed-name,.completed-item[open] .completed-name { color:var(--foreground); }
  .completed-detail { padding:8px 26px 24px 30px; }
  .completed-detail p { margin:0; font-size:14px; line-height:1.6; color:var(--muted-foreground); }
  .completed-detail a { display:inline-flex; align-items:center; gap:6px; min-height:40px; margin-top:8px; font-size:13px; text-underline-offset:4px; }
  .completed-detail :global(.web-icon) { width:13px; height:13px; }
  .history-hint { margin-top:16px; color:var(--muted-foreground); font-size:12px; line-height:1.5; }
  .roadmap-current { position:relative; overflow:hidden; padding:30px 36px 24px; color:var(--foreground); background:var(--background); }
  .current-trace { position:absolute; inset:0 0 auto; height:3px; background:var(--primary); transform-origin:left; }
  .current-meta { display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .current-status { display:flex; align-items:center; gap:10px; font:400 14px/1.5 var(--augur-font-primary); color:var(--primary); margin:0; }
  .current-status > span { width:8px; height:8px; background:var(--primary); flex:none; }
  .current-quarter { font:400 22px/1.2 var(--augur-font-primary); margin:0; }
  .current-quarter > span { color:var(--muted-foreground); font-size:14px; margin-left:5px; }
  .current-content { padding-block:32px; }
  .current-content h3 { font-size:clamp(32px,3vw,44px); font-weight:400; line-height:1.15; letter-spacing:-.03em; margin:0; }
  .current-content p { margin-top:20px; color:var(--muted-foreground); font-size:16px; line-height:1.6; max-width:48ch; }
  .current-links { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px 24px; padding-top:18px; border-top:1px solid var(--web-outline); }
  .current-links a { display:inline-flex; align-items:center; gap:8px; min-height:40px; font-size:13px; text-decoration:none; }
  .current-links a:first-child { color:var(--primary); }
  .current-links a:last-child { color:var(--muted-foreground); }
  .current-links a:hover { text-decoration:underline; text-underline-offset:5px; }
  .current-links :global(.web-icon) { width:15px; height:15px; }
  .roadmap-next { padding-top:30px; }
  .next-heading { display:flex; justify-content:space-between; align-items:center; gap:20px; }
  .upcoming-mark { width:12px; height:12px; border:1px solid var(--foreground); margin-inline:3px; }
  .next-heading > p { margin:0; color:var(--muted-foreground); font-size:12px; line-height:1.5; }
  .next-stages { display:grid; grid-template-columns:1fr 1fr; gap:28px; margin:24px 0 0; padding:0; list-style:none; }
  .next-stages li { min-width:0; }
  .next-track { display:block; position:relative; height:12px; margin-bottom:16px; }
  .next-track > i { position:absolute; inset:5px 0 auto 0; border-top:1px dashed var(--muted-foreground); transform-origin:left; }
  .next-track > span { display:block; position:relative; width:11px; height:11px; background:var(--background); border:1px solid var(--muted-foreground); }
  .next-stages h4 { margin:0; font-size:22px; font-weight:400; line-height:1.3; letter-spacing:-.02em; }
  .next-stages p { margin-top:10px; font-size:14px; line-height:1.6; color:var(--muted-foreground); }
  .roadmap-note { margin-top:32px; padding-top:18px; border-top:1px solid var(--web-outline); color:var(--muted-foreground); font-size:12px; line-height:1.6; }
  @media(prefers-reduced-motion:no-preference) { .completed-item summary > :global(.web-icon) { transition:transform 200ms var(--rm-ease); } .completed-name { transition:color 180ms; } .current-links :global(.web-icon) { transition:transform 180ms var(--rm-ease); } .current-links a:hover :global(.web-icon) { transform:translate(2px,-2px); } }
  @media(max-width:1100px) { .roadmap-board { grid-template-columns:minmax(240px,.9fr) minmax(0,1.5fr); gap:36px; } .roadmap-current { padding:26px 28px 22px; } .current-content h3 { font-size:36px; } .completed-name { font-size:16px; } .next-stages h4 { font-size:20px; } }
  @media(max-width:850px) { .roadmap-board { grid-template-columns:1fr; gap:36px; } .roadmap-completed { display:grid; grid-template-columns:150px 1fr; gap:0 24px; } .roadmap-completed > h3 { align-self:start; margin-top:18px; } .history-hint { grid-column:2; } .completed-item summary { min-height:80px; padding-block:16px; } .completed-name { font-size:17px; } }
  @media(max-width:540px) { .product-roadmap { padding-block:56px 40px; } .roadmap-heading { align-items:start; flex-direction:column; gap:12px; margin-bottom:28px; } .roadmap-board { gap:32px; } .roadmap-completed { display:block; } .roadmap-completed > h3 { margin:0 0 18px; } .completed-item summary { min-height:82px; gap:10px; } .completed-label { gap:5px; } .completed-quarter { font-size:11px; } .completed-name { font-size:16px; } .history-hint { margin-top:12px; } .roadmap-current { padding:24px; } .current-status { font-size:12px; gap:8px; } .current-quarter { font-size:20px; } .current-quarter > span { font-size:12px; } .current-content { padding-block:28px; } .current-content h3 { font-size:32px; } .current-content p { font-size:15px; } .current-links { gap:4px; } .current-links a { font-size:12px; } .roadmap-next { padding-top:26px; } .next-heading { align-items:start; } .next-heading > p { max-width:13ch; text-align:right; } .next-stages { grid-template-columns:1fr; gap:24px; } .next-stages li { position:relative; padding-left:28px; } .next-track { position:absolute; left:0; top:5px; bottom:-28px; width:11px; height:auto; margin:0; } .next-track > i { top:0; bottom:0; left:5px; right:auto; border-top:0; border-left:1px dashed var(--muted-foreground); transform-origin:top; } .next-stages li:last-child .next-track > i { display:none; } .next-stages p { margin-top:8px; } .next-stages p br { display:none; } .roadmap-note { margin-top:28px; font-size:11px; } }
  @media(forced-colors:active) { .current-trace,.current-status > span { background:Highlight; forced-color-adjust:none; } }
</style>
