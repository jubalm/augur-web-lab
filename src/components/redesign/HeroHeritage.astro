---
// The incomplete 40-unit grid and tiny squares recall the original Augur homepage.
// The center stays quiet; this is a static, build-time decoration by default.
const field = { width:1600, height:900 };
let seed = 2020;
const random = () => { seed=(Math.imul(seed,1664525)+1013904223)>>>0; return seed/0x100000000; };
const squares = Array.from({length:40*23},(_,index)=>{
  const x=20+(index%40)*40, y=10+Math.floor(index/40)*40;
  const edge=Math.max(Math.pow(Math.abs(y/field.height-.5)*2,4),Math.pow(Math.abs(x/field.width-.5)*2,14)*.6);
  const present=random()<.38, accent=random()<.28, strength=.55+random()*.45;
  return {x,y,accent,opacity:Number((edge*strength*(accent?.58:.32)).toFixed(3)),present:present&&edge>.2};
}).filter(square=>square.present);
---
<svg class="hero-heritage" data-hero-heritage viewBox={`0 0 ${field.width} ${field.height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="heritage-proximity-falloff"><stop offset="0" stop-color="white"/><stop offset=".35" stop-color="white" stop-opacity=".8"/><stop offset="1" stop-color="white" stop-opacity="0"/></radialGradient>
    <mask id="heritage-proximity-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={field.width} height={field.height}><circle data-heritage-radius cx="-1000" cy="-1000" r="180" fill="url(#heritage-proximity-falloff)"/></mask>
  </defs>
  <g class="heritage-base" data-heritage-base>{squares.map(square=><rect x={square.x} y={square.y} width="3" height="3" fill={square.accent?'var(--primary)':'var(--foreground)'} opacity={square.opacity}/>)}</g>
  <g class="heritage-proximity" mask="url(#heritage-proximity-mask)">{squares.map(square=><rect x={square.x} y={square.y} width="3" height="3" fill="var(--primary)" opacity=".78"/>)}</g>
</svg>
<script>
  import { initHeroHeritage } from '../../motion/hero-heritage';
  document.querySelectorAll<SVGSVGElement>('[data-hero-heritage]').forEach(initHeroHeritage);
</script>
<style>
  .hero-heritage { position:absolute; inset:0; width:100%; height:100%; overflow:hidden; pointer-events:none; z-index:0; }
  .heritage-proximity { opacity:0; }
  [data-pointer-active] .heritage-proximity { opacity:1; }
  @media(prefers-reduced-motion:no-preference) { .heritage-proximity { transition:opacity 220ms ease-out; } }
  @media(max-width:700px) { .heritage-base { opacity:.7; } }
  @media(prefers-reduced-motion:reduce) { .heritage-proximity { display:none; } }
  @media(forced-colors:active) { .hero-heritage { display:none; } }
</style>
