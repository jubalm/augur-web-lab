---
// Shared frame for the redesign sections: hairline-separated, wide gutters, and a
// heading block that can pair a title with a lead. Unlike the current homepage's fixed
// label-above-heading chassis, each section owns its composition below the heading.
interface Props { id: string; dark?: boolean; }
const { id, dark = false } = Astro.props;
const titleId = `${id}-title`;
---
<section id={id} class:list={['rm-section', { dark }]} aria-labelledby={titleId}>
  <div class="rm-frame">
    <div class="rm-heading" data-reveal-children>
      <h2 id={titleId} class="augur-type-display"><slot name="title" /></h2>
      {Astro.slots.has('aside') && <div class="rm-aside augur-type-body web-lead"><slot name="aside" /></div>}
    </div>
    <slot />
  </div>
</section>

<style>
  .rm-section { padding-block: 120px; background: var(--background); color: var(--foreground); border-top: 1px solid var(--border-quiet); scroll-margin-top: 24px; text-wrap: pretty; }
  .rm-section.dark { background: var(--augur-color-primary); color: var(--augur-color-neutral); border-top-color: transparent; }
  .rm-frame { width: min(1472px, calc(100% - 112px)); margin-inline: auto; }
  .rm-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px 80px; align-items: end; margin-bottom: 72px; }
  h2 { font-size: clamp(34px, 3.2vw, 48px); line-height: 1.1; letter-spacing: -.035em; }
  .rm-aside { max-width: 500px; color: var(--muted-foreground); }
  .rm-aside :global(p + p) { margin-top: 12px; }
  @media (max-width: 1100px) { .rm-frame { width: calc(100% - 80px); } .rm-heading { gap: 24px 40px; } }
  @media (max-width: 760px) {
    .rm-section { padding-block: 88px; }
    .rm-frame { width: calc(100% - 40px); }
    .rm-heading { grid-template-columns: 1fr; margin-bottom: 48px; }
  }
</style>
