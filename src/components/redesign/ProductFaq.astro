---
import Icon from '../site/Icon.astro';
import { whitepaperUrl } from '../../lib/links';
const questions = [
  { question:'What can Augur resolve?', answer:'Questions about real-world events, with clear criteria and a defined set of possible answers. Election results, flight delays and completed deliverables are examples. Invalid covers malformed or unresolvable questions.' },
  { question:'Who can participate?', answer:'Anyone can ask a question with a query fee, report an answer with a REP bond, or challenge an answer with a larger bond. No invitation or committee seat is required.' },
  { question:'Why put REP behind an answer?', answer:'A bond makes a report an economic commitment. If your answer loses, your bond can be lost; losing bonds help reward participants who backed the final answer.' },
  { question:'Who decides the final answer?', answer:'Protocol rules, not a committee or central veto. An answer becomes final after an appeal period with no completed challenge. At the fork threshold, REP holders choose between outcome universes. The system depends on economic incentives and participation.' },
  { question:'How is Augur Lituus different from earlier Augur?', answer:'Earlier Augur combined prediction markets with an oracle. Augur Lituus makes that resolution layer available to a wider range of applications. The roadmap above tracks its development toward launch.' },
];
---
<section id="faq" class="product-faq rm-frame" aria-labelledby="faq-title">
  <div class="faq-heading" data-reveal="heading"><h2 id="faq-title" class="augur-type-display rm-section-title">A few good<br />questions.</h2><a class="rm-link" href={whitepaperUrl} target="_blank" rel="noopener noreferrer">Go deeper<Icon name="arrow-up-right" /></a></div>
  <div class="faq-answers" data-reveal-group>{questions.map(item=><details name="product-faq"><summary class="augur-type-ui"><span>{item.question}</span><Icon name="plus" /></summary><p class="faq-answer rm-body-small">{item.answer}</p></details>)}</div>
</section>
<style>
  .product-faq { display:grid; grid-template-columns:.8fr 1.4fr; gap:clamp(48px,8vw,120px); padding-block:64px 72px; border-top:1px solid var(--web-outline); }
  .faq-heading a { margin-top:20px; }
  .faq-answers { border-bottom:1px solid var(--border-quiet); }
  details { border-top:1px solid var(--border-quiet); }
  summary { display:flex; align-items:center; justify-content:space-between; gap:24px; padding-block:19px; min-height:64px; list-style:none; cursor:pointer; font-size:15px; line-height:1.5; }
  summary::-webkit-details-marker { display:none; }
  summary :global(.web-icon) { width:16px; height:16px; flex:none; }
  summary:hover > span:first-child { color:var(--rm-accent); }
  summary:focus-visible { outline:2px solid var(--foreground); outline-offset:5px; }
  details[open] summary :global(.web-icon) { transform:rotate(45deg); }
  .faq-answer { max-width:62ch; padding:0 32px 24px 0; color:var(--muted-foreground); }
  @media(prefers-reduced-motion:no-preference) { summary :global(.web-icon) { transition:transform var(--rm-motion-fast) var(--rm-ease); } }
  @media(max-width:760px) { .product-faq { grid-template-columns:1fr; padding-block:48px 56px; gap:24px; } .faq-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; } .faq-heading h2 { font-size:32px; } .faq-heading a { margin:0; flex:none; } summary { min-height:66px; } }
</style>
