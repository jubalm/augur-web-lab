---
import { applications } from '../../data/applications';
import Icon from '../primitives/Icon.astro';
---
<section class="applications section" aria-labelledby="applications-heading">
 <div class="container">
  <div class="section-heading"><h2 id="applications-heading">What could you build?</h2><p class="lead">Augur Lituus answers real-world questions.<br/>Your app decides what happens next.</p></div>
  <div class="application-picker" data-tabs data-applications data-activation="manual" data-active="0">
   <div class="application-cards" role="tablist" aria-label="Possible applications">
    {applications.map((app,i)=><button type="button" role="tab" id={`application-tab-${app.id}`} aria-controls={`application-panel-${app.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} class="application-tab"><span class="app-icon" aria-hidden="true"><Icon name={app.icon}/></span><span class="app-name">{app.title}</span><span class="app-question">“{app.question}”</span><span class="app-plus" aria-hidden="true">+</span></button>)}
   </div>
   <div class="application-panels">
    {applications.map((app,i)=><div role="tabpanel" id={`application-panel-${app.id}`} aria-labelledby={`application-tab-${app.id}`} class="application-panel" tabindex="0" hidden={i!==0} style={`grid-column:${i+1}`}>
     <div class="app-story"><h3>{app.action}</h3><p>“{app.question}”</p><p class="app-explanation">{app.explanation}</p></div>
     <div class="app-result">{i===0?<fieldset class="market-result" data-market-result><legend class="result-label">{app.result}</legend><div class="market-outcomes"><span class="market-highlight" aria-hidden="true"></span>{['Yes','No'].map((label,index)=><label class="market-option"><input type="radio" name="market-result" value={label.toLowerCase()} checked={index===0}/><span>{label}</span><Icon name="check"/></label>)}</div></fieldset>:<p class="result-label">{app.result}</p>}
      {i===1&&<><div class="flight-summary"><span><Icon name="airplane-tilt"/>AB123</span><span>More than<br/>two hours late</span></div><div class="flight-scale"><svg viewBox="0 0 296 20" width="296" height="20" preserveAspectRatio="none" aria-hidden="true"><path d="M0 9H296" stroke="var(--mark-past)"/><path d="M0 9H258M.5 5V14M189 5V14" stroke="var(--foreground)"/><rect x="251" y="3" width="14" height="14" fill="var(--primary)"/></svg><div class="flight-labels"><span>Scheduled arrival</span><span>+2 hours</span></div></div></>}
      {i===2&&<><div class="grant-summary"><span>Published.</span><span>On time</span><div class="grant-document" aria-hidden="true"><span></span><span></span></div></div><p class="grant-caption"><Icon name="check"/>Grant requirement met</p></>}
     </div>
    </div>)}
   </div>
   <div class="application-connectors" aria-hidden="true">{applications.map((_,i)=><div class="app-connector" data-connector={i}><span class="app-signal"></span></div>)}</div>
   <div class="application-backstop"><h3>Augur Lituus</h3><div><h4>One backstop for every app.</h4><p>Apps could run on their own chain or L2 and turn to Augur Lituus when an answer is disputed.</p></div></div>
  </div>
 </div>
</section>
<script>import {initHomeInteractions} from '../../motion/home-interactions';initHomeInteractions();</script>
<style>
 .flight-summary{display:flex;align-items:center;justify-content:space-between;gap:16px}.flight-summary>span:first-child,.grant-summary>span:first-child{font:400 34px/40px var(--font-heading);letter-spacing:-.03em}.flight-summary>span:first-child{display:flex;align-items:center;gap:12px}.flight-summary>span:first-child :global(.web-icon),.flight-summary>span:first-child :global(svg){width:24px;height:24px;color:var(--muted-foreground)}.flight-summary>span:last-child{font-size:13px;line-height:19px;text-align:right}.flight-scale{padding-top:10px;margin-top:14px}.flight-scale svg{display:block;width:100%;height:20px}.flight-labels{position:relative;height:18px;margin-top:8px;font-size:12px;line-height:18px;color:var(--muted-foreground)}.flight-labels>span:last-child{position:absolute;left:55.743%;top:0}.grant-summary{display:flex;flex-direction:column;align-items:flex-start;gap:2px}.grant-summary>span:last-of-type{font-size:14px;line-height:20px;color:var(--muted-foreground)}.grant-document{display:flex;flex-direction:column;gap:7px;padding-top:12px;width:100%}.grant-document>span{display:block;height:1px;width:71.946%;background:var(--mark-past)}.grant-document>span+span{width:46.959%}.grant-caption{display:flex;align-items:center;gap:10px;background:var(--primary);color:var(--background);padding:11px 12px;font-size:14px;line-height:20px;margin:14px 0 0}.grant-caption :global(.web-icon),.grant-caption :global(svg){width:16px;height:16px}
 .applications{padding-block:72px}.section-heading{margin-bottom:48px}.application-picker{--columns:minmax(0,776fr) minmax(0,220fr) minmax(0,220fr);position:relative}.application-picker[data-active="1"]{--columns:minmax(0,220fr) minmax(0,776fr) minmax(0,220fr)}.application-picker[data-active="2"]{--columns:minmax(0,220fr) minmax(0,220fr) minmax(0,776fr)}.application-cards,.application-panels,.application-connectors{display:grid;grid-template-columns:var(--columns);gap:16px}.application-tab{overflow:clip;height:384px;background:var(--web-quiet);padding:32px 28px 28px;display:flex;flex-direction:column;align-items:flex-start;position:relative;text-align:left;border:0;color:var(--foreground);min-width:0;cursor:pointer}.app-name{font:600 20px/28px var(--font-heading)}.app-question{margin-top:14px;font:400 15px/22px var(--font-body);color:var(--muted-foreground)}.app-plus{border:1px solid var(--web-outline);width:32px;height:32px;display:grid;place-items:center;margin-top:auto;font:400 24px/1 var(--font-heading)}.application-tab[aria-selected="true"]{background:var(--web-tile);border-top:3px solid var(--primary);padding:37px 40px}.application-tab[aria-selected="true"] .app-name{font-size:16px;line-height:22px;color:var(--primary)}.application-tab[aria-selected="true"] :is(.app-question,.app-plus){visibility:hidden}.application-tab:hover{background:var(--web-raised)}.application-panels{position:absolute;inset:0 0 auto;height:384px;pointer-events:none}.application-panel{padding:102px 40px 40px;display:grid;grid-template-columns:minmax(0,316fr) minmax(0,340fr);align-items:end;gap:40px;grid-row:1;min-width:0}.application-panel[hidden]{display:none}.app-story h3{font:400 clamp(24px,2.23vw,32px)/1.25 var(--font-heading);margin:0 0 16px;letter-spacing:-.005em}.app-story p{font-size:20px;line-height:30px;margin:0}.app-story .app-explanation{font-size:15px;line-height:24px;margin-top:16px;color:var(--muted-foreground)}.app-result{background:var(--background);padding:20px 22px 22px;min-width:0}.result-label{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0 0 14px}.market-result{border:0;margin:0;padding:0;min-width:0;pointer-events:auto}.market-result legend{padding:0}.market-outcomes{position:relative;display:grid;gap:4px}.market-option{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;padding:10px 16px;font:400 28px/38px var(--font-heading);color:var(--muted-foreground);cursor:pointer;transition:color 180ms ease-out,background-color 180ms ease-out}.market-option :global(.web-icon),.market-option :global(svg){width:24px;height:24px}.application-connectors{height:48px}.app-connector{position:relative;justify-self:center;width:1px;background:var(--web-outline)}.app-signal{position:absolute;top:14px;left:-3px;width:8px;height:8px;background:var(--primary);display:none}.application-picker[data-active="0"] [data-connector="0"],.application-picker[data-active="1"] [data-connector="1"],.application-picker[data-active="2"] [data-connector="2"]{background:var(--primary);width:2px}.application-picker[data-active="0"] [data-connector="0"]::after,.application-picker[data-active="1"] [data-connector="1"]::after,.application-picker[data-active="2"] [data-connector="2"]::after{content:'';position:absolute;bottom:0;left:-23px;width:48px;height:3px;background:var(--primary)}.application-picker[data-active="0"] [data-connector="0"] .app-signal,.application-picker[data-active="1"] [data-connector="1"] .app-signal,.application-picker[data-active="2"] [data-connector="2"] .app-signal{display:block}.application-backstop{display:flex;gap:28px;align-items:center;padding:26px 32px;background:var(--web-tile);min-height:112px}.application-backstop h3{font:600 22px/28px var(--font-heading);border-right:1px solid var(--web-outline);padding-right:28px;white-space:nowrap;margin:0}.application-backstop h4{font:600 24px/32px var(--font-heading);margin:0 0 4px}.application-backstop p{color:var(--muted-foreground);font-size:16px;line-height:24px;margin:0}
 /* Prediction markets: pick the answer (owner feedback, 6 Oct 2026). Native radios keep
    keyboard arrows and form semantics; the Green fill slides to the chosen answer and the
    check follows it. Choosing replays the signal down to the backstop. */
 .market-option input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
 .market-option:has(input:checked){color:var(--background)}
 .market-option:not(:has(input:checked)):hover{background:var(--web-tile);color:var(--foreground)}
 .market-option:has(input:focus-visible){outline:2px solid var(--ring);outline-offset:2px}
 .market-option :global(.web-icon){opacity:0;transform:scale(.6);transition:opacity 180ms ease-out,transform calc(320ms * var(--motion-factor,1)) cubic-bezier(.45,1.45,.8,1)}
 .market-option:has(input:checked) :global(.web-icon){opacity:1;transform:none}
 .market-highlight{position:absolute;left:0;right:0;top:0;height:calc((100% - 4px) / 2);background:var(--primary);translate:0 0;transition:translate calc(320ms * var(--motion-factor,1)) cubic-bezier(.22,.61,.36,1)}
 .market-outcomes:has(input[value="no"]:checked) .market-highlight{translate:0 calc(100% + 4px)}
 @media(prefers-reduced-motion:reduce){.market-option,.market-option :global(.web-icon),.market-highlight{transition:none}}
 @media(forced-colors:active){.market-highlight{background:Highlight}.market-option:has(input:checked){color:HighlightText;forced-color-adjust:none}}
 /* Application icon tiles and selection feedback (polish pass). */
 .app-icon{display:grid;place-items:center;width:40px;height:40px;flex:none;margin-bottom:20px;background:var(--web-raised);color:var(--foreground);border:1px solid transparent;transition:background-color 180ms ease-out,border-color 180ms ease-out,color 180ms ease-out}.app-icon :global(.web-icon),.app-icon :global(svg){width:20px;height:20px}
 .application-tab{transition:background-color 180ms ease-out}.app-plus{transition:border-color 180ms ease-out,background-color 180ms ease-out}
 .application-tab:not([aria-selected="true"]):hover .app-icon{background:var(--background)}.application-tab:not([aria-selected="true"]):hover .app-plus{border-color:var(--muted-foreground);background:var(--background)}
 .application-tab[aria-selected="true"] .app-icon{background:transparent;border-color:var(--primary);color:var(--primary);margin-bottom:16px}
 .application-tab:focus-visible{outline-offset:-2px}
 @media(prefers-reduced-motion:reduce){.app-icon,.application-tab,.app-plus{transition:none}}
 @media(max-width:1100px){.application-tab{padding:28px 20px}.application-tab[aria-selected="true"]{padding:29px 24px}.application-panel{padding-inline:24px;gap:20px}.app-story p{font-size:18px;line-height:26px}.app-result{padding:18px 16px}.app-name{font-size:18px;line-height:26px}.app-story .app-explanation{font-size:14px}.flight-summary>span:first-child,.grant-summary>span:first-child{font-size:24px}}
 @media(max-width:767px){.application-picker{display:flex;flex-direction:column}.application-cards{display:flex;flex-direction:column;gap:8px}.application-tab,.application-tab[aria-selected="true"]{height:auto;min-height:72px;padding:20px 24px}.application-tab[aria-selected="true"]{border-top:0;border-left:3px solid var(--primary)}.application-tab[aria-selected="true"] .app-name{font-size:18px;line-height:26px}.application-tab .app-question{display:none}.application-tab,.application-tab[aria-selected="true"]{flex-direction:row;align-items:center;gap:16px}.app-icon,.application-tab[aria-selected="true"] .app-icon{margin-bottom:0}.app-name{padding-right:35px}.app-plus{position:absolute;right:20px;top:20px}.application-tab[aria-selected="true"] .app-plus{display:none}.application-panels{position:static;display:block;height:auto;background:var(--web-tile);margin-top:16px;min-height:390px}.application-panel{display:flex;flex-direction:column;align-items:stretch;padding:28px 24px;gap:24px}.application-panel[hidden]{display:none}.app-result{width:100%}.app-story h3{font-size:28px}.application-connectors{display:none}.application-backstop{margin-top:24px;padding:24px;display:block}.application-backstop h3{border-right:0;border-bottom:1px solid var(--web-outline);padding:0 0 16px;margin-bottom:16px}.application-backstop h4{font-size:22px;line-height:30px}}
 @media(prefers-reduced-motion:reduce){.application-cards,.application-panels,.application-connectors{transition:none}}
</style>
