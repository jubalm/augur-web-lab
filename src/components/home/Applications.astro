---
import { applications, marketQuery, prizeChallenge } from '../../data/applications';
import Icon from '../primitives/Icon.astro';
---
<section class="applications section" aria-labelledby="applications-heading">
 <div class="container">
  <div class="section-heading"><h2 id="applications-heading">What could you build?</h2><p class="lead">Augur Lituus answers real-world questions.<br/>Your app decides what happens next.</p></div>
  <div class="application-picker" data-tabs data-applications data-activation="manual" data-active="0">
   <div class="application-cards" role="tablist" aria-label="Possible applications">
    {applications.map((app,i)=><button type="button" role="tab" id={`application-tab-${app.id}`} aria-controls={`application-panel-${app.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} class="application-tab"><span class="app-icon" aria-hidden="true"><Icon name={app.icon}/></span><span class="app-name">{app.title}</span><span class="app-question">“{app.question}”</span><span class="app-plus" aria-hidden="true">+</span></button>)}
   </div>
   <div class="application-panels">
    {applications.map((app,i)=><div role="tabpanel" id={`application-panel-${app.id}`} aria-labelledby={`application-tab-${app.id}`} class="application-panel" tabindex="0" hidden={i!==0} style={`grid-column:${i+1}`}>
     <div class="app-story"><h3>{app.action}</h3>{i!==0&&<p>“{app.question}”</p>}<p class="app-explanation">{app.explanation}</p></div>
     <div class:list={['app-result',{'app-query':i===0}]} data-play={app.id}>{i===0?<div class="market-query" data-market-query data-statuses={JSON.stringify(marketQuery.stages.map(stage=>stage.status))}>
       <div class="market-head"><p class="result-label">{app.result}</p><div class="market-status-slot"><p class="market-status"><span class="market-mark" aria-hidden="true"></span>{marketQuery.stages.at(-1)!.status}</p></div></div>
       <p class="market-question">{app.question}</p>
       <ol class="market-stages" aria-label="Stages">{marketQuery.stages.map((stage,index)=><li data-stage={index}><span class="stage-line" aria-hidden="true"><span></span></span><span class="stage-label">{stage.label}</span></li>)}</ol>
       <ul class="market-outcomes" aria-label="Outcomes">{marketQuery.outcomes.map(outcome=>outcome===marketQuery.answer?<li class="is-answer" data-answer={outcome}>{outcome}<Icon name="check"/><span class="sr-only">, final answer</span></li>:<li>{outcome}</li>)}</ul>
      </div>:<p class="result-label">{app.result}</p>}
      {i===1&&<><div class="flight-summary"><span><Icon name="airplane-tilt"/>AB123</span><span>More than<br/>two hours late</span></div><div class="flight-scale"><div class="flight-track" aria-hidden="true"><span class="flight-delay"></span><span class="flight-tick"></span><span class="flight-tick is-limit"></span><span class="flight-run"><span class="flight-arrival"></span></span></div><div class="flight-labels"><span>Scheduled arrival</span><span>+2 hours</span></div></div></>}
      {i===2&&<><ul class="prize-teams" aria-label="Teams">{prizeChallenge.teams.map(team=>team===prizeChallenge.winner?<li class="is-winner"><span class="prize-top"><span class="prize-mark"></span><Icon name="check"/></span>{team}<span class="sr-only">, final answer</span></li>:<li><span class="prize-top"><span class="prize-mark"></span></span>{team}</li>)}</ul><p class="prize-caption"><Icon name="check"/>Prize sent to {prizeChallenge.winner}</p></>}
     </div>
     {'fallback' in app&&<p class="app-fallback"><Icon name="scales"/><span>{app.fallback}</span></p>}
    </div>)}
   </div>
   <div class="application-connectors" aria-hidden="true">{applications.map((_,i)=><div class="app-connector" data-connector={i}><span class="app-signal"></span></div>)}</div>
   <div class="application-oracle"><h3>Augur Lituus</h3><p>One oracle for every app.</p></div>
  </div>
 </div>
</section>
<style>
 .flight-summary{display:flex;align-items:center;justify-content:space-between;gap:16px}.flight-summary>span:first-child{font:400 34px/40px var(--font-heading);letter-spacing:-.03em}.flight-summary>span:first-child{display:flex;align-items:center;gap:12px}.flight-summary>span:first-child :global(.web-icon),.flight-summary>span:first-child :global(svg){width:24px;height:24px;color:var(--muted-foreground)}.flight-summary>span:last-child{font-size:13px;line-height:19px;text-align:right}.flight-scale{padding-top:10px;margin-top:14px}.flight-labels{position:relative;height:18px;margin-top:8px;font-size:12px;line-height:18px;color:var(--muted-foreground)}.flight-labels>span:last-child{position:absolute;left:55.743%;top:0}
 .applications{padding-block:72px}.section-heading{margin-bottom:48px}.application-picker{--columns:minmax(0,776fr) minmax(0,220fr) minmax(0,220fr);position:relative}.application-picker[data-active="1"]{--columns:minmax(0,220fr) minmax(0,776fr) minmax(0,220fr)}.application-picker[data-active="2"]{--columns:minmax(0,220fr) minmax(0,220fr) minmax(0,776fr)}.application-cards,.application-panels,.application-connectors{display:grid;grid-template-columns:var(--columns);gap:16px}.application-tab{overflow:clip;height:384px;background:var(--web-quiet);padding:32px 28px 28px;display:flex;flex-direction:column;align-items:flex-start;position:relative;text-align:left;border:0;color:var(--foreground);min-width:0;cursor:pointer}.app-name{font:600 20px/28px var(--font-heading)}.app-question{margin-top:14px;font:400 15px/22px var(--font-body);color:var(--muted-foreground)}.app-plus{border:1px solid var(--web-outline);width:32px;height:32px;display:grid;place-items:center;margin-top:auto;font:400 24px/1 var(--font-heading)}.application-tab[aria-selected="true"]{background:var(--web-tile);padding:40px 40px 37px}.application-tab[aria-selected="true"] .app-name{font-size:16px;line-height:22px;color:var(--primary)}.application-tab[aria-selected="true"] :is(.app-question,.app-plus){visibility:hidden}.application-tab:hover{background:var(--web-raised)}.application-panels{position:absolute;inset:0 0 auto;height:384px;pointer-events:none}.application-panel{padding:102px 40px 40px;display:grid;grid-template-columns:minmax(0,316fr) minmax(0,340fr);align-items:end;gap:40px;grid-row:1;min-width:0}.application-panel[hidden]{display:none}.app-story h3{font:400 clamp(24px,2.23vw,32px)/1.25 var(--font-heading);margin:0 0 16px;letter-spacing:-.005em}.app-story p{font-size:20px;line-height:30px;margin:0}.app-story .app-explanation{font-size:15px;line-height:24px;margin-top:16px;color:var(--muted-foreground)}.app-result{background:var(--background);padding:20px 22px 22px;min-width:0}.result-label{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0 0 14px}.application-connectors{height:48px}.app-connector{position:relative;justify-self:center;width:1px;background:var(--web-outline)}.app-signal{position:absolute;top:14px;left:-3px;width:8px;height:8px;background:var(--primary);display:none}.application-picker[data-active="0"] [data-connector="0"],.application-picker[data-active="1"] [data-connector="1"],.application-picker[data-active="2"] [data-connector="2"]{background:var(--primary);width:2px}.application-picker[data-active="0"] [data-connector="0"]::after,.application-picker[data-active="1"] [data-connector="1"]::after,.application-picker[data-active="2"] [data-connector="2"]::after{content:'';position:absolute;bottom:0;left:-23px;width:48px;height:3px;background:var(--primary)}.application-picker[data-active="0"] [data-connector="0"] .app-signal,.application-picker[data-active="1"] [data-connector="1"] .app-signal,.application-picker[data-active="2"] [data-connector="2"] .app-signal{display:block}
 /* The Augur Lituus band (owner, 6 Oct 2026): one slim line naming the oracle every app asks,
    in Label. It was a 112 px “backstop” band that read as Augur Lituus's only use; the fallback
    use now sits in the Insurance panel as one app's choice. */
 .application-oracle{display:flex;align-items:center;gap:20px;padding:20px 32px;background:var(--web-tile)}.application-oracle :is(h3,p){font:600 16px/24px var(--font-heading);margin:0}.application-oracle h3{border-right:1px solid var(--web-outline);padding-right:20px;white-space:nowrap}
 @media(min-width:1024px){.application-panel:has(.app-fallback){row-gap:12px;padding-top:40px}.application-panel:has(.app-fallback) .app-story{grid-row:1/span 2}}.app-fallback{grid-column:2;display:flex;align-items:flex-start;gap:12px;margin:0;padding:12px 16px;border:1px solid var(--web-outline);font-size:14px;line-height:20px;color:var(--muted-foreground);text-wrap:balance}.app-fallback :global(.web-icon),.app-fallback :global(svg){width:16px;height:16px;flex:none;margin-top:2px;color:var(--foreground)}
 /* Prediction markets: a small query with its status, stages and outcomes (owner, 6 Oct 2026),
    set in Augur text styles: Meta (label, stages), UI (status, outcomes), Label (question).
    It is rendered final; market-query.ts plays the earlier stages in when the panel opens.
    The card may rise into the panel's top padding, where only the tab's name sits, on the left. */
 .app-query{margin-top:-62px}.market-query{container-type:inline-size}
 .market-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.market-head .result-label{margin:0}
 .market-status-slot{position:relative;display:flex;justify-content:flex-end}
 /* Global inside the slot: the statuses the query passes through are added by script. */
 .market-status-slot :global(.market-status){display:inline-flex;align-items:center;gap:8px;margin:0;padding:4px 10px;border:1px solid var(--primary);background:var(--primary);color:var(--background);font:600 14px/20px var(--font-heading);white-space:nowrap}
 .market-status-slot :global(.market-mark){width:6px;height:6px;flex:none;background:currentColor}
 .market-status-slot :global(.market-status.is-pending){position:absolute;right:0;top:0;background:var(--background);border-color:var(--web-outline);color:var(--foreground)}
 .market-status-slot :global(.is-pending .market-mark){background:var(--primary)}
 .market-question{font:600 16px/24px var(--font-heading);margin:0 0 16px}
 .market-stages{list-style:none;margin:0 0 16px;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 4px;font-size:13px;line-height:18px;color:var(--muted-foreground)}
 .market-stages li:last-child{color:var(--foreground)}
 .stage-line{position:relative;display:block;height:2px;background:var(--web-outline);margin-bottom:7px}.stage-line>span{display:block;height:100%;background:var(--muted-foreground);transform-origin:left}
 .market-stages li:last-child .stage-line>span{background:var(--primary)}.stage-label{position:relative;display:block}
 /* While the query plays, the current stage is Green with a Paper label (overlays from market-query.ts). */
 .market-stages :global(.stage-current){position:absolute;inset:0;background:var(--primary);transform-origin:left}.market-stages :global(.stage-label-current){position:absolute;inset:0;color:var(--foreground)}
 @container (width < 280px){.market-stages{grid-template-columns:repeat(2,minmax(0,1fr))}}
 .market-outcomes{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
 .market-outcomes li{position:relative;display:inline-flex;align-items:center;gap:6px;padding:8px 14px;background:var(--web-tile);color:var(--muted-foreground);font:600 14px/20px var(--font-heading)}
 .market-outcomes .is-answer{background:var(--primary);color:var(--background)}
 .market-outcomes :global(.web-icon),.market-outcomes :global(svg){width:16px;height:16px}
 /* Earlier looks of the answer while the query plays: one outcome among three, then reported. */
 .market-outcomes :global(.outcome-veil){position:absolute;inset:0;display:flex;align-items:center;padding:8px 14px;background:var(--web-tile);color:var(--muted-foreground)}
 .market-outcomes :global(.outcome-veil.is-tentative){background:var(--background);box-shadow:inset 0 0 0 1px var(--muted-foreground);color:var(--foreground)}
 @media(forced-colors:active){.market-status,.market-outcomes .is-answer,.prize-teams .is-winner{forced-color-adjust:none;background:Highlight;color:HighlightText;border-color:Highlight}.market-outcomes li,.prize-teams li{border:1px solid CanvasText}.stage-line>span{background:CanvasText}}
 /* Insurance's flight scale, in HTML since 6 Oct 2026 so the 14 px arrival square and 1 px ticks
    stay true at every width (the stretched SVG drew a 29 × 14 bar at 768). Positions are the old
    296-wide artwork's: arrival 258, +2 hours 189. The arrival square sits on the right end of
    .flight-run, which application-plays.ts slides in from the scheduled-arrival tick. */
 .flight-track{position:relative;height:20px;--arrival:87.162%;--limit:63.851%}.flight-track::before{content:'';position:absolute;inset:9px 0 auto;height:1px;background:var(--mark-past)}
 .flight-delay{position:absolute;left:0;top:9px;width:var(--arrival);height:1px;background:var(--foreground);transform-origin:left}
 .flight-tick{position:absolute;left:0;top:5px;width:1px;height:9px;background:var(--foreground)}.flight-tick.is-limit{left:var(--limit)}
 .flight-run{position:absolute;inset:0 auto 0 0;width:var(--arrival)}.flight-arrival{position:absolute;right:-7px;top:3px;width:14px;height:14px;background:var(--primary)}
 @media(forced-colors:active){.flight-track::before,.flight-delay,.flight-tick{forced-color-adjust:none;background:CanvasText}.flight-arrival{forced-color-adjust:none;background:Highlight}}
 /* DAOs & grants: a prize challenge (owner, 6 Oct 2026). The answer is one of three team
    tiles, the winner Green with its check top right; the caption confirms the payout. */
 .prize-teams{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
 .prize-teams li{display:flex;flex-direction:column;justify-content:space-between;gap:16px;position:relative;min-height:72px;padding:10px 10px 12px;background:var(--web-tile);color:var(--muted-foreground);font:600 14px/20px var(--font-heading);white-space:nowrap;min-width:0}
 .prize-teams .is-winner{background:var(--primary);color:var(--background)}
 .prize-teams :global(.prize-top){display:flex;align-items:center;justify-content:space-between;height:16px}.prize-teams :global(.prize-mark){width:8px;height:8px;background:currentColor}
 /* While the prize plays, Team B first shows as a plain tile (an aria-hidden veil from application-plays.ts). */
 .prize-teams :global(.prize-veil){position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;gap:16px;padding:10px 10px 12px;background:var(--web-tile);color:var(--muted-foreground)}
 .prize-teams :global(.web-icon),.prize-teams :global(svg),.prize-caption :global(.web-icon),.prize-caption :global(svg){width:16px;height:16px;flex:none}
 .prize-caption{display:flex;align-items:center;gap:10px;margin:14px 0 0;font-size:14px;line-height:20px;color:var(--foreground)}.prize-caption :global(.web-icon){color:var(--primary)}
 /* Application icon tiles and selection feedback (polish pass). */
 .app-icon{display:grid;place-items:center;width:40px;height:40px;flex:none;margin-bottom:20px;background:var(--web-raised);color:var(--foreground);border:1px solid transparent;transition:background-color 180ms ease-out,border-color 180ms ease-out,color 180ms ease-out}.app-icon :global(.web-icon),.app-icon :global(svg){width:20px;height:20px}
 .application-tab{transition:background-color 180ms ease-out}.app-plus{transition:border-color 180ms ease-out,background-color 180ms ease-out}
 .application-tab:not([aria-selected="true"]):hover .app-icon{background:var(--background)}.application-tab:not([aria-selected="true"]):hover .app-plus{border-color:var(--muted-foreground);background:var(--background)}
 /* The open card is marked by its icon tile filled Green (owner, 6 Oct 2026); it had a 3 px Green
    top edge, a left edge on phones. */
 .application-tab[aria-selected="true"] .app-icon{background:var(--primary);border-color:var(--primary);color:var(--background);margin-bottom:16px}
 @media(forced-colors:active){.application-tab[aria-selected="true"] .app-icon{forced-color-adjust:none;background:Highlight;border-color:Highlight;color:HighlightText}}
 .application-tab:focus-visible{outline-offset:-2px}
 @media(prefers-reduced-motion:reduce){.app-icon,.application-tab,.app-plus{transition:none}}
 @media(max-width:1100px){.application-tab{padding:28px 20px}.application-tab[aria-selected="true"]{padding:32px 24px 29px}.application-panel{padding-inline:24px;gap:20px}.app-story p{font-size:18px;line-height:26px}.app-result{padding:18px 16px}.app-name{font-size:18px;line-height:26px}.app-story .app-explanation{font-size:14px}.flight-summary>span:first-child{font-size:24px}}
 /* Below 1024 the picker stacks (since 6 Oct 2026, was 768): beside the story, the market query card had too little width. */
 @media(max-width:1023px){.app-query{margin-top:0}.application-picker{display:flex;flex-direction:column}.application-cards{display:flex;flex-direction:column;gap:8px}.application-tab,.application-tab[aria-selected="true"]{height:auto;min-height:72px;padding:20px 24px}.application-tab[aria-selected="true"] .app-name{font-size:18px;line-height:26px}.application-tab .app-question{display:none}.application-tab,.application-tab[aria-selected="true"]{flex-direction:row;align-items:center;gap:16px}.app-icon,.application-tab[aria-selected="true"] .app-icon{margin-bottom:0}.app-name{padding-right:35px}.app-plus{position:absolute;right:20px;top:20px}.application-tab[aria-selected="true"] .app-plus{display:none}.application-panels{position:static;display:block;height:auto;background:var(--web-tile);margin-top:16px;min-height:390px}.application-panel{display:flex;flex-direction:column;align-items:stretch;padding:28px 24px;gap:24px}.application-panel[hidden]{display:none}.app-result{width:100%}.app-story h3{font-size:28px}.application-connectors{display:none}.application-oracle{margin-top:24px;padding:20px 24px;display:block}.application-oracle h3{border-right:0;border-bottom:1px solid var(--web-outline);padding:0 0 12px;margin-bottom:12px}}
 @media(prefers-reduced-motion:reduce){.application-cards,.application-panels,.application-connectors{transition:none}}
</style>
