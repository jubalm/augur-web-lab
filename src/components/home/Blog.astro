---
import {getCollection} from 'astro:content';
import BlogCover from '../content/BlogCover.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,4);
const [featured,...secondary]=posts;
const date=(value:Date)=>new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(value);
---
<section class="home-blog section" aria-labelledby="blog-heading"><div class="container">
 <div class="blog-heading"><h2 id="blog-heading">From the blog</h2><a class="button outline" href="/blog/">View all posts</a></div>
 {featured&&<a class="featured-post" href={`/blog/${featured.id}/`}><div><p class="post-meta">{featured.data.category} · <time datetime={featured.data.publishedAt.toISOString()}>{date(featured.data.publishedAt)}</time></p><h3>{featured.data.title}</h3><p class="post-description">{featured.data.description}</p></div><BlogCover variant={featured.data.cover}/></a>}
 <div class="secondary-posts">{secondary.map(post=><a class="secondary-post" href={`/blog/${post.id}/`}><BlogCover variant={post.data.cover}/><div><p class="post-meta">{post.data.category} · <time datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time></p><h3>{post.data.title}</h3></div></a>)}</div>
</div></section>
<style>
 .home-blog{padding-block:72px}.blog-heading{display:flex;align-items:center;justify-content:space-between;gap:32px;margin-bottom:48px}.blog-heading h2{margin:0}
 .featured-post{display:grid;grid-template-columns:minmax(0,560fr) minmax(0,624fr);gap:64px;align-items:center;text-decoration:none;color:var(--foreground)}.featured-post h3{font:600 28px/36px var(--font-heading);margin:0 0 16px;max-width:400px}
 .post-meta{font-size:14px;line-height:20px;color:var(--muted-foreground);margin:0 0 20px}.post-description{color:var(--muted-foreground);font-size:18px;line-height:28px;margin:0}
 /* Supporting posts: equal columns divided by hairlines centred in the 48 px gutter. */
 .secondary-posts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px;margin-top:48px;padding-top:40px;border-top:1px solid var(--web-outline)}
 .secondary-post{position:relative;color:var(--foreground);text-decoration:none;min-width:0}.secondary-post+.secondary-post::before{content:'';position:absolute;top:0;bottom:0;left:-24px;width:1px;background:var(--web-outline)}
 .secondary-post>div:last-child{margin-top:24px}.secondary-post .post-meta{margin-bottom:8px}.secondary-post h3{font:600 22px/30px var(--font-heading);margin:0}
 .home-blog :global(.blog-cover){outline:1px solid transparent;outline-offset:-1px;transition:outline-color 180ms ease-out}
 :is(.featured-post,.secondary-post):hover :global(.blog-cover){outline-color:var(--border)}
 :is(.featured-post,.secondary-post):is(:hover,:focus-visible) h3{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}
 @media(max-width:1023px){.featured-post{gap:32px}.featured-post h3{font-size:25px;line-height:34px}.secondary-posts{gap:32px}.secondary-post+.secondary-post::before{left:-16px}.secondary-post h3{font-size:19px;line-height:27px}}
 @media(max-width:767px){.home-blog{padding-block:64px}.blog-heading{align-items:flex-start;flex-direction:column;gap:24px}.featured-post{grid-template-columns:1fr;gap:28px}.featured-post :global(.blog-cover){grid-row:1}.secondary-posts{grid-template-columns:1fr;gap:0;padding-top:0;border-top:0}.secondary-post{padding-block:32px;border-top:1px solid var(--web-outline)}.secondary-post+.secondary-post::before{display:none}.secondary-post h3{font-size:22px;line-height:30px}}
 @media(prefers-reduced-motion:reduce){.home-blog :global(.blog-cover){transition:none}}
</style>
