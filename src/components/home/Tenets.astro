---
import CrossAnywhere from '../art/diagrams/CrossAnywhere.astro';
import PeerMesh from '../art/diagrams/PeerMesh.astro';
import NoAuthority from '../art/diagrams/NoAuthority.astro';
const tenets=[
 {title:'Permissionless',diagram:CrossAnywhere,body:'Any app can ask a question. Anyone can report an answer or challenge one. No approval needed; fees and bonds apply.'},
 {title:'Decentralized',diagram:PeerMesh,body:'No committee, multisig or veto picks the answer. A fork is the last resort.'},
 {title:'Trustless',diagram:NoAuthority,body:'Every report is backed by a bond. Forcing a false answer is designed to cost more than it could gain.'},
];
---
<section class="tenets" aria-labelledby="tenets-heading" data-tenets>
 <div class="container">
  <div class="section-heading"><h2 id="tenets-heading">Who decides<br/>what happened?</h2><p class="lead">Smart contracts can't see the world. Whoever tells them what happened controls the money.</p></div>
 </div>
 <div class="answer-band"><p class="container" data-answer>With Augur, no party controls the answer.</p></div>
 <div class="container tenet-grid">
  {tenets.map(({title,diagram:Diagram,body})=><article class="tile tenet-tile"><Diagram/><div><h3>{title}</h3><p>{body}</p></div></article>)}
 </div>
</section>
<script>import {initTenets} from '../../motion/home-art';initTenets();</script>
<style>
 .tenets{padding-top:64px}.tenets>.container:first-child{border-top:1px solid var(--web-outline);padding-top:72px;padding-bottom:56px}.section-heading{margin-bottom:0}.answer-band{background:var(--primary);color:var(--background);padding:24px 0 28px}.answer-band p{font-family:var(--font-heading);font-size:clamp(26px,2.5vw,36px);font-weight:600;line-height:44px;letter-spacing:-.01em}.tenet-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding-top:48px;padding-bottom:96px;border-bottom:1px solid var(--web-outline)}.tenet-tile{padding:32px 32px 36px;background:var(--web-tile);display:flex;flex-direction:column;gap:28px;min-width:0}.tenet-tile h3{font:600 24px/32px var(--font-heading);margin:0 0 12px}.tenet-tile p{color:var(--muted-foreground);font-size:17px;line-height:27px;margin:0}.tenet-tile :global(svg){width:100%;height:auto;aspect-ratio:2/1;overflow:visible}.tenet-tile :global(rect){transform-box:fill-box;transform-origin:center}
 @media(max-width:1023px){.tenet-grid{grid-template-columns:1fr;max-width:700px}.tenet-tile{display:grid;grid-template-columns:1fr 1fr;align-items:center}.tenets>.container:first-child{padding-top:48px}}
 @media(max-width:600px){.tenets{padding-top:40px}.tenet-tile{display:flex}.answer-band p{line-height:1.3}.tenet-grid{padding-bottom:64px}.answer-band{padding-block:24px}}
</style>
