---
import { walkthrough, query, ledger, holder } from '../../data/walkthrough';
import { links } from '../../data/links';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import RepFlow from '../art/RepFlow.astro';
---
<section class="how-it-works section" id="how-it-works" aria-labelledby="how-heading"><div class="container">
 <div class="section-heading"><h2 id="how-heading">Know what happened?<br/>Get paid to report it.</h2><p class="lead">Every Augur Lituus answer comes from someone with REP at stake. Report the right outcome first to earn the reward, or challenge a wrong one to win most of its bond. Taking part is optional, and a wrong call costs your bond.</p></div>
 <div class="walkthrough" data-tabs data-walkthrough data-panel-swap data-active="0">
  <div class="walkthrough-steps" role="tablist" aria-label="How taking part works" aria-orientation="vertical">
   {walkthrough.map((step,i)=><button type="button" role="tab" id={`walkthrough-tab-${i}`} aria-label={step.title} aria-controls={`walkthrough-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span class="step-head"><span class="step-title">{step.title}</span><span class="step-done" aria-hidden="true"><Icon name="check"/></span></span><span class="step-description">{step.description}</span></button>)}
  </div>
  <div class="query-panels">
   {walkthrough.map((step,i)=><div class="query-card" role="tabpanel" id={`walkthrough-panel-${i}`} aria-labelledby={`walkthrough-tab-${i}`} hidden={i!==0} tabindex="0" style={`--connector-top:${43+i*80}px`}>
    <div class="query-header"><span class="query-name"><strong>Augur Lituus</strong><span class="query-example">Example</span></span><span class:list={["query-status",`is-${step.state}`]}><span aria-hidden="true"></span>{step.status}</span></div>
    <div class="query-progress" aria-hidden="true">{walkthrough.map((_,part)=><span class:list={{'is-complete':part<i,'is-current':part===i}}></span>)}</div>
    <div class="query-body"><h3>{query.question}</h3><p class="query-cutoff"><Icon name="clock"/>{query.cutoff}</p><details class="criteria"><summary><Icon name="list-checks"/><span>Resolution criteria</span><Icon name="chevron-down"/></summary><div class="criteria-body"><dl><div><dt>Question</dt><dd>{query.question}</dd></div><div><dt>Evidence cutoff</dt><dd>{query.cutoffDate}</dd></div><div><dt>Outcomes</dt><dd>{query.outcomes}</dd></div></dl></div></details>
     <div class="query-outcomes"><p>{step.answerLabel}</p><div class="outcome-list" aria-label={step.outcome?`${step.outcome} selected`:'No outcome selected'}>{['YES','NO','Invalid'].map(outcome=>step.replaced===outcome?<span class="outcome-chip is-replaced" data-replaced-at="2"><s>{outcome}</s><span class="sr-only"> — replaced</span></span>:<span class:list={['outcome-chip',{'is-selected':step.outcome===outcome}]}>{step.outcome===outcome&&<Icon name="check"/>}{outcome}{step.outcome===outcome&&<span class="sr-only"> — selected</span>}</span>)}</div></div>
    </div>
    <RepFlow zone={step.zone}/>
    <div class="query-activity"><p class="ledger-label" id={`walkthrough-ledger-${i}`}>Activity</p><ol class="query-ledger" aria-labelledby={`walkthrough-ledger-${i}`}>{ledger.slice(0,i+1).map((entry,index)=>{const replaced='replacedAt' in entry&&i>=entry.replacedAt;return <li data-ledger-latest={index===i?'':undefined} data-replaced-at={replaced?entry.replacedAt:undefined}><span class="ledger-node" aria-hidden="true"><Icon name={entry.icon}/></span><span class="ledger-event">{replaced?<><s>{entry.event}</s><span class="sr-only"> (replaced by the challenge)</span></>:entry.event}</span>{entry.amount&&<span class="ledger-amount">{entry.amount}</span>}</li>;})}</ol></div>
   </div>)}
  </div>
  <div class="holder">
   <h3>{holder.title}</h3>
   <p>{holder.text}</p>
   <div class="holder-actions"><Button href="/rep/" variant="outline">Learn about REP</Button><Button href={links.whitepaper.url} variant="text" external>Read the whitepaper</Button></div>
  </div>
 </div>
</div></section>
<style>
 /* One section answers “How do I take part, and how do I get paid?” (owner + Augus, 19 Oct 2026):
    the walkthrough's steps say what you do, the card's “Your REP” zone what you get. The REP
    section that repeated steps 2–3 is folded in; its holder note sits under the steps, where the
    steps column would otherwise stand empty beside the taller card. */
 .how-it-works{background:var(--web-band);padding-block:96px}.section-heading{margin-bottom:48px}
 .walkthrough{display:grid;grid-template-columns:minmax(0,500fr) minmax(0,668fr);grid-template-rows:auto 1fr;grid-template-areas:"steps panels" "holder panels";column-gap:80px;row-gap:48px;position:relative}
 .walkthrough-steps{grid-area:steps;display:flex;flex-direction:column;gap:8px}.walkthrough-steps button{display:flex;flex-direction:column;align-items:flex-start;text-align:left;background:var(--background);color:var(--foreground);border:0;padding:21px 24px;min-height:68px;cursor:pointer;transition:background 180ms ease-out,color 180ms ease-out}.step-title{font:600 20px/26px var(--font-heading)}.step-description{display:grid;grid-template-rows:0fr;max-height:0;opacity:0;overflow:hidden;font:400 16px/24px var(--font-body);transition:max-height calc(320ms * var(--motion-factor,1)),opacity calc(320ms * var(--motion-factor,1)),margin calc(320ms * var(--motion-factor,1))}.walkthrough-steps button[aria-selected="true"]{background:var(--primary);color:var(--background);padding-block:28px}.walkthrough-steps button[aria-selected="true"] .step-title{font-size:24px;line-height:32px}.walkthrough-steps button[aria-selected="true"] .step-description{max-height:150px;opacity:1;margin-top:12px}.walkthrough-steps button:hover:not([aria-selected="true"]){background:var(--web-raised)}.walkthrough-steps button:hover:not([aria-selected="true"]):not(:focus-visible){outline:1px solid var(--web-hover-edge);outline-offset:-1px}
 /* Every step's card shares one grid cell, hidden ones kept in layout but invisible, and each
    card is a subgrid of the same five rows (header, progress, question, Your REP, Activity), so
    every row is as tall as its tallest step at any width: switching never moves the page or the
    zone, and spare room falls under the Activity list at the card's foot
    (overrides the global [hidden] rule for these cards only). */
 .query-panels{grid-area:panels;display:grid;grid-template-rows:auto auto auto auto 1fr;min-width:0}
 .query-card{grid-row:1/-1;grid-column:1;display:grid;grid-template-rows:subgrid;background:var(--background);min-width:0;position:relative}.query-card[hidden]{display:grid!important;visibility:hidden}
 .query-header{min-height:68px;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;font:600 14px/20px var(--font-heading);position:relative}
 .query-name{display:flex;align-items:center;gap:10px}
 /* The card is an illustrative example, not a shipped app (no source for an Augur Lituus UI). */
 .query-example{padding:1px 8px;border:1px solid var(--web-outline);font:400 12px/18px var(--font-body);color:var(--muted-foreground)}
 .query-progress{display:flex;gap:4px;height:2px}.query-progress>span{flex:1;background:var(--web-outline);transform-origin:left}.query-progress>.is-complete{background:var(--primary)}.query-header::before{content:'';position:absolute;width:80px;height:2px;left:-80px;top:var(--connector-top,43px);background:var(--primary)}.query-status{display:inline-flex;align-items:center;gap:8px;padding:5px 10px;border:1px solid var(--web-outline);font:600 13px/18px var(--font-heading);white-space:nowrap}.query-status>span{width:6px;height:6px;flex:none;background:var(--primary)}.query-status.is-pending>span{background:transparent;border:1px solid var(--muted-foreground)}.query-status.is-final{background:var(--primary);border-color:var(--primary);color:var(--background)}.query-status.is-final>span{background:var(--background)}
 .query-body{padding:24px 24px 0}.query-body h3{font:400 22px/31px var(--font-heading);margin:0 0 10px;letter-spacing:-.01em}.query-cutoff{display:flex;align-items:center;gap:6px;font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0}.query-cutoff :global(.web-icon),.query-cutoff :global(svg){width:14px;height:14px}.criteria summary{display:inline-flex;gap:8px;align-items:center;cursor:pointer;min-height:44px;font:400 13px/18px var(--font-body);list-style:none;text-underline-offset:4px}.criteria summary:hover>span{text-decoration:underline}.criteria summary :global(.web-icon:last-child){transition:transform 180ms var(--ease-reveal)}.criteria summary::-webkit-details-marker{display:none}.criteria summary :global(.web-icon){width:14px;height:14px}.criteria summary :global(svg){width:14px;height:14px}.criteria[open] summary :global(.web-icon:last-child){transform:rotate(180deg)}.criteria-body{margin:0 0 12px;padding:14px 16px;background:var(--web-quiet);border-left:2px solid var(--web-outline)}.criteria-body dl{display:grid;gap:10px;margin:0}.criteria-body dl>div{display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px}.criteria-body dt{font-size:13px;line-height:20px;color:var(--muted-foreground)}.criteria-body dd{margin:0;font-size:14px;line-height:20px;color:var(--foreground)}
 .query-outcomes{border-top:1px solid var(--web-outline);margin-top:10px;padding:20px 0}.query-outcomes>p{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0 0 12px}.outcome-list{display:flex;gap:8px}.outcome-chip{display:inline-flex;align-items:center;gap:8px;border:0;font:600 16px/24px var(--font-heading);padding:12px 20px;background:var(--web-tile);color:var(--muted-foreground)}.outcome-chip.is-selected{color:var(--background);background:var(--primary);padding-left:16px}.outcome-chip :global(.web-icon),.outcome-chip :global(svg){width:18px;height:18px}
 .query-activity{padding:16px 24px 24px}
 /* Earlier stages recede (owner feedback, 5 Oct 2026): completed steps are crossed
    off with a Green check, the answer a challenge replaced is struck through,
    and older activity and progress dim behind the current stage. */
 .step-head{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%}
 .step-title{position:relative}
 .step-title::after{content:'';position:absolute;left:0;right:0;top:52%;height:1.5px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform calc(320ms * var(--motion-factor,1)) cubic-bezier(.45,0,.2,1)}
 .step-done{display:flex;color:var(--primary);opacity:0;transform:scale(.6);transition:opacity 180ms ease-out,transform calc(320ms * var(--motion-factor,1)) cubic-bezier(.45,1.45,.8,1)}.step-done :global(.web-icon),.step-done :global(svg){width:18px;height:18px}
 .walkthrough-steps button:has(~[aria-selected="true"]){color:var(--muted-foreground)}
 .walkthrough-steps button:has(~[aria-selected="true"]) .step-title::after{transform:scaleX(1)}
 .walkthrough-steps button:has(~[aria-selected="true"]) .step-done{opacity:1;transform:none}
 .walkthrough-steps button:has(~[aria-selected="true"]):hover{color:var(--foreground)}
 .query-progress>.is-current{background:var(--primary)}.query-progress>.is-complete{opacity:.4}
 .outcome-chip.is-replaced{background:transparent;box-shadow:inset 0 0 0 1px var(--web-outline);color:var(--muted-foreground)}
 :is(.outcome-chip,.ledger-event) s{position:relative;text-decoration:none}
 :is(.outcome-chip,.ledger-event) s::after{content:'';position:absolute;left:-2px;right:-2px;top:52%;height:1.5px;background:currentColor;transform-origin:left}
 .ledger-event s{white-space:nowrap}
 /* Activity as a timeline (owner feedback, 6 Oct 2026: “weird”, needs polish): square
    nodes on a rail name what happened to the REP, amounts sit in tags, and only the
    latest event is Green. Earlier events step back to Pewter rather than fading, and
    the report the challenge replaced keeps a hollow node and its strike. */
 .ledger-label{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0 0 6px}
 .query-ledger{position:relative;list-style:none;padding:0;margin:0}
 .query-ledger::before{content:'';position:absolute;left:11.5px;top:20px;bottom:20px;width:1px;background:var(--web-outline)}
 .query-ledger li{position:relative;display:grid;grid-template-columns:24px minmax(0,1fr) auto;align-items:center;column-gap:14px;min-height:40px;font-size:14px;line-height:20px;color:var(--muted-foreground)}
 .ledger-node{position:relative;display:grid;place-items:center;width:24px;height:24px;background:var(--web-tile);border:1px solid var(--web-outline);color:var(--muted-foreground)}
 .ledger-node :global(.web-icon),.ledger-node :global(svg){width:14px;height:14px}
 .ledger-amount{grid-column:3;padding:2px 8px;background:var(--web-tile);font:600 14px/20px var(--font-heading);font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--muted-foreground)}
 .query-ledger [data-ledger-latest]{color:var(--foreground)}
 .query-ledger [data-ledger-latest] .ledger-node{background:var(--primary);border-color:var(--primary);color:var(--background)}
 .query-ledger [data-ledger-latest] .ledger-amount{color:var(--foreground);background:var(--web-raised)}
 .query-ledger [data-replaced-at] .ledger-node{background:var(--background);border-style:dashed}
 .query-ledger [data-replaced-at] .ledger-amount{background:transparent;box-shadow:inset 0 0 0 1px var(--web-outline)}
 /* Holding REP? Beside the card's foot, under a hairline: holders never have to take part. */
 .holder{grid-area:holder;align-self:end;border-top:1px solid var(--web-outline);padding-top:32px}
 .holder h3{font:600 32px/40px var(--font-heading);letter-spacing:-.01em;margin:0 0 12px}
 .holder p{font-size:18px;line-height:28px;color:var(--muted-foreground);margin:0;max-width:44ch}
 .holder-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 32px;margin-top:24px}
 @media(forced-colors:active){.query-ledger [data-ledger-latest] .ledger-node{forced-color-adjust:none;background:Highlight;color:HighlightText}}
 @media(max-width:1279px){.walkthrough{column-gap:40px}.query-header::before{width:40px;left:-40px}.query-header{padding-inline:20px}.query-body{padding:20px 20px 0}.query-activity{padding:16px 20px 20px}.query-body h3{font-size:20px}.walkthrough-steps button{padding-inline:20px}.holder h3{font-size:28px;line-height:36px}}
 @media(max-width:1023px){.walkthrough{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);column-gap:24px;row-gap:40px}.query-header::before{display:none}.query-header{flex-wrap:wrap;gap:8px}.step-title{font-size:18px}.walkthrough-steps button[aria-selected="true"] .step-title{font-size:20px;line-height:28px}.step-description{font-size:15px;line-height:23px}.holder h3{font-size:24px;line-height:32px}.holder p{font-size:16px;line-height:24px}}
 @media(max-width:767px){.how-it-works{padding-block:64px}.walkthrough{grid-template-columns:minmax(0,1fr);grid-template-rows:auto;grid-template-areas:"steps" "panels" "holder";row-gap:24px}.holder{margin-top:16px;padding-top:28px}.walkthrough-steps button[aria-selected="true"] .step-description{min-height:69px;max-height:200px}.query-header{font-size:12px}.query-body h3{font-size:20px;line-height:29px}.outcome-chip{padding:12px 16px}.query-ledger li{column-gap:10px;font-size:13px}.ledger-amount{font-size:12px;padding-inline:6px}}
 /* Phones: the open step keeps room for the longest description (2–3 lines, 5 below 480), so the card under the steps barely moves. */
 @media(max-width:480px){.walkthrough-steps button[aria-selected="true"] .step-description{min-height:115px}}
 @media(prefers-reduced-motion:reduce){.walkthrough-steps button,.step-description,.criteria summary :global(.web-icon:last-child),.step-title::after,.step-done{transition:none}}
 @media(forced-colors:active){:is(.outcome-chip,.ledger-event) s{text-decoration:line-through}:is(.outcome-chip,.ledger-event) s::after{display:none}}
</style>
