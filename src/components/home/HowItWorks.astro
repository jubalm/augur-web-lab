---
import { walkthrough, query, ledger } from '../../data/walkthrough';
import { bondRounds } from '../../data/bond-rounds';
import Icon from '../primitives/Icon.astro';
---
<section class="how-it-works section" id="how-it-works" aria-labelledby="how-heading"><div class="container">
 <div class="section-heading"><h2 id="how-heading">How it works</h2><p class="lead">Every answer is backed by a bond in REP, Augur's token. Anyone who disagrees can challenge it by doubling the bond, so lying keeps getting more expensive.</p></div>
 <div class="walkthrough" data-tabs data-walkthrough data-active="0">
  <div class="walkthrough-steps" role="tablist" aria-label="How resolution works" aria-orientation="vertical">
   {walkthrough.map((step,i)=><button type="button" role="tab" id={`walkthrough-tab-${i}`} aria-label={step.title} aria-controls={`walkthrough-panel-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span class="step-title">{step.title}</span><span class="step-description">{step.description}</span></button>)}
  </div>
  <div class="query-panels">
   {walkthrough.map((step,i)=><div class="query-card" role="tabpanel" id={`walkthrough-panel-${i}`} aria-labelledby={`walkthrough-tab-${i}`} hidden={i!==0} tabindex="0" style={`--connector-top:${43+i*80}px`}>
    <div class="query-header"><strong>Augur Lituus</strong><span class="query-status"><span aria-hidden="true"></span>{step.status}</span></div>
    <div class="query-progress" aria-hidden="true">{walkthrough.map((_,part)=><span class:list={{'is-complete':part<=i}}></span>)}</div>
    <div class="query-body"><h3>{query.question}</h3><p class="query-cutoff">{query.cutoff}</p><details class="criteria"><summary><Icon name="file-text"/>Resolution criteria<Icon name="chevron-down"/></summary><div><p>{query.question}</p><p>{query.cutoff}</p></div></details>
     <div class="query-outcomes"><p>{step.answerLabel}</p><div class="outcome-list" aria-label={step.outcome?`${step.outcome} selected`:'No outcome selected'}>{['YES','NO','Invalid'].map(outcome=><span class:list={['outcome-chip',{'is-selected':step.outcome===outcome}]}>{outcome}{step.outcome===outcome&&<span class="sr-only"> — selected</span>}</span>)}</div></div>
     <ol class="query-ledger">{ledger.slice(0,i+1).map((entry,index)=><li data-ledger-latest={index===i?'':undefined}><span class="ledger-mark" aria-hidden="true"></span><span>{entry.event}</span><span>{entry.amount}</span></li>)}</ol>
    </div>
   </div>)}
  </div>
 </div>
 <div class="bond-rounds" data-tabs data-bonds data-active="3">
  <div class="bond-explanation"><h3>Disagreement raises the stakes</h3><div class="bond-panels">{bondRounds.map((round,i)=><div id={`bond-panel-${i}`} role="tabpanel" aria-labelledby={`bond-tab-${i}`} hidden={i!==3} tabindex="0"><h4>{round.title}</h4><p>{round.description}</p></div>)}</div><div class="bond-tabs" role="tablist" aria-label="Bond rounds">{bondRounds.map((_,i)=><button type="button" role="tab" id={`bond-tab-${i}`} aria-controls={`bond-panel-${i}`} aria-selected={i===3?'true':'false'} tabindex={i===3?0:-1} aria-label={`Round ${i+1}`}>{i+1}</button>)}</div></div>
  <div class="bond-chart" role="img" aria-label="Each challenge doubles the bond: 15, 30, 60, then 120 REP. The latest bond is green.">{bondRounds.map((round,i)=><div class="bond-column" data-bond={i}><div class="bond-space"><span class="bond-multiplier">{round.multiplier}</span><span class="bond-amount">{round.amount} REP</span><div class="bond-bar-clip"><span class:list={['bond-bar',{'is-latest':i===3}]} style={`height:${round.height}px`} data-bond-bar={i}></span></div></div><div class="bond-base"><strong>{round.outcome}</strong><span>{round.label}</span></div></div>)}</div>
 </div>
</div></section>
<script>import {initHomeInteractions} from '../../motion/home-interactions';initHomeInteractions();</script>
<style>
 .how-it-works{background:var(--web-band);padding-block:96px}.section-heading{margin-bottom:48px}.walkthrough{display:grid;grid-template-columns:minmax(0,500fr) minmax(0,668fr);gap:80px;min-height:549px;position:relative}.walkthrough-steps{display:flex;flex-direction:column;gap:8px}.walkthrough-steps button{display:flex;flex-direction:column;align-items:flex-start;text-align:left;background:var(--background);color:var(--foreground);border:0;padding:21px 24px;min-height:68px;cursor:pointer;transition:background 180ms ease-out,color 180ms ease-out}.step-title{font:600 20px/26px var(--font-heading)}.step-description{display:grid;grid-template-rows:0fr;max-height:0;opacity:0;overflow:hidden;font:400 16px/24px var(--font-body);transition:max-height calc(320ms * var(--motion-factor,1)),opacity calc(320ms * var(--motion-factor,1)),margin calc(320ms * var(--motion-factor,1))}.walkthrough-steps button[aria-selected="true"]{background:var(--primary);color:var(--background);padding-block:28px}.walkthrough-steps button[aria-selected="true"] .step-title{font-size:24px;line-height:32px}.walkthrough-steps button[aria-selected="true"] .step-description{max-height:150px;opacity:1;margin-top:12px}.walkthrough-steps button:hover:not([aria-selected="true"]){background:var(--web-raised)}.query-panels{min-width:0}.query-card{background:var(--background);min-width:0;position:relative}.query-card[hidden]{display:none}.query-header{min-height:68px;padding:18px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;font:600 14px/20px var(--font-heading);position:relative}.query-progress{display:flex;gap:4px;height:2px}.query-progress>span{flex:1;background:var(--web-outline)}.query-progress>.is-complete{background:var(--primary)}.query-header::before{content:'';position:absolute;width:80px;height:2px;left:-80px;top:var(--connector-top,43px);background:var(--primary)}.query-status{display:flex;align-items:center;gap:8px;padding:6px 10px}.query-status>span{width:6px;height:6px;background:var(--primary)}.query-body{padding:24px}.query-body h3{font:400 22px/31px var(--font-heading);margin:0 0 10px;letter-spacing:-.01em}.query-cutoff{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0}.criteria summary{display:flex;gap:8px;align-items:center;cursor:pointer;min-height:44px;font:400 13px/18px var(--font-body);list-style:none}.criteria summary::-webkit-details-marker{display:none}.criteria summary :global(.web-icon){width:14px;height:14px}.criteria summary :global(svg){width:14px;height:14px}.criteria[open] summary :global(.web-icon:last-child){transform:rotate(180deg)}.criteria>div{padding:16px 0;font-size:14px;line-height:22px;color:var(--muted-foreground)}.criteria p{margin:0 0 8px}.query-outcomes{border-top:1px solid var(--web-outline);margin-top:10px;padding:20px 0}.query-outcomes>p{font-size:13px;line-height:18px;color:var(--muted-foreground);margin:0 0 12px}.outcome-list{display:flex;gap:8px}.outcome-chip{border:0;font:600 16px/24px var(--font-heading);padding:12px 20px;background:var(--web-tile)}.outcome-chip.is-selected{color:var(--background);background:var(--primary);text-decoration:underline;text-underline-offset:5px}.query-ledger{list-style:none;padding:0;margin:0}.query-ledger li{display:flex;align-items:center;gap:14px;padding:10px 0 11px;border-top:1px solid var(--web-outline);font-size:14px;line-height:20px}.query-ledger li>span:nth-child(2){flex:1}.query-ledger li>span:last-child{font-family:var(--font-heading);white-space:nowrap}.ledger-mark{width:5px;height:5px;background:var(--muted-foreground);flex-shrink:0}.query-ledger [data-ledger-latest] .ledger-mark{background:var(--primary)}.bond-rounds{margin-top:16px;background:var(--background);padding:40px;display:grid;grid-template-columns:minmax(0,460fr) minmax(0,628fr);gap:80px}.bond-explanation h3{font:600 24px/32px var(--font-heading);margin:0 0 24px}.bond-panels{min-height:108px}.bond-panels h4{font:600 16px/22px var(--font-heading);margin:0 0 8px}.bond-panels p{font-size:18px;line-height:28px;margin:0}.bond-tabs{display:flex;gap:8px}.bond-tabs button{width:44px;height:44px;border:1px solid var(--web-outline);background:transparent;color:var(--foreground);font:600 14px/20px var(--font-heading);cursor:pointer}.bond-tabs button[aria-selected="true"]{background:var(--primary);color:var(--background);border-color:var(--primary);text-decoration:underline;text-underline-offset:4px}.bond-tabs button:hover:not([aria-selected="true"]){background:var(--web-raised)}.bond-chart{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));min-width:0}.bond-space{height:260px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:4px;overflow:hidden}.bond-multiplier{font:400 40px/48px var(--font-heading);letter-spacing:-.02em}.bond-amount{font-size:13px;line-height:18px;color:var(--muted-foreground)}.bond-bar-clip{overflow:hidden;max-width:70%;width:96px}.bond-bar{width:100%;display:block;background:var(--mark-past,#4A4B61);transform-origin:center bottom}.bond-bar.is-latest{background:var(--primary)}.bond-base{border-top:1px solid var(--web-outline);padding-top:8px;text-align:center;display:flex;flex-direction:column;gap:2px}.bond-base strong{font:600 20px/26px var(--font-heading)}.bond-base>span{font-size:13px;line-height:18px;color:var(--muted-foreground)}.bond-column.is-future .bond-bar{opacity:0}
 @media(max-width:1279px){.walkthrough{gap:40px}.query-header::before{width:40px;left:-40px}.bond-rounds{gap:40px}.query-header{padding-inline:20px}.query-body{padding:20px}.query-body h3{font-size:20px}.walkthrough-steps button{padding-inline:20px}}
 @media(max-width:1023px){.query-panels{min-height:650px}.walkthrough{grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:24px}.query-header::before{display:none}.query-header{flex-wrap:wrap;gap:8px}.step-title{font-size:18px}.walkthrough-steps button[aria-selected="true"] .step-title{font-size:20px;line-height:28px}.step-description{font-size:15px;line-height:23px}.bond-rounds{grid-template-columns:1fr;gap:32px}.bond-chart{max-width:650px;width:100%;margin:auto}.bond-panels{min-height:84px}}
 @media(max-width:767px){.how-it-works{padding-block:64px}.walkthrough{grid-template-columns:1fr;gap:24px;min-height:0}.walkthrough-steps button[aria-selected="true"] .step-description{min-height:144px;max-height:200px}.query-header{font-size:12px}.query-body h3{font-size:20px;line-height:29px}.outcome-chip{padding:12px 16px}.bond-rounds{margin-top:40px;padding:24px}.bond-multiplier{font-size:30px;line-height:40px}.bond-amount,.bond-base>span{font-size:11px}.bond-base strong{font-size:16px}.bond-explanation h3{font-size:22px}.bond-panels{min-height:130px}.query-ledger li{gap:9px;font-size:12px}}
 @media(prefers-reduced-motion:reduce){.walkthrough-steps button,.step-description{transition:none}}
</style>
