---
import {getCollection} from 'astro:content';
import {faqEntries} from '../../data/faq';
import FaqItem from '../content/FaqItem.astro';
import BlogCover from '../content/BlogCover.astro';
import Icon from '../primitives/Icon.astro';
// One section where the page used to end on two (owner, 19 Oct 2026: Augus found the page too long).
// Quick answers lead in the wide column, the latest writing sits beside them, and the
// beginner guides get the heading row's action, so every depth of reading starts here.
const questions=faqEntries.filter(entry=>entry.homepage);
const [featured,...recent]=(await getCollection('blog')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,4);
const date=(value:Date)=>new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(value);
---
<section class="home-learn section" id="learn-more" aria-labelledby="learn-heading"><div class="container">
 <div class="learn-heading"><h2 id="learn-heading">Learn more about Augur.</h2><p class="learn-start">New to oracles? <a class="button outline" href="/learn/">Start here</a></p></div>
 <div class="learn-grid">
  <div class="learn-questions">
   <h3>Frequently asked questions</h3>
   <div class="faq-accordion">{questions.map((entry,i)=><FaqItem entry={entry} name="home-faq" open={i===0}/>)}<a class="learn-all" href="/faq/">View all questions<span class="learn-all-arrow"><Icon name="arrow-right"/></span></a></div>
  </div>
  <div class="learn-posts">
   <h3>From the blog</h3>
   {featured&&<a class="featured-post" href={`/blog/${featured.id}/`}><BlogCover variant={featured.data.cover}/><div class="featured-text"><p class="post-meta">{featured.data.category} · <time datetime={featured.data.publishedAt.toISOString()}>{date(featured.data.publishedAt)}</time></p><h4>{featured.data.title}</h4><p class="post-description">{featured.data.description}</p></div></a>}
   <div class="post-more"><ul class="post-list">{recent.map(post=><li><a class="post-row" href={`/blog/${post.id}/`}><p class="post-meta">{post.data.category} · <time datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time></p><h4>{post.data.title}</h4></a></li>)}</ul><a class="learn-all" href="/blog/">View all posts<span class="learn-all-arrow"><Icon name="arrow-right"/></span></a></div>
  </div>
 </div>
</div></section>
<style>
 .home-learn{background:var(--web-band);padding-block:72px 96px}
 .learn-heading{display:flex;align-items:center;justify-content:space-between;gap:24px 48px;margin-bottom:48px}
 .learn-heading h2{text-wrap:balance}
 .learn-start{display:flex;align-items:center;gap:20px;font-size:18px;line-height:28px;color:var(--muted-foreground)}
 /* 704 / 80 / 464 at 1440: answers need the measure (every homepage question on one line), posts the narrower column. */
 .learn-grid{display:grid;grid-template-columns:minmax(0,1fr) 464px;gap:80px}
 .learn-grid h3{font:600 20px/26px var(--font-heading);margin-bottom:20px}
 /* The posts column stretches to the answers: the featured post keeps the top edge, the list and its closing row keep the frame's bottom edge,
    and any slack falls between the two groups, so both columns end on one line. */
 .learn-posts{display:flex;flex-direction:column}
 .post-more{margin-top:auto;padding-top:16px}
 .post-more>.learn-all{border-bottom:1px solid var(--web-outline)}

 .faq-accordion{border:1px solid var(--web-outline);background:var(--web-quiet)}
 /* General sibling: Astro hoists FaqItem's script after the first question, which broke `+` for the second. */
 .faq-accordion :global(.faq-item~.faq-item){border-top:1px solid var(--web-outline)}
 .faq-accordion :global(.faq-answer){max-width:628px;padding-right:56px;padding-bottom:12px}
 .faq-accordion :global(details[open]>summary){padding-bottom:12px}
 .faq-accordion :global(.faq-answer p){color:var(--foreground);opacity:.86}
 .faq-accordion :global(.faq-answer a){margin-top:8px}

 /* Each column ends on the same row: its name and an arrow tile that answers like the FAQ toggles. */
 .learn-all{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:72px;border-top:1px solid var(--web-outline);font:600 16px/24px var(--font-heading);color:var(--foreground);text-decoration:none;transition:background-color 180ms ease-out}
 .faq-accordion .learn-all{padding:0 16px 0 24px}
 .learn-all-arrow{display:grid;place-items:center;width:32px;height:32px;flex:none;border:1px solid var(--web-outline);transition:border-color 180ms ease-out,background-color 180ms ease-out}
 .learn-all-arrow :global(.web-icon),.learn-all-arrow :global(svg){width:14px;height:14px;transition:transform 240ms var(--ease-reveal)}
 .learn-all:hover .learn-all-arrow{border-color:var(--web-hover-edge);background:var(--web-raised)}
 .learn-all:hover .learn-all-arrow :global(.web-icon){transform:translateX(2px)}
 .faq-accordion .learn-all:hover{background:var(--web-tile)}
 .learn-all:focus-visible{outline:2px solid var(--ring);outline-offset:-2px}
 /* The FAQ morph names each question; the closing row slides with them instead of stretching with the frame. */
 :global(html[data-faq-transition]) .faq-accordion .learn-all{view-transition-name:faq-more;view-transition-class:faq}
 :global(html[data-faq-transition]) .post-more{view-transition-name:posts-more;view-transition-class:faq}

 .featured-post,.post-row{display:block;color:var(--foreground);text-decoration:none}
 .post-meta{font-size:14px;line-height:20px;color:var(--muted-foreground)}
 .featured-post .post-meta{margin:16px 0 8px}
 .featured-post h4{font:600 22px/28px var(--font-heading);text-wrap:balance}
 .post-description{margin-top:8px;font-size:16px;line-height:24px;color:var(--muted-foreground)}
 .post-list{list-style:none;margin:0;padding:0}
 .post-row{padding:12px 0;border-top:1px solid var(--web-outline)}
 .post-row .post-meta{font-size:13px;line-height:18px;margin-bottom:4px}
 .post-row h4{font:600 17px/24px var(--font-heading)}
 .home-learn :global(.blog-cover){outline:1px solid transparent;outline-offset:-1px;transition:outline-color 180ms ease-out}
 .featured-post:hover :global(.blog-cover){outline-color:var(--web-hover-edge)}
 :is(.featured-post,.post-row):is(:hover,:focus-visible) h4{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px}

 @media(max-width:1439px){.learn-grid{grid-template-columns:minmax(0,1fr) 420px;gap:64px}}
 /* Below 1200 the answers would wrap into a tall column beside short posts, so the two stack. */
 @media(max-width:1199px){
  .learn-grid{grid-template-columns:1fr;gap:64px}
  .featured-post{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:center}
  .featured-post .post-meta{margin-top:0}
  .post-more{padding-top:32px}
  .post-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 32px}
 }
 @media(max-width:767px){
  .home-learn{padding-block:64px}
  .learn-heading{flex-direction:column;align-items:flex-start;margin-bottom:40px}
  .learn-start{flex-wrap:wrap;gap:12px 20px}
  .faq-accordion :global(.faq-answer){padding-right:16px}
  .faq-accordion :global(summary){font-size:16px;line-height:24px}
  .featured-post{display:block}
  .featured-post .post-meta{margin-top:20px}
  .post-more{padding-top:24px}
  .post-list{display:block}
 }
 @media(prefers-reduced-motion:reduce){.home-learn :global(.blog-cover),.learn-all,.learn-all-arrow,.learn-all-arrow :global(svg){transition:none}.learn-all:hover .learn-all-arrow :global(.web-icon){transform:none}}
 @media(forced-colors:active){.learn-all-arrow{border-color:ButtonText}.learn-all:focus-visible{outline-color:Highlight}}
</style>
