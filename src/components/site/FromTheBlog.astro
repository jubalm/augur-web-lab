---
import HomeSection from './HomeSection.astro';
import TextLink from './TextLink.astro';

// Selected for usefulness from the public augur.net blog, reviewed September 19, 2026.
// Titles, dates and authors are original; descriptions are summaries. Article pages and the
// Blog archive are planned local destinations, so links stay inert during structure review.
const posts = [
  {
    title: 'Augur Is Testing Its Past and Building Its Future',
    date: 'July 21, 2026',
    datetime: '2026-07-21',
    author: 'Lituus Foundation',
    description: 'Why resolution is the weak point of prediction markets, and how the Moon Fork and Augur Lituus respond to it.',
    source: 'https://www.augur.net/blog/augur-testing-past-building-future/',
  },
  {
    title: 'The Augur Lituus Whitepaper',
    date: 'January 29, 2026',
    datetime: '2026-01-29',
    author: 'Lituus Foundation',
    description: 'The announcement of Augur Lituus: a proposed resolution layer for other protocols, with a comparative analysis of oracle security.',
    source: 'https://www.augur.net/blog/the-augur-lituus-whitepaper/',
  },
];
---
<HomeSection id="journal" layout="row">
  <Fragment slot="title">From the blog</Fragment>
  <p slot="aside" class="all-posts"><TextLink>View all posts</TextLink></p>

  <ul class="posts" data-reveal-children>
    {posts.map(post => (
      <li>
        <article>
          <p class="post-meta"><time datetime={post.datetime}>{post.date}</time> · {post.author}</p>
          <h3 class="augur-type-heading-2"><TextLink quiet>{post.title}</TextLink></h3>
          <p class="post-description">{post.description}</p>
        </article>
      </li>
    ))}
  </ul>
</HomeSection>

<style>
  .all-posts { font-size: 15px; font-weight: 600; }
  .posts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 80px; }
  .posts li { min-width: 0; padding-top: 24px; border-top: 1px solid var(--border-quiet); }
  .post-meta { color: var(--muted-foreground); font-size: 13px; }
  .posts h3 { max-width: 24ch; margin-top: 12px; font-size: clamp(24px, 2vw, 28px); line-height: 1.25; letter-spacing: -.025em; }
  .post-description { max-width: 52ch; margin-top: 12px; color: var(--muted-foreground); font-size: 16px; line-height: 1.65; }
  @media (max-width: 1100px) { .posts { gap: 40px; } }
  @media (max-width: 760px) { .posts { grid-template-columns: 1fr; } }
</style>
