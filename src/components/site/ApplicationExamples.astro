---
import Icon from './Icon.astro';
interface Props { idPrefix: string; }
const { idPrefix } = Astro.props;

// Website Strategy Figure F5: possible applications, not established integrations.
// Yes answers and output illustrations are hypothetical; applications apply their own rules.
const applications = [
  { key: 'markets', title: 'Prediction markets', action: 'Settle a market.',
    question: 'Was the milestone demonstrated by the deadline?', explanation: 'Use the answer to settle the market.' },
  { key: 'payments', title: 'Insurance & payments', action: 'Pay insurance claims.',
    question: 'Was flight AB123 more than two hours late?', explanation: 'Pay claims according to the policy.' },
  { key: 'grants', title: 'DAOs & grants', action: 'Release grant funding.',
    question: 'Was the promised work published on time?', explanation: 'Release funds when the grant terms are met.' },
];
---
<fieldset class="application-examples" aria-describedby={`${idPrefix}-note`}>
  <legend class="visually-hidden">Choose a type of application</legend>
  <div class="example-choices">
    {applications.map((application, index) => (
      <label class="example-choice augur-type-ui" for={`${idPrefix}-${application.key}`}>
        <input class="visually-hidden" id={`${idPrefix}-${application.key}`} type="radio"
          name={`${idPrefix}-application`} value={application.key} checked={index === 0}
          aria-controls={`${idPrefix}-${application.key}-preview`} />
        <span>{application.title}</span>
      </label>
    ))}
  </div>
  <div class="example-panels">
    {applications.map(application => (
      <article class="example-panel" data-application={application.key}
        id={`${idPrefix}-${application.key}-preview`} aria-labelledby={`${idPrefix}-${application.key}-action`}>
        <div class="example-story">
          <h3 class="augur-type-editorial-section" id={`${idPrefix}-${application.key}-action`}>{application.action}</h3>
          <p class="example-question augur-type-body">“{application.question}”</p>
          <p class="example-explanation augur-type-body">{application.explanation}</p>
        </div>
        <figure class="example-visual" aria-label={`Illustrative ${application.title.toLowerCase()} outcome`}>
          <div class="example-artifact">
            <div class="answer-receipt">
              <span>Augur Lituus<span class="answer-caption">Example answer</span></span>
              <strong class="answer-value augur-type-heading-2"><Icon name="check" />Yes</strong>
            </div>
            <div class="answer-connection" aria-hidden="true"><span></span><Icon name="arrow-down" weight="regular" /></div>
            {application.key === 'markets' && (
              <div class="application-result market-result">
                <div class="result-heading"><span>Market result</span><span class="result-symbol" aria-hidden="true"><i></i><i></i><i></i></span></div>
                <div class="position-row position-winner"><span class="position-answer augur-type-heading-2">Yes</span><span>Winning outcome</span><Icon name="check" /></div>
                <div class="position-row"><span class="position-answer augur-type-heading-2">No</span><span>Other outcome</span><Icon name="minus" weight="regular" /></div>
              </div>
            )}
            {application.key === 'payments' && (
              <div class="application-result payment-result">
                <div class="result-heading"><span>Flight-delay insurance</span><Icon name="clock" weight="regular" /></div>
                <div class="flight-summary"><strong class="augur-type-editorial-section">AB123</strong><span>More than<br />two hours late</span></div>
                <div class="flight-timeline" aria-hidden="true"><span class="flight-line"></span><i class="flight-start"></i><i class="flight-threshold"></i><span class="flight-arrival"><Icon name="check" /></span></div>
                <div class="flight-scale"><span>Scheduled arrival</span><span>+2 hours</span></div>
              </div>
            )}
            {application.key === 'grants' && (
              <div class="application-result grant-result">
                <div class="result-heading"><span>Grant progress</span><Icon name="file-text" weight="regular" /></div>
                <div class="grant-document"><strong class="augur-type-editorial-section">Published.</strong><span>On time</span><div class="document-lines" aria-hidden="true"><i></i><i></i></div></div>
                <div class="grant-condition"><Icon name="check" /><span>Grant requirement met</span></div>
              </div>
            )}
          </div>
        </figure>
      </article>
    ))}
  </div>
  <p class="examples-note" id={`${idPrefix}-note`}>Example applications. No integrations yet.</p>
</fieldset>

<style>
  .application-examples { min-width: 0; margin: 0; padding: 0; border: 0; }
  .example-choices { display: flex; gap: 40px; border-bottom: 1px solid var(--web-outline); }
  .example-choice { position: relative; display: flex; align-items: center; min-height: 56px; padding-block: 12px 18px; margin-bottom: -1px; border-bottom: 3px solid transparent; color: var(--muted-foreground); font-size: 16px; line-height: 1.5; cursor: pointer; }
  .example-choice input { top: 50%; left: 0; }
  .example-choice:has(:checked) { color: var(--foreground); border-bottom-color: var(--foreground); }
  .example-choice:has(:focus-visible) { outline: 2px solid var(--foreground); outline-offset: 5px; z-index: 1; }
  .example-panels { display: grid; margin-top: 32px; }
  .example-panel { grid-area: 1 / 1; display: grid; grid-template-columns: 1fr 1fr; min-width: 0; visibility: hidden; background: var(--card); color: var(--foreground); border: 1px solid var(--web-outline); }
  .example-story { display: flex; flex-direction: column; justify-content: center; align-items: start; padding: 48px; }
  .example-story h3 { font-size: clamp(30px, 3vw, 44px); line-height: 1.16; letter-spacing: -.035em; font-weight: 400; }
  .example-question { max-width: 31ch; margin-top: 28px; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.5; text-wrap: pretty; }
  .example-explanation { margin-top: 16px; color: var(--muted-foreground); font-size: 15px; line-height: 1.6; }
  .example-visual { display: grid; place-items: center; min-width: 0; margin: 0; padding: 36px 48px; background: var(--muted); }
  .example-artifact { display: grid; grid-template-rows: auto 32px 1fr; width: min(100%, 392px); min-height: 310px; }
  .answer-receipt { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 16px 20px; background: var(--card); border: 1px solid var(--web-outline); }
  .answer-receipt > span { font-size: 14px; line-height: 1.4; }
  .answer-caption { display: block; margin-top: 3px; color: var(--muted-foreground); font-size: 12px; }
  .answer-value { display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px; background: var(--primary); color: var(--primary-foreground); font-size: 20px; font-weight: 400; line-height: 1.2; }
  .answer-value :global(.web-icon) { width: 16px; height: 16px; }
  .answer-connection { display: flex; flex-direction: column; align-items: center; height: 32px; color: var(--muted-foreground); }
  .answer-connection > span { width: 1px; height: 18px; background: currentColor; }
  .answer-connection :global(.web-icon) { width: 16px; height: 16px; margin-top: -4px; }
  .application-result { display: flex; flex-direction: column; padding: 20px 24px 0; background: var(--card); border: 1px solid var(--web-outline); }
  .result-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 20px; margin-bottom: 20px; color: var(--muted-foreground); font-size: 12px; line-height: 1.5; }
  .result-heading :global(.web-icon) { width: 18px; height: 18px; }
  .result-symbol { display: flex; align-items: end; gap: 3px; height: 17px; }
  .result-symbol i { width: 3px; height: 7px; background: currentColor; }
  .result-symbol i:nth-child(2) { height: 12px; }
  .result-symbol i:nth-child(3) { height: 17px; }
  .position-row { display: grid; grid-template-columns: 50px 1fr 18px; align-items: center; gap: 12px; padding: 13px 14px; color: var(--muted-foreground); font-size: 12px; }
  .position-row.position-winner { color: var(--foreground); background: var(--muted); }
  .position-answer { font-size: 24px; font-weight: 400; line-height: 1.2; letter-spacing: -.02em; }
  .position-row :global(.web-icon) { width: 16px; height: 16px; }
  .flight-summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .flight-summary > strong { font-size: 30px; line-height: 1.2; letter-spacing: -.03em; font-weight: 400; }
  .flight-summary > span { font-size: 12px; line-height: 1.5; text-align: right; }
  .flight-timeline { position: relative; height: 24px; margin-top: 22px; }
  .flight-line { position: absolute; inset: 11px 0 auto; height: 1px; background: var(--web-outline); }
  .flight-line::before { content: ''; display: block; width: 87%; height: 1px; background: var(--foreground); }
  .flight-start, .flight-threshold { position: absolute; top: 7px; width: 1px; height: 9px; background: var(--foreground); }
  .flight-start { left: 0; }
  .flight-threshold { left: 64%; }
  .flight-arrival { position: absolute; inset: 0 auto auto calc(87% - 12px); display: grid; place-items: center; width: 24px; height: 24px; background: var(--foreground); color: var(--background); }
  .flight-arrival :global(.web-icon) { width: 14px; height: 14px; }
  .flight-scale { display: flex; justify-content: space-between; width: calc(64% + 24px); margin-top: 5px; color: var(--muted-foreground); font-size: 11px; line-height: 1.5; }
  .grant-document > strong { display: block; font-size: 30px; line-height: 1.2; letter-spacing: -.03em; font-weight: 400; }
  .grant-document > span { display: block; margin-top: 6px; color: var(--muted-foreground); font-size: 12px; line-height: 1.5; }
  .document-lines { display: grid; gap: 7px; margin-top: 17px; }
  .document-lines i { height: 1px; width: 72%; background: var(--web-outline); }
  .document-lines i:last-child { width: 47%; }
  .grant-condition { display: flex; align-items: center; gap: 8px; margin-top: 18px; font-size: 12px; line-height: 1.5; }
  .grant-condition :global(.web-icon) { width: 16px; height: 16px; }
  .examples-note { margin-top: 18px; color: var(--muted-foreground); font-size: 12px; line-height: 1.6; }
  /* Native selection works without JavaScript. All panels size the same grid cell. */
  .application-examples:has(input[value="markets"]:checked) [data-application="markets"],
  .application-examples:has(input[value="payments"]:checked) [data-application="payments"],
  .application-examples:has(input[value="grants"]:checked) [data-application="grants"] { visibility: visible; }
  @media (hover: hover) { .example-choice:hover { color: var(--foreground); } }
  @media (max-width: 1100px) {
    .example-story { padding: 32px; }
    .example-visual { padding: 32px; }
    .example-story h3 { font-size: 34px; }
    .example-question { font-size: 18px; }
    .example-choices { gap: 32px; }
    .application-result { padding-inline: 20px; }
  }
  @media (max-width: 760px) {
    .example-choices { gap: 20px; }
    .example-choice { flex: 1; font-size: 13px; }
    .example-panel { grid-template-columns: 1fr; }
    .example-panels { margin-top: 24px; }
    .example-story { padding: 32px 24px; }
    .example-story h3 { max-width: none; font-size: 30px; }
    .example-question { margin-top: 20px; max-width: 40ch; }
    .example-visual { padding: 28px 24px; }
  }
  @media (forced-colors: active) {
    .example-choice:has(:checked) { border-bottom-color: Highlight; }
    .answer-value, .position-winner, .flight-arrival { border: 1px solid CanvasText; }
  }
  @media print {
    .example-choices { display: none; }
    .example-panels { display: block; }
    .example-panel { visibility: visible; break-inside: avoid; margin-bottom: 24px; }
  }
</style>
