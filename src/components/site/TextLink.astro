---
import Icon from './Icon.astro';
// Structure review: a link without an href stays an inert placeholder.
// Internal destinations have no arrow; ↗ is reserved for external destinations.
// quiet: underline on hover only, for titles and directory lists.
interface Props { href?: string; external?: boolean; quiet?: boolean; class?: string; }
const { href, external = false, quiet = false, class: className } = Astro.props;
const placeholder = !href;
---
<a class:list={['text-link-inline', { quiet }, className]} href={href} role={placeholder ? 'link' : undefined} aria-disabled={placeholder ? 'true' : undefined} tabindex={placeholder ? 0 : undefined}><span><slot /></span>{external && <Icon name="arrow-up-right" />}</a>

<style>
  .text-link-inline { display: inline-flex; align-items: center; gap: 6px; color: var(--foreground); text-decoration: none; cursor: pointer; }
  .text-link-inline > span { text-decoration-line: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); }
  .text-link-inline.quiet > span { text-decoration-color: transparent; }
  .text-link-inline:hover > span { text-decoration-thickness: 2px; text-decoration-color: currentColor; }
  .text-link-inline.quiet:hover > span { text-decoration-thickness: 1px; }
  .text-link-inline :global(.web-icon) { width: 14px; height: 14px; }
  .text-link-inline:focus-visible { outline: 2px solid var(--foreground); outline-offset: 4px; }
</style>
