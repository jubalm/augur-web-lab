---
// Shared frame and heading for the homepage sections that follow Why + how.
// split: heading beside the aside. row: heading with a trailing action.
// side: heading and aside in the left column, section content on the right.
interface Props { id: string; label?: string; layout?: 'split' | 'row' | 'side'; }
const { id, label, layout = 'split' } = Astro.props;
const titleId = `${id}-title`;
---
<section id={id} class:list={['home-section', layout]} aria-labelledby={titleId}>
  <div class="home-section-frame">
    <div class="home-section-heading" data-reveal-children>
      <hgroup>
        {label && <p class="home-section-label">{label}</p>}
        <h2 id={titleId} class="augur-type-display"><slot name="title" /></h2>
      </hgroup>
      {Astro.slots.has('aside') && <div class="home-section-aside augur-type-body web-lead"><slot name="aside" /></div>}
    </div>
    <div class="home-section-body"><slot /></div>
  </div>
</section>

<style>
  .home-section { padding-top: 112px; background: var(--background); color: var(--foreground); scroll-margin-top: 24px; text-wrap: pretty; }
  .home-section-frame { width: min(1472px, calc(100% - 112px)); margin-inline: auto; }
  .home-section-heading { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 24px 80px; align-items: end; margin-bottom: 56px; }
  .row .home-section-heading { grid-template-columns: 1fr auto; }
  hgroup { display: grid; gap: 14px; }
  .home-section-label { color: var(--muted-foreground); font-size: 13px; }
  h2 { font-size: clamp(36px, 3.5vw, 50px); line-height: 1.1; letter-spacing: -.035em; }
  .home-section-aside { max-width: 540px; color: var(--muted-foreground); }
  .home-section-aside :global(p + p) { margin-top: 12px; }
  .side .home-section-frame { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
  .side .home-section-heading { grid-template-columns: 1fr; align-items: start; margin-bottom: 0; }
  @media (max-width: 1100px) {
    .home-section-frame { width: calc(100% - 80px); }
    .home-section-heading, .side .home-section-frame { gap: 24px 40px; }
  }
  @media (max-width: 760px) {
    .home-section { padding-top: 96px; }
    .home-section-frame { width: calc(100% - 40px); }
    .home-section-heading, .side .home-section-frame { grid-template-columns: 1fr; }
  }
</style>
