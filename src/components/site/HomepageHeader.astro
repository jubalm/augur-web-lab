---
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { buttonVariants } from '../ui/button-variants';
import { communityLinks } from '../../lib/community';
const onContactPage = Astro.url.pathname.replace(/\/$/, '') === '/contact';
const products = [
  { label: 'Augur Lituus', description: 'Resolution for real-world outcomes' },
  { label: 'Zoltar', description: 'Shared foundation for oracles' },
  { label: 'Augur Stratoblast', description: 'Prediction markets on Zoltar' },
];
const resources = [
  { label: 'Blog', description: 'Updates and articles' },
  { label: 'FAQ', description: 'Common questions' },
  { label: 'Learn', description: 'Concepts and guides' },
  { label: 'REP', description: 'Participation and responsibilities' },
];
---
<header class="homepage-header">
  <a class="homepage-brand" href="/" aria-label="Augur home"><Brand /></a>
  <nav aria-label="Main navigation">
    <!-- Product and resource destinations remain unwired placeholders. -->
    <details class="nav-menu" name="homepage-navigation" data-header-menu>
      <summary class="nav-item augur-type-ui">Products <Icon name="chevron-down" /></summary>
      <div class="nav-panel">
        {products.map(product => (
          <a class="nav-panel-item" role="link" aria-disabled="true" tabindex="0">
            <span class="augur-type-ui">{product.label}</span>
            <span class="augur-type-metadata">{product.description}</span>
          </a>
        ))}
      </div>
    </details>
    <a class="nav-item augur-type-ui" role="link" aria-disabled="true" tabindex="0">Developers</a>
    <details class="nav-menu" name="homepage-navigation" data-header-menu>
      <summary class="nav-item augur-type-ui">Resources <Icon name="chevron-down" /></summary>
      <div class="nav-panel">
        {resources.map(resource => (
          <a class="nav-panel-item" role="link" aria-disabled="true" tabindex="0">
            <span class="augur-type-ui">{resource.label}</span>
            <span class="augur-type-metadata">{resource.description}</span>
          </a>
        ))}
      </div>
    </details>
    <details class="nav-menu" name="homepage-navigation" data-header-menu>
      <summary class="nav-item augur-type-ui">Community <Icon name="chevron-down" /></summary>
      <div class="nav-panel">
        {Object.values(communityLinks).map(social => (
          <a class="nav-panel-item community-link" href={social.href}>
            <Icon name={social.icon} />
            <span class="augur-type-ui">{social.name}</span>
            <Icon name="arrow-up-right" />
          </a>
        ))}
      </div>
    </details>
  </nav>
  <div class="header-actions">
    <ThemeToggle />
    <a href="/contact/" class:list={[buttonVariants({ variant: 'outline' }), 'configured-button', 'contact-link']} aria-current={onContactPage ? 'page' : undefined}>Talk to us</a>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-header-menu]').forEach(menu => {
    const summary = menu.querySelector<HTMLElement>('summary')!;
    const abort = new AbortController();
    let openTimer: ReturnType<typeof setTimeout> | undefined;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    const cancel = () => { clearTimeout(openTimer); clearTimeout(closeTimer); };
    const close = () => { cancel(); menu.open = false; };
    menu.addEventListener('pointerenter', event => {
      if (event.pointerType !== 'mouse') return;
      cancel(); openTimer = setTimeout(() => { menu.open = true; }, 100);
    }, { signal: abort.signal });
    menu.addEventListener('pointerleave', event => {
      if (event.pointerType !== 'mouse') return;
      cancel(); closeTimer = setTimeout(() => {
        if (!menu.contains(document.activeElement)) menu.open = false;
      }, 180);
    }, { signal: abort.signal });
    summary.addEventListener('click', cancel, { signal: abort.signal });
    menu.addEventListener('focusout', () => {
      queueMicrotask(() => { if (!menu.contains(document.activeElement)) close(); });
    }, { signal: abort.signal });
    document.addEventListener('pointerdown', event => {
      if (!menu.contains(event.target as Node)) close();
    }, { signal: abort.signal });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        event.preventDefault(); close(); summary.focus({ preventScroll: true });
      }
    }, { signal: abort.signal });
    window.addEventListener('pagehide', event => {
      close(); if (!event.persisted) abort.abort();
    }, { signal: abort.signal });
  });
</script>
<style>
  .homepage-header {
    position: relative; z-index: 10; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 32px;
    width: min(1472px, calc(100% - 112px)); height: 96px; margin-inline: auto;
    border-bottom: 1px solid var(--border-quiet);
  }
  .homepage-brand { justify-self: start; flex: none; text-decoration: none; }
  /* Brand Foundation pp.11–12: 150px minimum, with one a-height of clearspace above and below. */
  .homepage-brand :global(.brand) { width: 150px; }
  .header-actions, nav { display: flex; align-items: center; gap: 32px; }
  .header-actions { justify-self: end; gap: 16px; }
  .contact-link { flex: none; font-size: 16px; }
  .contact-link[aria-current="page"] { --control-border: var(--foreground); }
  .nav-item {
    position: relative; display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; font-size: 16px; line-height: 24px; text-decoration: none; white-space: nowrap;
  }
  .nav-item::after {
    content: ''; position: absolute; bottom: 5px; left: 0; right: 0; height: 1px; background: currentColor;
    transform: scaleX(0); transform-origin: left; transition: transform 180ms ease-out;
  }
  .nav-item:hover::after, .nav-menu[open] > summary::after { transform: scaleX(1); }
  a[aria-disabled] { cursor: pointer; }
  .nav-menu { position: relative; }
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary :global(.web-icon) { width: 14px; height: 14px; transition: transform 180ms ease-out; }
  .nav-menu[open] summary :global(.web-icon) { transform: rotate(180deg); }
  .nav-panel {
    position: absolute; left: -24px; top: calc(100% + 16px); width: 280px; padding: 8px;
    border: 1px solid var(--border-quiet); background: var(--background);
  }
  .nav-panel::before { content: ''; position: absolute; top: -17px; left: 0; right: 0; height: 17px; }
  /* Keep native disclosure behavior; supporting browsers also retain the panel for its exit. */
  @supports selector(details::details-content) and (transition-behavior: allow-discrete) {
    .nav-menu::details-content { transition: content-visibility 180ms allow-discrete; }
    .nav-panel { opacity: 0; transform: translateY(-6px); transition: opacity 180ms ease-out, transform 180ms ease-out; }
    .nav-menu[open] > .nav-panel { opacity: 1; transform: translateY(0); }
    .nav-menu:not([open]) > .nav-panel { pointer-events: none; }
    @starting-style {
      .nav-menu[open] > .nav-panel { opacity: 0; transform: translateY(-6px); }
    }
  }
  .nav-panel-item { display: grid; gap: 5px; padding: 16px; text-decoration: none; transition: background-color 180ms ease-out; }
  .nav-panel-item > .augur-type-ui { font-size: 16px; line-height: 24px; }
  .nav-panel-item + .nav-panel-item { border-top: 1px solid var(--border-quiet); }
  .nav-panel-item > .augur-type-metadata { color: var(--muted-foreground); }
  .nav-panel-item:hover, .nav-panel-item:focus-visible { background: var(--muted); }
  .community-link { grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; }
  .header-actions :global(.theme-toggle) { --control-border: transparent; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--muted-foreground); outline-offset: 6px; }
  .nav-panel-item:focus-visible { outline-offset: -2px; }
  @media (max-width: 1100px) {
    .homepage-header { width: calc(100% - 80px); gap: 24px; }
    nav { gap: 24px; }
  }
  @media (max-width: 700px) {
    .homepage-header { display: flex; justify-content: space-between; width: calc(100% - 40px); height: auto; min-height: 100px; flex-wrap: wrap; padding-block: 20px; gap: 16px; }
    .header-actions, nav { gap: 16px; flex-wrap: wrap; }
    .nav-panel { left: auto; right: -32px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-item::after, summary :global(.web-icon), .nav-panel, .nav-panel-item { transition: none; }
    .nav-menu::details-content { transition: none; }
  }
</style>
