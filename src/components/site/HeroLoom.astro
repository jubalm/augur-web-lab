---
import { staticField } from '../../motion/focus-field-geometry';
const artwork = staticField().map((item, index) => ({ ...item, accent: index % 8 === 0 }))
  .sort((a, b) => Number(a.accent) - Number(b.accent));
---
<div class="hero-loom" data-hero-loom data-renderer="static" data-state="static">
  <div class="hero-loom-stage" data-hero-loom-stage role="img" aria-label="Signal Loom: scattered observations gathering into a focal pattern, while differences remain.">
    <svg class="hero-loom-fallback" data-hero-loom-fallback viewBox="0 0 1000 620" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="hero-loom-accent" gradientUnits="userSpaceOnUse" x1="110" x2="890" y1="0" y2="0">
          <stop offset="0" stop-color="currentColor" />
          <stop offset=".25" stop-color="currentColor" />
          <stop offset=".7" stop-color="var(--primary)" />
          <stop offset="1" stop-color="var(--primary)" />
        </linearGradient>
      </defs>
      {artwork.map(item => <path d={item.path} stroke={item.accent ? 'url(#hero-loom-accent)' : 'currentColor'} stroke-width={item.accent ? '1' : '.7'} opacity={item.accent ? .70 : item.opacity} />)}
    </svg>
    <canvas class="hero-loom-canvas" aria-hidden="true" hidden></canvas>
    <span data-accent-probe aria-hidden="true"></span>
    <span data-background-probe aria-hidden="true"></span>
  </div>
  <p id="hero-loom-instructions" hidden>Move over the strands to bend them. Drag to gently tilt the view horizontally or vertically, or click to redirect their paths. All four arrow keys tilt the view; Enter or Space gently redirects the strands. Escape pauses the animation and clears your trace. Move the pointer or use these keys to resume.</p>
</div>
<script>
  import { mountHeroLoom } from '../../motion/hero-loom';
  document.querySelectorAll<HTMLElement>('[data-hero-loom]').forEach(mountHeroLoom);
</script>
<style>
  .hero-loom { position: relative; width: 100%; height: 100%; }
  .hero-loom-stage { position: absolute; inset: 0; overflow: hidden; color: var(--foreground); pointer-events: none; }
  [data-interactive="true"] .hero-loom-stage { pointer-events: auto; cursor: grab; touch-action: pan-y; }
  [data-dragging="true"] .hero-loom-stage { cursor: grabbing; }
  .hero-loom-stage:focus-visible { outline: 1px solid var(--muted-foreground); outline-offset: -1px; }
  .hero-loom-fallback, .hero-loom-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .8; }
  .hero-loom-canvas[hidden] { display: none; }
  [data-accent-probe], [data-background-probe] { position: absolute; visibility: hidden; }
  [data-accent-probe] { color: var(--primary); }
  [data-background-probe] { background: var(--background); }
</style>
