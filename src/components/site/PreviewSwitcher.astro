---
import { homepages } from '../../lib/content';
import Icon from './Icon.astro';
const route = Astro.url.pathname.replace(/\/$/, '');
---
<button type="button" class="shortcut-trigger" data-open-preview aria-label="Switch website preview" aria-keyshortcuts="Control+k Meta+k">Switch preview · Ctrl K or ⌘ K</button>
<dialog class="preview-dialog" aria-labelledby="preview-title" aria-describedby="preview-description">
  <div class="dialog-heading"><p class="eyebrow muted">Preview navigation</p><button class="close-dialog" type="button" aria-label="Close preview switcher"><Icon name="x" /></button></div>
  <h2 id="preview-title" class="augur-type-heading-1">Website & lab.</h2>
  <p id="preview-description" class="muted">Open the homepage or return to the lab.</p>
  <nav aria-label="Website previews">
    {homepages.map(page => <a href={page.href} aria-current={route === page.href.replace(/\/$/, '') ? 'page' : undefined}><span class="preview-number">0{page.id}</span><span><strong>Homepage</strong><small>{page.description}</small></span></a>)}
    <a href="/lab/homepage-redesign/" class="return-lab" aria-current={route === '/lab/homepage-redesign' ? 'page' : undefined}><span>The Resolution Machine</span><small>Homepage redesign proposal</small></a>
    <a href="/lab" class="return-lab"><span>Augur Web Lab</span><small>Components & appearance</small></a>
  </nav>
  <div class="dialog-foot"><span>Ctrl K or ⌘ K to open</span><span>Esc to close</span></div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.preview-dialog');
  if (dialog) {
    let previous: HTMLElement | null = null;
    const open = () => { if (!dialog.open) { previous = document.activeElement as HTMLElement; dialog.showModal(); } };
    document.querySelectorAll('[data-open-preview]').forEach(button => button.addEventListener('click', open));
    dialog.querySelector('.close-dialog')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
    dialog.addEventListener('close', () => previous?.focus({preventScroll:true}));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && dialog.open) { event.preventDefault(); dialog.close(); return; }
      if ((event.ctrlKey || event.metaKey) && !event.altKey && event.key.toLowerCase() === 'k') {
        event.preventDefault(); if (dialog.open) dialog.close(); else open();
      }
    });
  }
</script>
<style>
  .shortcut-trigger { position: fixed; bottom: 16px; left: 16px; transform: translateY(200%); z-index: 100; padding: 12px 20px; color: var(--foreground); background: var(--background); border: 1px solid var(--border); }
  .shortcut-trigger:focus-visible { transform: none; }
  dialog { width: min(540px, calc(100% - 48px)); padding: 32px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); max-height: calc(100vh - 64px); overflow: auto; }
  dialog::backdrop { background: rgb(0 0 0 / .6); backdrop-filter: blur(10px); }
  .dialog-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .close-dialog { display: grid; place-items: center; width: 40px; height: 40px; color: var(--foreground); background: transparent; border: 0; cursor: pointer; }
  #preview-description { margin-block: 12px 32px; font-size: 14px; }
  nav a { display: flex; align-items: center; gap: 20px; padding: 20px 16px; border-top: 1px solid var(--border-quiet); text-decoration: none; }
  nav a:hover, nav a[aria-current] { background: var(--muted); }
  nav a > :global(.web-icon) { margin-left: auto; }
  .preview-number { font: 400 24px/32px var(--augur-font-primary); color: var(--muted-foreground); }
  strong { display: block; font: 400 16px/24px var(--augur-font-primary); }
  small { display: block; margin-top: 4px; color: var(--muted-foreground); font-size: 12px; }
  .return-lab { margin-top: 16px; font-size: 14px; }
  .return-lab small { margin: 0; }
  .dialog-foot { display: flex; justify-content: space-between; margin-top: 24px; font-size: 12px; color: var(--muted-foreground); }
</style>
