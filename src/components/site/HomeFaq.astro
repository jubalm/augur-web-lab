---
import HomeSection from './HomeSection.astro';
import TextLink from './TextLink.astro';
import Icon from './Icon.astro';

// Answers reviewed September 19, 2026 against: “Augur Is Testing Its Past and Building Its Future”
// (July 21, 2026), the Q1 2026 report (July 2, 2026), the Moon Fork report (August 5, 2026) and the
// January 2026 Augur Lituus whitepaper. The full FAQ page is planned, so its link stays inert.
const faqs = [
  {
    question: 'How does today’s Augur relate to its earlier prediction markets?',
    answer: 'Augur launched on Ethereum in 2018 as a decentralized prediction market protocol, with REP holders settling disputed outcomes. Augur v2 still runs today, and in August 2026 its fork mechanism completed its first live run. Augur Lituus, the next generation of Augur’s oracle, is designed to resolve questions for other prediction markets and applications, not only Augur’s own.',
  },
  {
    question: 'What role does REP play?',
    answer: 'REP secures Augur’s oracle. Participants back answers and challenges with REP bonds, and if a dispute reaches a fork, holders migrate their REP to the universe they believe reflects reality. Augur Lituus is being built around REPv2_Yes_1, the REP that migrated to the winning universe in the Moon Fork.',
  },
  {
    question: 'Can I build with Augur today?',
    answer: 'Not yet. ChainSafe is implementing Augur Lituus in the public Lituus-CS repository, and it still needs testing, audits and documentation before applications can depend on it.',
    contact: true,
  },
];
---
<HomeSection id="faq" layout="side">
  <Fragment slot="title">Common questions</Fragment>
  <p slot="aside" class="all-faqs"><TextLink>View all FAQs</TextLink></p>

  <div class="faq-list" data-reveal-children>
    {faqs.map(faq => (
      <details>
        <summary class="augur-type-heading-2">{faq.question}<Icon name="plus" /></summary>
        <p class="faq-answer">{faq.answer}{faq.contact && <> Exploring a use case? <TextLink href="/contact/">Talk to us</TextLink>.</>}</p>
      </details>
    ))}
  </div>
</HomeSection>

<style>
  .all-faqs { font-size: 15px; font-weight: 600; }
  .faq-list { border-bottom: 1px solid var(--border-quiet); }
  details { border-top: 1px solid var(--border-quiet); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 76px; padding-block: 18px; cursor: pointer; list-style: none; font-size: 19px; line-height: 1.4; letter-spacing: -.01em; }
  summary::-webkit-details-marker { display: none; }
  summary :global(.web-icon) { width: 18px; height: 18px; color: var(--muted-foreground); }
  summary:hover :global(.web-icon), details[open] summary :global(.web-icon) { color: var(--foreground); }
  details[open] summary :global(.web-icon) { transform: rotate(45deg); }
  summary:focus-visible { outline: 2px solid var(--foreground); outline-offset: 4px; }
  .faq-answer { max-width: 60ch; padding: 0 48px 28px 0; color: var(--muted-foreground); font-size: 16px; line-height: 1.65; }
  @media (prefers-reduced-motion: no-preference) { summary :global(.web-icon) { transition: transform 180ms ease, color 180ms ease; } }
</style>
