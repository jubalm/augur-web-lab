---
// Structure review: reserves the space for a planned animation and says what it should show.
// The adjacent copy carries the meaning, so the finished animation can replace this figure as
// decoration. Deliberately static: no idle motion before the real piece is designed.
// inset: a borderless stage inside a card. The brief stays in source for the animator but is not shown.
interface Props { inset?: boolean; }
const { inset = false } = Astro.props;
---
<figure class:list={['animation-placeholder', { inset }]}>
  <figcaption>
    <span class="placeholder-label">Animation placeholder</span>
    <span class="placeholder-brief"><slot /></span>
  </figcaption>
</figure>

<style>
  .animation-placeholder {
    --placeholder-dot: color-mix(in srgb, var(--foreground) 22%, transparent);
    position: relative; isolation: isolate; display: grid; aspect-ratio: 3 / 2; overflow: clip;
    border: 1px dashed color-mix(in srgb, var(--foreground) 24%, var(--background));
    background: color-mix(in srgb, var(--foreground) 3%, var(--background));
  }
  /* A field of small squares, after the hero's grid, marks the stage and fades toward the edges. */
  .animation-placeholder::before {
    content: ''; position: absolute; z-index: -1; inset: 0;
    background: conic-gradient(at 2px 2px, transparent 75%, var(--placeholder-dot) 0) center / 20px 20px;
    mask-image: radial-gradient(closest-side, #000 25%, transparent);
  }
  .inset { aspect-ratio: auto; border: 0; background: transparent; }
  .inset::before { mask-image: linear-gradient(to bottom, #000 15%, transparent); }
  .inset .placeholder-brief { display: none; }
  figcaption { display: grid; align-content: space-between; justify-items: start; gap: 16px; padding: 16px 20px 18px; }
  .placeholder-label {
    display: inline-flex; align-items: center; gap: 8px; padding: 5px 10px;
    border: 1px solid var(--border-quiet); background: var(--background); color: var(--muted-foreground);
    font: 400 11px/16px var(--augur-font-secondary); white-space: nowrap;
  }
  .placeholder-label::before { content: ''; width: 7px; height: 8px; background: var(--primary); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .placeholder-brief { max-width: 34ch; color: var(--muted-foreground); font-size: 13px; line-height: 1.55; text-wrap: pretty; }
</style>
