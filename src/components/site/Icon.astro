---
interface Props { name: string; class?: string; weight?: 'light' | 'regular' | 'bold' | 'fill'; }
const { name, class: className, weight = 'bold' } = Astro.props;
const icons = import.meta.glob('../../assets/icons/phosphor/*/*.svg', { query: '?raw', import: 'default', eager: true });
const variants = [weight].map(variant => {
  const markup = icons[`../../assets/icons/phosphor/${variant}/${name}.svg`] as string | undefined;
  if (!markup) throw new Error(`Unknown Phosphor icon: ${name} ${variant}`);
  return {variant,markup};
});
---
<span class:list={['web-icon', className]} data-fixed-weight={weight} aria-hidden="true">{variants.map(({variant,markup})=><span data-glyph={variant} set:html={markup} />)}</span>
