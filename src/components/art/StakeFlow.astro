---
import Icon from '../primitives/Icon.astro';
/** Optional REP actions as stake flows: what you put at stake, the condition,
 * and what comes back. Payouts follow the January 2026 whitepaper (§4.0.2,
 * §4.3.1: winners receive 80% of losing bonds, so the copy says “most”).
 * Square sizes are proportional: a bond is one 32 px square, a challenge posts
 * two, “most of theirs” is 80% of one bond’s area and a fee share is smaller.
 * Owner feedback (6 Oct 2026): icons and visuals, not just text, and rows rather
 * than a second set of three boxes after the tenets. Each row: icon and action,
 * the flow drawn large as its illustration, then the text. */
type Block = { kind: 'bond' | 'gain' | 'fee' | 'lost'; count?: number };
type Group = { blocks: Block; caption: string };
const rows: { title: string; icon: string; text: string; summary: string; stake: Group; condition: string; outcome: Group[] }[] = [
 { title: 'Report', icon: 'flag', text: 'Back an answer with a REP bond. If no one challenges it, you get the bond back plus part of the query fee.',
   summary: 'Your bond; if no one challenges, your bond comes back plus a share of the fee.',
   stake: { blocks: { kind: 'bond' }, caption: 'Your bond' }, condition: 'No challenge',
   outcome: [{ blocks: { kind: 'bond' }, caption: 'Bond back' }, { blocks: { kind: 'fee' }, caption: 'Fee share' }] },
 { title: 'Challenge', icon: 'scales', text: 'Post double the bond against a wrong answer. If yours holds, you also win most of theirs.',
   summary: 'Double the bond; if your answer holds, it comes back plus most of theirs.',
   stake: { blocks: { kind: 'bond', count: 2 }, caption: 'Double bond' }, condition: 'Your answer holds',
   outcome: [{ blocks: { kind: 'bond', count: 2 }, caption: 'Bond back' }, { blocks: { kind: 'gain' }, caption: 'Most of theirs' }] },
 { title: 'Risk', icon: 'warning', text: 'If your answer is overturned, you lose the bond. Most of it goes to whoever was right.',
   summary: 'Your bond; if your answer is overturned, the bond is lost.',
   stake: { blocks: { kind: 'bond' }, caption: 'Your bond' }, condition: 'Overturned',
   outcome: [{ blocks: { kind: 'lost' }, caption: 'Bond lost' }] },
];
/** Winnings squares are numbered across a row's outcome for their motion ids. */
const gainIndex = (row: typeof rows[number], group: number) => row.outcome.slice(0, group).filter(item => item.blocks.kind === 'gain' || item.blocks.kind === 'fee').length;
---
<ol class="stake-flows">
 {rows.map((row,ri)=><li class="stake-row" data-stake-row>
  <div class="stake-head"><span class="stake-icon" aria-hidden="true"><Icon name={row.icon}/></span><h3>{row.title}</h3></div>
  <div class="stake-flow" role="img" aria-label={row.summary}>
   <span class="flow-group" data-stake><span class="blocks">{Array.from({length:row.stake.blocks.count??1},()=> <i class="bond"></i>)}</span><span class="flow-caption">{row.stake.caption}</span></span>
   <span class="flow-link"><span class="flow-condition" data-condition>{row.condition}</span><span class="flow-line" data-line><svg class="flow-arrow" aria-hidden="true"><line x1="0" y1="8" x2="100%" y2="8"/><svg x="100%" y="8" overflow="visible"><path d="M-7 -6L0 0L-7 6"/></svg></svg></span></span>
   <span class="flow-outcome">{row.outcome.map((group,index)=><>{index>0&&<span class="flow-plus" data-gain>+</span>}<span class="flow-group" data-outcome={group.blocks.kind}><span class="blocks" data-motion={group.blocks.kind==='gain'||group.blocks.kind==='fee'?`rep-${ri}-gain-${gainIndex(row,index)}`:undefined}>{Array.from({length:group.blocks.count??1},()=> <i class={group.blocks.kind}>{group.blocks.kind==='lost'&&<span class="flow-flash" data-motion={`rep-${ri}-flash`}></span>}</i>)}</span><span class="flow-caption">{group.caption}</span></span></>)}</span>
   <span class="flow-glide" data-motion={`rep-${ri}-glide`}><span class="blocks flow-ghost" data-motion={`rep-${ri}-ghost`}>{Array.from({length:row.stake.blocks.count??1},()=> <i class="bond"></i>)}</span></span>
  </div>
  <p>{row.text}</p>
 </li>)}
</ol>
<style>
 /* Rows, not tiles (owner, 6 Oct 2026: the tenets already use three boxes). Each row reads
    icon and action, then the flow as its illustration, then the text, between hairlines. */
 .stake-flows{list-style:none;margin:0;padding:0;border-bottom:1px solid var(--web-outline)}
 .stake-row{--axis:44px;display:grid;grid-template-columns:240px minmax(0,1fr) 380px;column-gap:48px;align-items:start;padding-block:36px;border-top:1px solid var(--web-outline)}
 .stake-head{display:flex;align-items:center;gap:16px;margin-top:calc(var(--axis) - 24px)}
 .stake-icon{display:grid;place-items:center;width:48px;height:48px;flex:none;background:var(--web-tile);color:var(--foreground);transition:color 180ms ease-out,background-color 180ms ease-out}
 .stake-icon :global(.web-icon),.stake-icon :global(svg){width:24px;height:24px}
 .stake-row:hover .stake-icon{color:var(--primary);background:var(--web-raised)}
 .stake-row h3{font:600 24px/32px var(--font-heading);margin:0}
 .stake-row>p{color:var(--muted-foreground);font-size:18px;line-height:28px;margin:calc(var(--axis) - 14px) 0 0}
 /* Fixed outer columns keep every row's line the same length and its outcome aligned, on phones
    too (76 and 168 px fit Double bond and Challenge's outcome); the condition is centred above the
    arrow. One axis runs through each row: icon, title, squares, arrow and the text's first line. Squares are proportional (a bond is 40 px). */
 .stake-flow{--outcome:236px;position:relative;display:grid;grid-template-columns:92px minmax(64px,1fr) var(--outcome);grid-template-rows:auto auto;align-items:start;column-gap:12px;row-gap:6px;min-width:0}
 .flow-group{display:flex;flex-direction:column;align-items:flex-start;gap:10px;flex:none}
 .blocks{display:flex;align-items:center;gap:6px;height:40px}
 .blocks i{position:relative;display:block;flex:none}
 .bond{width:40px;height:40px;background:var(--foreground)}
 .gain{width:36px;height:36px;background:var(--primary)}
 .fee{width:20px;height:20px;background:var(--primary)}
 .lost{width:40px;height:40px;border:1.5px dashed var(--mark-participant)}
 .flow-caption{font-size:13px;line-height:18px;color:var(--muted-foreground);white-space:nowrap}
 .flow-link{display:contents}
 .flow-condition{grid-column:2;grid-row:1;justify-self:center;text-align:center;font:600 13px/18px var(--font-heading);color:var(--foreground);white-space:nowrap}
 [data-stake]{grid-column:1;grid-row:2}.flow-outcome{grid-column:3;grid-row:2}
 .flow-line{grid-column:2;grid-row:2;display:block;height:16px;margin-top:12px}
 /* The arrow (owner's pick, 6 Oct 2026): line and head at one 1.5 px weight in Mist; the head is
    drawn from the right edge so it keeps its shape at any length. The entrance draws the line. */
 .flow-arrow{display:block;width:100%;height:16px;overflow:visible;fill:none;stroke:var(--mark-participant);stroke-width:1.5;stroke-linecap:square;stroke-linejoin:miter}.flow-arrow line{transform-box:fill-box;transform-origin:0 50%}
 .flow-outcome{display:flex;align-items:flex-start;gap:12px;flex:none}
 .flow-plus{height:40px;display:flex;align-items:center;font:400 20px/1 var(--font-heading);color:var(--muted-foreground)}
 .flow-group[data-outcome] .blocks i{transform-origin:center}
 /* Ambient loop (rep-choreography.ts): a copy of the stake glides along the arrow on .flow-glide,
    which spans from the stake to the outcome column (the flow minus --outcome) and slides its own
    width, so the copy lands on the returned bond at any width; the lost bond's outline flashes.
    Hidden at rest, so the static artwork is the no-JavaScript, reduced-motion and print state. */
 .flow-glide{position:absolute;left:0;top:24px;width:calc(100% - var(--outcome));pointer-events:none}.flow-ghost{position:absolute;left:100%;top:0;opacity:0}
 .flow-flash{position:absolute;inset:-1.5px;border:1.5px dashed var(--foreground);opacity:0;pointer-events:none}
 @media(max-width:1279px){.stake-row{grid-template-columns:200px minmax(0,1fr);row-gap:20px;column-gap:40px}.stake-row>p{grid-column:2;margin-top:0}.stake-flow{max-width:560px}}
 @media(max-width:767px){.stake-row{grid-template-columns:1fr;padding-block:28px}.stake-head{margin-top:0}.stake-row>p{grid-column:auto}.stake-flow{--outcome:168px;grid-template-columns:76px minmax(28px,1fr) var(--outcome);column-gap:10px;max-width:none}.blocks{height:28px;gap:4px}.bond,.lost{width:28px;height:28px}.gain{width:25px;height:25px}.fee{width:14px;height:14px}.flow-plus{height:28px;font-size:16px}.flow-caption{font-size:12px;line-height:16px}.flow-outcome{gap:8px}.flow-line{margin-top:6px}.stake-icon{width:40px;height:40px}.stake-icon :global(.web-icon),.stake-icon :global(svg){width:20px;height:20px}}
 @media(prefers-reduced-motion:reduce){.stake-icon{transition:none}}
 @media(forced-colors:active){.bond,.gain,.fee{background:CanvasText;forced-color-adjust:none}.lost,.flow-flash{border-color:CanvasText}.flow-arrow{stroke:CanvasText}}
</style>
