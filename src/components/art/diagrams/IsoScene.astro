---
import { isoScenes, blockFaces, quadPoints, gridLines, floorColors, type IsoKind, type Item, type Point } from '../../../data/tenets-iso';
// The /2/ Why Augur cards' isometric scenes (owner, 22 Oct 2026). Geometry and the resting frame come from
// tenets-iso.ts; tenets-iso-v2.js plays the loop on the `data-iso` ids. No <style> or <script> here: the
// styles are in home-v2-only.css and the driver is inline on /2/ only, so "/" is unchanged.
interface Props { kind: IsoKind; }
const { kind } = Astro.props;
const scene = isoScenes[kind];
const o = scene.origin;
const tones = { muted: 'iso-label', green: 'iso-label iso-green', count: 'iso-count', 'count-green': 'iso-count iso-green' } as const;
const at = (item: { id?: string; opacity?: number }) => ({ 'data-iso': item.id, opacity: item.opacity === undefined ? undefined : String(item.opacity) });
const moveOf = (item: Item) => item.type === 'block' && item.move ? item.move.join(' ') : undefined;
const line = ([a, b]: [Point, Point]) => ({ x1: +a[0].toFixed(2), y1: +a[1].toFixed(2), x2: +b[0].toFixed(2), y2: +b[1].toFixed(2) });
---
<svg viewBox="0 0 336 168" width="336" height="168" class="tenet-diagram tenet-iso" data-iso-scene={kind} aria-hidden="true">
  {(function render(items: Item[]): any { return items.map(item => {
    if (item.type === 'group') return <g data-iso={item.id}>{render(item.items)}</g>;
    if (item.type === 'quad') return <polygon {...at(item)} points={quadPoints(o, item.x, item.y, item.w, item.d)} fill={item.fill}/>;
    if (item.type === 'grid') return <g stroke={floorColors.grid} stroke-width="1">{gridLines(o, item.x, item.y, item.w, item.d, item.step).map(pair => <line {...line(pair)}/>)}</g>;
    if (item.type === 'label') return <text {...at(item)} x={item.at[0]} y={item.at[1]} text-anchor={item.anchor ?? 'start'} class={tones[item.tone ?? 'muted']}>{item.text.toUpperCase()}</text>;
    const faces = blockFaces(o, item);
    const edge = item.material.edge;
    return <g {...at(item)} data-move={moveOf(item)} class="iso-block" stroke-linejoin="round">
      <polygon points={faces.left} fill={item.material.left} stroke={edge ?? item.material.left} stroke-width={edge ? 1 : .6}/>
      <polygon points={faces.right} fill={item.material.right} stroke={edge ?? item.material.right} stroke-width={edge ? 1 : .6}/>
      <polygon points={faces.top} fill={item.material.top} stroke={edge ?? item.material.top} stroke-width={edge ? 1 : .6}/>
    </g>;
  }); })(scene.items)}
</svg>
