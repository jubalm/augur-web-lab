---
import { peerMesh as diagram } from '../../../data/diagrams';
const highlightedLinks=diagram.highlight.slice(1).map((next,i)=>{
  const [x,y]=diagram.participants[diagram.highlight[i]!];const [x2,y2]=diagram.participants[next];
  return [x+10,y+10,x2+10,y2+10];
});
---
<svg viewBox="0 0 336 168" width="336" height="168" class="tenet-diagram" data-mesh aria-hidden="true">
  {diagram.links.map(([x1,y1,x2,y2])=><path data-link d={`M${x1} ${y1}L${x2} ${y2}`} pathLength="1" stroke="var(--primary)" opacity=".45" stroke-width="1"/>)}
  {diagram.participants.map(([x,y])=><rect data-participant x={x} y={y} width="20" height="20" fill="var(--mark-participant, #71728A)"/>)}
  {highlightedLinks.map(([x1,y1,x2,y2],i)=><path data-mesh-glow-link={i} d={`M${x1} ${y1}L${x2} ${y2}`} stroke="var(--primary)" opacity="0" stroke-width="2" style="filter:drop-shadow(0 0 6px rgb(42 231 168 / .9))"/>)}
  {diagram.highlight.map((index,i)=>{const [x,y]=diagram.participants[index];return <rect data-mesh-glow={i} x={x} y={y} width="20" height="20" opacity="0" fill="var(--primary)" style="filter:drop-shadow(0 0 18px rgb(42 231 168 / .6))"/>;})}
</svg>
