---
import { twoRoads, type SvgNode } from '../../../data/two-roads';
import glyphMaster from '../../../../public/brand/kit/glyph/augur-glyph-reversed.svg?raw';
// The /2/ Permissionless card, Two roads in cubes (owner, 22 Oct 2026). two-roads.ts builds the drawing at
// its resting frame and the loop's keyframes; tenets-iso-v2.js plays them on the `data-iso` ids. The Augur
// glyph painted on the Augur Lituus road is the supplied reversed master: its paths go into the drawing's
// `roads-glyph` group unchanged, as on the Brand page. No <style> or <script> here: the styles are in
// home-v2-only.css and the driver is inline on /2/ only, so "/" is unchanged.
const glyphPaths = glyphMaster.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg viewBox="0 0 336 168" width="336" height="168" class="tenet-diagram tenet-iso" data-iso-scene="roads" aria-hidden="true">
  <g transform={twoRoads.transform}>{(function render(nodes: SvgNode[]): any { return nodes.map(({ tag, attrs, children }) => {
    if (attrs.class === 'roads-glyph') return <g {...attrs} set:html={glyphPaths}/>;
    const Tag = tag as any;
    return children ? <Tag {...attrs}>{render(children)}</Tag> : <Tag {...attrs}/>;
  }); })(twoRoads.world)}</g>
</svg>
