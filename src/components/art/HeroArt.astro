---
import {heroSquares} from '../../data/hero-art';
import {heroTimeline} from '../../motion/timelines';
// Rings 1 (inner) to 7 (outer) sit about 42 px apart around the empty centre.
const rings=[...new Set(heroSquares.map(s=>s.ring))].sort((a,b)=>b-a);
---
<svg class="hero-art" width="572" height="457" viewBox="0 0 572 457" aria-hidden="true" focusable="false" data-hero-art>
 <rect class="orbit" x="244" y="186.5" width="84" height="84" fill="none" stroke="var(--web-outline)" style={`--start:${heroTimeline.orbit.start}ms;--duration:${heroTimeline.orbit.end-heroTimeline.orbit.start}ms`}/>
 {rings.map(ring=><g class="hero-ring" data-ring={ring}>{heroSquares.filter(s=>s.ring===ring).map(s=><rect class="hero-participant" x={s.x} y={s.y} width={s.size} height={s.size} fill={s.fill} fill-opacity={s.opacity} style={`--dx:${s.dx}px;--dy:${s.dy}px;--start:${s.start*1000}ms;--move:${heroTimeline.squareMove}ms;--fade:${heroTimeline.squareFade}ms`}/>)}</g>)}
 <rect class="empty-centre" x="270" y="212.5" width="32" height="32" fill="none" stroke="var(--primary)" stroke-width="2" stroke-dasharray="4 4" style={`--start:${heroTimeline.centre.start}ms;--duration:${heroTimeline.centre.end-heroTimeline.centre.start}ms`}/>
</svg>
<script>import {initHeroAmbient} from '../../motion/hero-ambient';document.querySelectorAll<SVGSVGElement>('[data-hero-art]').forEach(initHeroAmbient);</script>
<style>
.hero-art{display:block;width:100%;height:auto;overflow:visible}
:global([data-hero-arrival=entering]) .hero-participant{animation:arrive-square calc(var(--move) * var(--hero-motion-factor,1)) var(--ease-reveal) calc(var(--start) * var(--hero-motion-factor,1)) backwards,fade-square calc(var(--fade) * var(--hero-motion-factor,1)) var(--ease-reveal) calc(var(--start) * var(--hero-motion-factor,1)) backwards}
:global([data-hero-arrival=entering]) :is(.orbit,.empty-centre){animation:reveal-art calc(var(--duration) * var(--hero-motion-factor,1)) var(--ease-reveal) calc(var(--start) * var(--hero-motion-factor,1)) backwards}
@keyframes arrive-square{from{transform:translate(var(--dx),var(--dy))}to{transform:none}}
@keyframes fade-square{from{opacity:.2}to{opacity:1}}
@keyframes reveal-art{from{opacity:0}to{opacity:1}}
/* Ambient wave (hero-ambient.ts): each ring draws in towards the empty centre
   in turn and the dashed centre answers. Scale is about the centre, so outer
   rings move furthest. The script creates these effects only for the active
   2.4 s of each 8 s cycle, so the page is idle between waves. */
.hero-ring{transform-box:view-box;transform-origin:286px 228.5px}
.hero-ring rect{transition:fill 180ms ease-out,fill-opacity 180ms ease-out,opacity 180ms ease-out}
/* Pointer highlight: the ring under the pointer turns Paper; the others recede. */
.hero-art[data-hover-ring] .hero-ring rect{opacity:.5}
.hero-art[data-hover-ring="1"] [data-ring="1"] rect,.hero-art[data-hover-ring="2"] [data-ring="2"] rect,.hero-art[data-hover-ring="3"] [data-ring="3"] rect,.hero-art[data-hover-ring="4"] [data-ring="4"] rect,.hero-art[data-hover-ring="5"] [data-ring="5"] rect,.hero-art[data-hover-ring="6"] [data-ring="6"] rect,.hero-art[data-hover-ring="7"] [data-ring="7"] rect{opacity:1;fill:var(--foreground);fill-opacity:1}
@media(prefers-reduced-motion:reduce){.hero-ring rect{transition:none}}
</style>
