---
interface Props { name: string; class?: string; }
const { name, class: className } = Astro.props;
const icons = import.meta.glob('../../assets/icons/phosphor/bold/*.svg', { query: '?raw', import: 'default', eager: true });
const markup = icons[`../../assets/icons/phosphor/bold/${name}.svg`] as string | undefined;
if (!markup) throw new Error(`Unknown Phosphor Bold icon: ${name}`);
---
<span class:list={['web-icon', className]} data-fixed-weight="bold" aria-hidden="true"><span data-glyph="bold" set:html={markup} /></span>
