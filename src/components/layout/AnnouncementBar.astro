---
import {site} from '../../data/site';
import {links} from '../../data/links';
const enabled=site.announcement.enabled&&(!site.announcement.until||Date.parse(site.announcement.until)>Date.now());
---
{enabled&&<aside class="announcement" aria-label="Latest Augur update"><div><strong>Augur is back.</strong><span>Restarted in 2025, forked in August 2026, building Augur Lituus now.</span><a href={links.q2Report.url}>Catch up →</a></div></aside>}
<style>
.announcement{min-height:40px;background:var(--web-raised);display:flex;align-items:center;justify-content:center;font:400 14px/20px var(--font-body)}
.announcement>div{display:flex;align-items:center;justify-content:center;gap:10px;padding:10px 24px}
strong{font:600 14px/20px var(--font-heading);white-space:nowrap}strong::before{content:'';display:inline-block;width:6px;height:6px;background:var(--primary);margin-right:10px;vertical-align:middle}
span{color:var(--muted-foreground)}a{margin-left:16px;text-decoration:none;white-space:nowrap}a:hover{text-decoration:underline}
@media(max-width:767px){.announcement>div{padding:10px 20px;flex-wrap:wrap;gap:4px 10px}span{order:3;text-align:center;width:100%}a{margin-left:0}}
</style>
