---
import Brand from '../primitives/Brand.astro';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import HeritageField from '../art/HeritageField.astro';
import {navigationGroups,type NavigationItem} from '../../data/navigation';
import {links} from '../../data/links';
import {site} from '../../data/site';
---
<footer class="site-footer">
  <section class="contact-band" aria-labelledby="contact-title">
    <HeritageField seed={2026} width={1440} height={424} id="footer-field" />
    <div class="container contact-columns">
      <div class="contact-copy"><h2 id="contact-title">Talk to the Augur team.</h2><p>Tell us what your application needs, ask about the protocol, or share feedback.</p><Button href="/contact/">Talk to us</Button></div>
      <div class="newsletter"><h3 id="newsletter-title">Follow Augur's progress</h3><p>Research, development and product updates.</p>
        <form class="newsletter-form" action={site.newsletter.provider ?? undefined} method={site.newsletter.provider ? 'post' : 'dialog'} aria-labelledby="newsletter-title" data-newsletter={site.newsletter.provider ? undefined : 'prototype'}>
          <div class="newsletter-row"><div class="field"><label for="newsletter-email">Email address</label><input type="email" id="newsletter-email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required maxlength="254" aria-describedby="newsletter-email-error" /></div><Button type="submit" variant="outline">Subscribe</Button></div>
          <p class="field-error" id="newsletter-email-error" hidden></p>
          <p class="newsletter-status" role="status" aria-live="polite" data-newsletter-status></p>
        </form></div>
    </div>
  </section>
  <div class="container directory"><div class="identity"><a href="/" aria-label="Augur home"><Brand /></a><p>Augur's work is funded and coordinated by the Lituus Foundation.</p><a href={links.contact.url}>contact@augur.net</a></div>{navigationGroups.map(group=><nav aria-label={`Footer ${group.label}`}><h3>{group.label}</h3><ul>{group.items.map(item=><li><a href={item.href}>{(item as NavigationItem).logo&&<Icon name={(item as NavigationItem).logo!} class="social-logo"/>}{item.label}{('external' in item && item.external)&&<Icon name="arrow-up-right"/>}</a></li>)}</ul></nav>)}</div>
</footer>
<script>
 // Visual prototype: no subscription provider is configured, so the form validates
 // locally and says plainly that nothing was sent. method="dialog" keeps the
 // no-JavaScript submission local as well.
 const form=document.querySelector<HTMLFormElement>('[data-newsletter=prototype]');
 if(form){
  form.noValidate=true;
  const input=form.querySelector<HTMLInputElement>('input[type=email]')!;
  const error=form.querySelector<HTMLElement>('#newsletter-email-error')!;
  const status=form.querySelector<HTMLElement>('[data-newsletter-status]')!;
  const validate=()=>{
   const value=input.value.trim();
   const message=!value?'Enter your email address.':input.validity.typeMismatch||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)?'Enter a valid email address, like you@example.com.':'';
   error.textContent=message;error.hidden=!message;input.setAttribute('aria-invalid',String(Boolean(message)));
   return !message;
  };
  input.addEventListener('blur',()=>{if(input.value.trim()||input.getAttribute('aria-invalid')==='true')validate();});
  input.addEventListener('input',()=>{status.replaceChildren();if(input.getAttribute('aria-invalid')==='true')validate();});
  form.addEventListener('submit',event=>{
   event.preventDefault();status.replaceChildren();
   if(!validate()){input.focus();return;}
   const blog=document.createElement('a');blog.href='/blog/';blog.textContent='Follow the blog';
   status.append('Email sign-up isn’t connected yet, so nothing was sent or saved. ',blog,' for updates in the meantime.');
  });
 }
</script>
<style>
.contact-band{position:relative;min-height:424px;display:flex;align-items:center;overflow:hidden}
.contact-columns{position:relative;display:grid;grid-template-columns:560fr 608fr;gap:80px;padding-block:72px}
.contact-copy h2{margin-bottom:16px}.contact-copy p{font-size:18px;line-height:28px;color:var(--muted-foreground);max-width:540px;margin-bottom:24px}
.newsletter h3{font-size:20px;line-height:26px;margin-bottom:12px}.newsletter>p{color:var(--muted-foreground);margin-bottom:24px}
.newsletter-row{display:flex;align-items:flex-end;gap:12px}.newsletter .field{flex:1;gap:12px}.newsletter .field>label{font-weight:400}.newsletter .field input{background:var(--web-tile)}
.newsletter .field-error{margin-top:12px}.newsletter-status{margin-top:12px;font-size:14px;line-height:20px;color:var(--muted-foreground)}.newsletter-status:empty{display:none}.newsletter-status a{color:var(--foreground)}
.directory{border-top:1px solid var(--web-outline);padding-top:40px;padding-bottom:64px;display:grid;grid-template-columns:minmax(220px,1fr) repeat(4,176px);gap:48px}
.identity{display:flex;flex-direction:column;gap:24px;align-items:flex-start}.identity p{font-size:14px;line-height:22px;color:var(--muted-foreground);max-width:264px}
.directory h3{font-size:14px;line-height:20px;color:var(--muted-foreground);margin-bottom:16px}.directory ul{list-style:none;padding:0;margin:0}.directory a{text-decoration:none}.directory li a{display:flex;align-items:center;gap:4px;min-height:38px;line-height:24px}.directory a:hover{text-decoration:underline}.directory :global(.web-icon),.directory :global(.web-icon svg){width:14px;height:14px}
/* Community destinations carry their logo before the name. */
.directory :global(.social-logo),.directory :global(.social-logo svg){width:18px;height:18px}.directory :global(.social-logo){margin-right:6px;color:var(--muted-foreground);transition:color 180ms ease-out}.directory a:hover :global(.social-logo){color:var(--foreground)}
@media(max-width:1250px){.directory{grid-template-columns:1.5fr repeat(4,1fr);gap:24px}}
@media(max-width:1023px){.contact-columns{grid-template-columns:1fr 1fr;gap:48px}.directory{grid-template-columns:repeat(4,1fr)}.identity{grid-column:1/-1;max-width:440px}}
@media(max-width:767px){.contact-columns{grid-template-columns:1fr;gap:48px;padding-block:64px}.contact-band{min-height:0}.directory{grid-template-columns:repeat(2,1fr);gap:32px}.directory li a{min-height:44px}.newsletter-row{flex-direction:column;align-items:stretch}}
</style>
