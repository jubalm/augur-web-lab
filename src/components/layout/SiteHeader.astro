---
import Brand from '../primitives/Brand.astro';
import Icon from '../primitives/Icon.astro';
import Button from '../primitives/Button.astro';
import {navigation,navigationGroups,type NavigationItem} from '../../data/navigation';
const groups=[{label:'Products',items:navigation.products},{label:'Resources',items:navigation.resources},{label:'Community',items:navigation.community}];
const path=Astro.url.pathname;
// Current section: a page and everything below it (blog posts under /blog/).
const within=(href:string)=>{const page=href.split('#')[0]!;return !href.startsWith('http')&&page!=='/'&&path.startsWith(page);};
const isCurrent=(href:string)=>within(href)&&!href.includes('#');
---
<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a href="/" aria-label="Augur home" class="logo"><Brand /></a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/about/" class="nav-link" aria-current={isCurrent('/about/')?'page':undefined}>About</a>
      {groups.map((group,index)=><details class="nav-disclosure" name="site-nav" data-nav-disclosure data-current={group.items.some(item=>within(item.href))?'':undefined}><summary aria-controls={`nav-${index}`} aria-expanded="false">{group.label}<Icon name="chevron-down" /></summary><div class="nav-panel" id={`nav-${index}`}><ul>{group.items.map(item=><li><a href={item.href} aria-current={isCurrent(item.href)?'page':undefined}>{(item as NavigationItem).icon&&<Icon name={(item as NavigationItem).icon!} class="nav-logo"/>}<span>{item.label}</span>{('external' in item && item.external)&&<Icon name="arrow-up-right" class="nav-external"/>}</a></li>)}</ul></div></details>)}
    </nav>
    <div class="header-actions"><Button href="/contact/" variant="outline">Talk to us</Button><button class="mobile-open" type="button" aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded="false" data-mobile-open><Icon name="list" /></button></div>
  </div>
  <dialog id="mobile-navigation" class="mobile-navigation" aria-labelledby="mobile-nav-title">
    <div class="mobile-top"><a href="/" aria-label="Augur home"><Brand/></a><h2 id="mobile-nav-title" class="sr-only">Navigation</h2><button type="button" aria-label="Close navigation" data-mobile-close><Icon name="x"/></button></div>
    <nav aria-label="Mobile navigation">{navigationGroups.map(group=><div class="mobile-group"><h3>{group.label}</h3><ul>{group.items.map(item=><li><a href={item.href}>{item.label}{('external' in item && item.external)&&<Icon name="arrow-up-right"/>}</a></li>)}</ul></div>)}</nav>
  </dialog>
  <noscript><nav class="fallback-nav" aria-label="Navigation">{navigationGroups.flatMap(group=>group.items).map(item=><a href={item.href}>{item.label}{('external' in item && item.external)?' ↗':''}</a>)}</nav></noscript>
</header>
<script>import {initNavigation} from '../../motion/disclosure-nav';initNavigation();</script>
<style>
.site-header{height:96px;background:var(--background);border-bottom:1px solid var(--border-quiet);position:relative;z-index:20}
.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between;gap:32px}
.desktop-nav{display:flex;gap:32px;align-items:center;font:400 16px/24px var(--font-heading)}
.nav-link,summary{position:relative;display:flex;gap:8px;align-items:center;min-height:48px;text-decoration:none;cursor:pointer;list-style:none;text-underline-offset:6px;text-decoration-thickness:1px}
summary::-webkit-details-marker{display:none}summary :global(.web-icon){width:16px;height:16px;transition:transform 180ms var(--ease-reveal)}summary :global(svg){width:16px;height:16px}
.nav-disclosure[open] summary :global(.web-icon){transform:rotate(180deg)}
.nav-link:hover,summary:hover,.nav-disclosure[open]>summary{text-decoration:underline}
/* Current section: a 2 px Green rule on the header's bottom edge under the item. */
.nav-link[aria-current=page]::after,.nav-disclosure[data-current]>summary::after{content:'';position:absolute;left:0;right:0;bottom:-24px;height:2px;background:var(--primary)}
.nav-disclosure[data-current]>summary::after{right:24px}
.nav-disclosure{position:relative}
.nav-panel{position:absolute;top:calc(100% + 24px);left:-21px;width:240px;background:var(--web-tile);border:1px solid var(--web-outline);padding:8px;animation:nav-in 180ms var(--ease-reveal)}
/* Hover bridge: the 24 px between the item and its panel belongs to the panel. */
.nav-panel::before{content:'';position:absolute;left:-1px;right:-1px;bottom:100%;height:25px}
@supports selector(details::details-content){
  .nav-disclosure::details-content{opacity:0;transform:translateY(4px);transition:opacity 160ms var(--ease-reveal),transform 160ms var(--ease-reveal),content-visibility 160ms allow-discrete}
  .nav-disclosure[open]::details-content{opacity:1;transform:none;transition-duration:180ms}
  [data-nav-switching] .nav-disclosure::details-content{transition:none}
  .nav-panel{animation:none}
}
[data-nav-switching] .nav-panel{animation:none}[data-nav-switching] summary :global(.web-icon){transition:none}
ul{list-style:none;padding:0;margin:0}.nav-panel a{position:relative;min-height:48px;display:flex;align-items:center;gap:12px;padding:12px;text-decoration:none;font:400 16px/24px var(--font-heading);transition:background-color 180ms ease-out}.nav-panel a>span{flex:1}
.nav-panel a :global(.nav-external),.nav-panel a :global(.nav-external svg){width:16px;height:16px;color:var(--muted-foreground)}
.nav-panel a:hover{background:var(--web-raised)}.nav-panel a:focus-visible{outline-offset:-2px;background:var(--web-raised)}
.nav-panel a[aria-current=page]{background:var(--web-quiet)}.nav-panel a[aria-current=page]::before{content:'';position:absolute;left:0;top:12px;bottom:12px;width:2px;background:var(--primary)}
@media(prefers-reduced-motion:reduce){summary :global(.web-icon),.nav-panel a{transition:none}}
.header-actions{display:flex;gap:16px;align-items:center}.mobile-open{display:none}
.mobile-navigation{position:fixed;inset:0;margin:0;width:100%;max-width:none;height:100svh;max-height:none;padding:24px;background:var(--background);color:var(--foreground);border:0;overflow-y:auto}
.mobile-navigation::backdrop{background:var(--background)}.mobile-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:40px}
.mobile-top button,.mobile-open{width:44px;height:44px;align-items:center;justify-content:center;background:transparent;border:1px solid var(--web-outline);color:var(--foreground)}
.mobile-navigation nav{display:grid;grid-template-columns:1fr 1fr;gap:32px 16px}.mobile-group h3{font-size:14px;line-height:20px;color:var(--muted-foreground);margin-bottom:12px}
.mobile-group a{display:flex;gap:8px;align-items:center;min-height:44px;padding-block:10px;text-decoration:none}
.fallback-nav{display:none}.fallback-nav a{padding:8px}
@keyframes nav-in{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
@media(max-width:1100px){.desktop-nav{gap:24px}.header-inner{gap:24px}}
@media(max-width:1023px){.desktop-nav{display:none}.mobile-open{display:flex}.header-actions :global(.button){display:none}.fallback-nav{display:flex;flex-wrap:wrap;background:var(--web-band)}.site-header:has(.fallback-nav){height:auto;min-height:96px}.site-header:has(.fallback-nav) .header-inner{height:96px}}
</style>
