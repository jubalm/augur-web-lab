{
  "name": "augur-web-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14 <2",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun --bun astro dev --host 127.0.0.1",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview --host 127.0.0.1",
    "check": "bun run design-system:check && bun --bun astro check",
    "design-system:generate": "bun scripts/design-system.ts",
    "design-system:check": "bun scripts/design-system.ts --check"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "astro": "7.3.2",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.3.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "6.0.3"
  }
}
